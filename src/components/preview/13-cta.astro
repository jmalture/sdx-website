---
/**
 * Section "cta": Sehen Sie den Preview in Ihrer eigenen Umgebung.
 * Texts: src/i18n/preview.json, keys starting with "cta_".
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/preview.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<style is:global>
  .spv-cta {
    padding: 128px 32px 136px;
    background: #2a73ff;
    color: #fff;
    text-align: center;
  }
  .spv-cta .spv-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 45% at 50% 100%, rgba(255, 255, 255, 0.22), transparent 70%),
      radial-gradient(35% 45% at 0% 0%, rgba(0, 191, 255, 0.35), transparent 70%),
      radial-gradient(35% 45% at 100% 10%, rgba(200, 0, 255, 0.22), transparent 70%);
  }
  .spv-cta .sxf-head {
    max-width: 760px;
  }
  .spv-cta .sxf-eyebrow {
    color: rgba(255, 255, 255, 0.88);
  }
  .spv-cta .sxf-h {
    color: #fff;
  }
  .spv-cta .sxf-lead {
    color: rgba(255, 255, 255, 0.92);
    margin-left: auto;
    margin-right: auto;
  }
  .spv-cta .spv-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 38px;
  }
  .spv-cta a.sxf-btn-w,
  .spv-cta a.sxf-btn-w:visited {
    background: #fff;
    color: #1f55c4;
  }
  .spv-cta a.sxf-btn-w:hover,
  .spv-cta a.sxf-btn-w:focus-visible {
    background: #fff;
    color: #1f55c4;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(10, 30, 90, 0.35);
  }
  .spv-cta a.sxf-btn-g,
  .spv-cta a.sxf-btn-g:visited {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.65);
  }
  .spv-cta a.sxf-btn-g:hover,
  .spv-cta a.sxf-btn-g:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: #fff;
    transform: translateY(-2px);
  }
  .spv-cta a:focus-visible {
    outline-color: #fff;
  }
  .spv-cta .f1 {
    left: 7%;
    top: 20%;
    --s: 64px;
    --c: #ffbb00;
    --r: -12deg;
    --d: 6.6s;
  }
  .spv-cta .f2 {
    right: 8%;
    top: 16%;
    --s: 50px;
    --c: #00bfff;
    --r: 12deg;
    --d: 5.8s;
  }
  @media (max-width: 1240px) {
    .spv-cta .f1 {
      left: 3%;
    }
    .spv-cta .f2 {
      right: 3%;
    }
  }
  @media (max-width: 1024px) {
    .spv-cta {
      padding: 104px 24px 112px;
    }
    .spv-cta .f1 {
      top: 4%;
      --s: 46px;
    }
    .spv-cta .f2 {
      top: 5%;
      --s: 38px;
    }
  }
  @media (max-width: 767px) {
    .spv-cta {
      padding: 92px 18px;
    }
    .spv-cta .f1 {
      top: 18px;
      --s: 36px;
    }
    .spv-cta .f2 {
      top: 22px;
      --s: 30px;
    }
    .spv-cta .spv-ctas a.sxf-btn {
      flex: 1 1 220px;
    }
  }
</style>
<section class="sxf spv-cta" id="demo" aria-labelledby="spv-h-cta">
  <div class="spv-glow" aria-hidden="true"></div>
  <div class="sxf-float" aria-hidden="true">
    <span class="sxf-fold f1"></span><span class="sxf-fold f2"></span>
  </div>
  <div class="sxf-wrap">
    <div class="sxf-head" data-rv>
      <p class="sxf-eyebrow">{t.cta_eyebrow}</p>
      <h2 class="sxf-h" id="spv-h-cta">{t.cta_title}</h2>
      <p class="sxf-lead">{t.cta_lead}</p>
      <div class="spv-ctas">
        <a class="sxf-btn sxf-btn-w" href={t.cta_link_kontakt}
          >{t.cta_request_a_demo}
          <svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a
        ><a class="sxf-btn sxf-btn-g" href={t.cta_link_home}>{t.cta_back_to_home}</a>
      </div>
    </div>
  </div>
</section>
