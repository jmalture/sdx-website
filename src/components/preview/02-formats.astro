---
/**
 * Section "formats": Format wählen, Vorschau sehen (interactive format picker, master/detail).
 * Texts: src/i18n/preview.json, keys starting with "formats_" (and "mock_" for the sample contents).
 * JSON, XLSX, PDF, PPTX, TXT and MP4 are the formats of the feature document. URL and DOCX are not listed.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/preview.json';
import { ft, pv, fileName, COLORS, type Kind } from './mock';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const order: Kind[] = ['json', 'xlsx', 'pdf', 'pptx', 'txt', 'mp4'];
---

<style is:global>
  .spv-formats .spv-fm-grid {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .spv-formats .spv-fm-list {
    display: grid;
    gap: 8px;
  }
  .sxf .spv-fm {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 14px 16px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e3eaf5;
    color: #0f1b2d;
    font-family: Inter, sans-serif;
    text-align: left;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .spv-fm .tx {
    display: block;
    min-width: 0;
  }
  .spv-fm .nm {
    display: block;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 700;
  }
  .spv-fm .ds {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.4;
    color: #5b6475;
  }
  .sxf .spv-fm[aria-pressed='true'] {
    background: #fff;
    border-color: var(--c);
    box-shadow: 0 18px 36px -22px var(--c);
  }
  @media (hover: hover) and (pointer: fine) {
    .sxf .spv-fm:hover:not([aria-pressed='true']) {
      border-color: #c9d9f5;
      background: #f9fbff;
    }
  }
  .spv-formats .spv-more {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1.5px dashed #b9cdf2;
    background: #f6f9ff;
  }
  .spv-formats .spv-more b {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 24px;
    border-radius: 7px;
    background: #2a73ff;
    color: #fff;
    flex: none;
  }
  .spv-formats .spv-more b svg {
    width: 14px;
    height: 14px;
  }
  .spv-formats .spv-more strong {
    display: block;
    font-size: 15px;
    line-height: 1.3;
  }
  .spv-formats .spv-more span {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.45;
    color: #5b6475;
  }
  .spv-formats .spv-fmw .spv-body {
    padding: 18px;
  }
  .spv-formats .spv-fmw .spv-stage {
    aspect-ratio: 16 / 10;
  }
  .spv-formats .spv-caps {
    display: grid;
    margin-top: 16px;
  }
  .spv-formats .spv-cap {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .spv-formats .spv-cap.is-on {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .spv-formats .spv-cap strong {
    display: block;
    font-size: 17px;
    line-height: 1.35;
    color: #0f1b2d;
  }
  .spv-formats .spv-cap span {
    display: block;
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: #4a5568;
  }
  .spv-formats .spv-hint {
    margin: 18px 0 0;
    text-align: center;
    font-size: 13px;
    line-height: 1.5;
    color: #5b6475;
  }
  @media (prefers-reduced-motion: reduce) {
    .sxf .spv-fm,
    .spv-formats .spv-cap {
      transition: none;
    }
  }
  @media (max-width: 1024px) {
    .spv-formats .spv-fm-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .spv-formats .spv-fm-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .sxf .spv-fm {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 12px 14px;
    }
    .spv-fm .ds {
      display: none;
    }
    .spv-formats .spv-more {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
  @media (max-width: 767px) {
    .spv-formats .spv-fm-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .spv-formats .spv-fmw .spv-body {
      padding: 12px;
    }
    .spv-formats .spv-fmw .spv-stage {
      aspect-ratio: 4 / 3;
    }
  }
</style>
<section class="sxf spv-sec spv-formats" id="formate" aria-labelledby="spv-h-formats">
  <div class="sxf-wrap">
    <div class="sxf-head" data-rv>
      <p class="sxf-eyebrow">{t.formats_eyebrow}</p>
      <h2 class="sxf-h" id="spv-h-formats">{t.formats_title_1} <span class="sxf-blue">{t.formats_title_2}</span></h2>
      <p class="sxf-lead">{t.formats_lead}</p>
    </div>
    <div class="spv-fm-grid" data-rv style="--dl:.08s">
      <div class="spv-fm-list" role="group" aria-label={t.formats_list_label}>
        {
          order.map((k, i) => (
            <button
              type="button"
              class="sxf-b spv-fm"
              style={`--c:${COLORS[k]}`}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-fn={fileName(k, t)}
            >
              <Fragment set:html={ft(k)} />
              <span class="tx">
                <span class="nm">{t[`formats_${k}_t`]}</span>
                <span class="ds">{t[`formats_${k}_d`]}</span>
              </span>
            </button>
          ))
        }
        <div class="spv-more">
          <b aria-hidden="true"><svg class="i" viewbox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg></b>
          <div>
            <strong>{t.formats_more_t}</strong>
            <span>{t.formats_more_d}</span>
          </div>
        </div>
      </div>
      <div class="spv-win spv-fmw" role="group" aria-label={t.formats_view_label}>
        <div class="spv-bar">
          <i></i><i></i><i></i><span class="pth spv-fn">{fileName(order[0], t)}</span><span class="spv-ex"
            >{t.mock_label}</span
          >
        </div>
        <div class="spv-body">
          <div class="spv-stage spv-zs">
            <div class="spv-zm">{order.map((k, i) => <Fragment set:html={pv(k, t, i === 0)} />)}</div>
          </div>
          <div class="spv-caps" aria-live="polite">
            {
              order.map((k, i) => (
                <div class={`spv-cap${i === 0 ? ' is-on' : ''}`}>
                  <strong>{t[`formats_${k}_h`]}</strong>
                  <span>{t[`formats_${k}_p`]}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
    <p class="spv-hint" data-rv>{t.formats_hint}</p>
  </div>
  <script is:inline>
    (function () {
      function init(s) {
        if (s.__spv) return;
        s.__spv = 1;
        var bt = [].slice.call(s.querySelectorAll('.spv-fm')),
          pvs = [].slice.call(s.querySelectorAll('.spv-pv')),
          caps = [].slice.call(s.querySelectorAll('.spv-cap')),
          fn = s.querySelector('.spv-fn');
        function pick(i, focus) {
          bt.forEach(function (b, k) {
            b.setAttribute('aria-pressed', k === i ? 'true' : 'false');
          });
          pvs.forEach(function (p, k) {
            p.classList.toggle('is-on', k === i);
          });
          caps.forEach(function (c, k) {
            c.classList.toggle('is-on', k === i);
          });
          fn.textContent = bt[i].getAttribute('data-fn');
          if (focus) bt[i].focus();
        }
        bt.forEach(function (b, i) {
          b.addEventListener('click', function () {
            pick(i);
          });
          b.addEventListener('keydown', function (e) {
            var k = e.key,
              n = bt.length;
            if (k === 'ArrowDown' || k === 'ArrowRight') {
              e.preventDefault();
              pick((i + 1) % n, true);
            } else if (k === 'ArrowUp' || k === 'ArrowLeft') {
              e.preventDefault();
              pick((i + n - 1) % n, true);
            }
          });
        });
        var zs = s.querySelector('.spv-zs');
        function zoom() {
          zs.style.setProperty('--z', Math.max(1, Math.min(1.8, zs.clientWidth / 520)).toFixed(3));
        }
        if ('ResizeObserver' in window) new ResizeObserver(zoom).observe(zs);
        zoom();
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            function (es) {
              s.classList.toggle('spv-run', es[0].isIntersecting && !document.hidden);
            },
            { threshold: 0.3 },
          ).observe(s);
        }
      }
      function go() {
        document.querySelectorAll('.spv-formats').forEach(init);
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
      else go();
    })();
  </script>
</section>
