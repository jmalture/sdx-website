---
/**
 * Section "widget": Erweiterbar mit Custom-Preview-Widgets (standard preview vs. custom widget with an EDIT button).
 * Texts: src/i18n/preview.json, keys starting with "widget_" (and "mock_" for the sample contents).
 * Editing with OnlyOffice, conversion and an Office integration are extension examples (custom functions, depends on the
 * project), not a standard function. The editor is a click-to-simulate mock-up, labelled as an example.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/preview.json';
import { ft, pv, fileName } from './mock';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const items = [1, 2, 3, 4];
const dec = (x: string) => x.replace('.', t.mock_dec);
const rows: (string | null)[][] = [
  ['mock_x_r1', '12.4', '14.1', '+1.7'],
  ['mock_x_r2', '8.0', '7.6', '-0.4'],
  ['mock_x_r3', '5.3', null, '+1.6'],
];
const icons = [
  'M4 4h16v16H4zM4 9h16M9 9v11',
  'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z',
  'M4 7h12l-3-3M20 17H8l3 3',
  'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6',
];
---

<style is:global>
  .spv-widget .sxf-wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr);
    gap: 64px;
    align-items: center;
  }
  .spv-widget .spv-copy .sxf-h {
    font-size: clamp(30px, 3.4vw, 42px);
  }
  .spv-widget .spv-ext {
    list-style: none;
    display: grid;
    gap: 16px;
    margin: 30px 0 0;
    padding: 0;
  }
  .spv-widget .spv-ext li {
    display: flex;
    gap: 14px;
    margin: 0;
  }
  .spv-widget .spv-ext li > b {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #eaf2ff;
    color: #2a73ff;
    flex: none;
  }
  .spv-widget .spv-ext li > b svg {
    width: 20px;
    height: 20px;
  }
  .spv-widget .spv-ext strong {
    display: block;
    font-size: 16px;
    line-height: 1.35;
    color: #0f1b2d;
  }
  .spv-widget .spv-ext span {
    display: block;
    margin-top: 2px;
    font-size: 14.5px;
    line-height: 1.5;
    color: #4a5568;
  }
  .spv-widget .spv-tag {
    display: inline-flex;
    margin-top: 26px;
    padding: 5px 12px;
    border-radius: 999px;
    background: #fff4dc;
    color: #8a5a00;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
  }
  .spv-widget .spv-seg-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid #e6ecf5;
  }
  .spv-widget .spv-seg-row .fn {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    font-size: 14px;
    font-weight: 700;
  }
  .spv-widget .spv-seg-row .fn b {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .spv-widget .spv-seg {
    display: inline-flex;
    padding: 3px;
    border-radius: 12px;
    background: #eef3fb;
    flex: none;
  }
  .sxf.spv-widget .spv-seg-b {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 6px 12px;
    border-radius: 9px;
    color: #5b6475;
    font-family: Inter, sans-serif;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .sxf.spv-widget .spv-seg-b[aria-pressed='true'] {
    background: #fff;
    color: #1f55c4;
    box-shadow: 0 2px 8px rgba(18, 37, 92, 0.14);
  }
  .spv-widget .spv-tbar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 16px;
    background: #fafcff;
    border-bottom: 1px solid #e6ecf5;
    font-size: 13px;
    color: #5b6475;
  }
  .spv-widget .spv-tbar .st,
  .spv-widget .spv-tbar .cw {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .spv-widget .spv-tbar .st,
  .spv-widget .spv-tbar .cw {
    position: absolute;
  }
  .spv-widget .spv-tbar {
    position: relative;
  }
  .spv-widget .spv-tbar .st {
    left: 16px;
    right: 16px;
  }
  .spv-widget .spv-tbar .cw {
    left: 16px;
    right: 16px;
    justify-content: space-between;
  }
  .spv-widget.is-std .spv-tbar .st,
  .spv-widget.is-cus .spv-tbar .cw {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .sxf .spv-edit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 6px 16px;
    border-radius: 10px;
    background: #f59000;
    color: #fff;
    font-family: Inter, sans-serif;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.06em;
    flex: none;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .spv-edit svg {
    width: 15px;
    height: 15px;
  }
  @media (hover: hover) and (pointer: fine) {
    .sxf .spv-edit:hover {
      background: #dc7f00;
      box-shadow: 0 8px 18px rgba(245, 144, 0, 0.35);
    }
  }
  .spv-widget .spv-tbar .cw .wn {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    color: #8a5a00;
  }
  .spv-widget .spv-tbar .ok {
    position: absolute;
    right: 120px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #e6f6ec;
    color: #13803f;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
  }
  .spv-widget .spv-tbar .ok svg {
    width: 13px;
    height: 13px;
    stroke-width: 3;
  }
  .spv-widget.is-saved .spv-tbar .ok {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .spv-widget .spv-wbody {
    padding: 16px;
  }
  .spv-widget .spv-wbody .spv-stage {
    aspect-ratio: 16 / 10;
  }
  /* simulated editor */
  .spv-widget .spv-ed {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    background: #fff;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.97);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.45s;
  }
  .spv-widget .spv-ed.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .spv-widget .spv-ed-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #2b3a4f;
    color: #fff;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 600;
  }
  .spv-widget .spv-ed-top b {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sxf .spv-save {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    margin-left: auto;
    padding: 4px 12px;
    border-radius: 8px;
    background: #2a73ff;
    color: #fff;
    font-family: Inter, sans-serif;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;
    white-space: nowrap;
    flex: none;
  }
  .spv-widget .spv-ed-rib {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    background: #f3f6fb;
    border-bottom: 1px solid #e6ecf5;
  }
  .spv-widget .spv-ed-rib i {
    display: block;
    width: 34px;
    height: 12px;
    border-radius: 4px;
    background: #d3dbe8;
  }
  .spv-widget .spv-ed-rib i:nth-child(3n) {
    width: 52px;
  }
  .spv-widget .spv-ed-gr {
    display: grid;
    grid-template-columns: 22px 1.5fr 1fr 1fr 1fr;
    align-content: start;
    margin: 12px;
    border: 1px solid #e9eef6;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 500;
    color: #0f1b2d;
  }
  .spv-widget .spv-ed-gr > * {
    padding: 5px 7px;
    border-right: 1px solid #e9eef6;
    border-bottom: 1px solid #e9eef6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .spv-widget .spv-ed-gr .co,
  .spv-widget .spv-ed-gr .rn {
    background: #f3f6fb;
    color: #8a94a6;
    text-align: center;
    padding-left: 2px;
    padding-right: 2px;
  }
  .spv-widget .spv-ed-gr .nu {
    text-align: right;
  }
  .spv-widget .spv-ed-gr .ce {
    text-align: right;
    outline: 2px solid #2a73ff;
    outline-offset: -2px;
    font-weight: 700;
  }
  .spv-widget .spv-ed-gr .ce::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 12px;
    margin-left: 1px;
    vertical-align: -2px;
    background: #2a73ff;
    animation: spvCaret 1s steps(1) infinite;
  }
  @keyframes spvCaret {
    50% {
      opacity: 0;
    }
  }
  .spv-widget .spv-ed-st {
    position: absolute;
    left: 12px;
    bottom: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #fff4dc;
    color: #8a5a00;
    font-size: 11px;
    line-height: 1.5;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .sxf.spv-widget .spv-seg-b,
    .spv-widget .spv-tbar .st,
    .spv-widget .spv-tbar .cw,
    .spv-widget .spv-tbar .ok,
    .spv-widget .spv-ed {
      transition: none;
    }
    .spv-widget .spv-ed {
      transform: none;
    }
    .spv-widget .spv-ed-gr .ce::after {
      animation: none;
    }
  }
  @media (max-width: 1180px) {
    .spv-widget .sxf-wrap {
      gap: 40px;
    }
  }
  @media (max-width: 1024px) {
    .spv-widget .sxf-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .spv-widget .spv-copy {
      max-width: 640px;
    }
  }
  @media (max-width: 560px) {
    .spv-widget .spv-ed-st {
      display: none;
    }
    .spv-widget .spv-wbody .spv-stage {
      aspect-ratio: 1 / 1;
    }
  }
  @media (max-width: 767px) {
    .spv-widget .spv-wbody {
      padding: 12px;
    }
    .spv-widget .spv-wbody .spv-stage {
      aspect-ratio: 4 / 3;
    }
    .spv-widget .spv-seg-row {
      flex-wrap: wrap;
      padding: 12px;
    }
    .spv-widget .spv-tbar {
      padding: 0 12px;
    }
    .spv-widget .spv-tbar .st,
    .spv-widget .spv-tbar .cw {
      left: 12px;
      right: 12px;
    }
    .spv-widget .spv-tbar .ok {
      display: none;
    }
    .spv-widget .spv-tbar .cw .wn {
      font-size: 12px;
    }
  }
</style>
<section class="sxf spv-sec spv-widget is-std" id="widgets" aria-labelledby="spv-h-widget">
  <div class="sxf-wrap">
    <div class="spv-copy" data-rv>
      <p class="sxf-eyebrow">{t.widget_eyebrow}</p>
      <h2 class="sxf-h" id="spv-h-widget">{t.widget_title_1} <span class="sxf-blue">{t.widget_title_2}</span></h2>
      <p class="sxf-lead">{t.widget_lead}</p>
      <ul class="spv-ext">
        {
          items.map((n) => (
            <li>
              <b aria-hidden="true">
                <svg class="i" viewbox="0 0 24 24">
                  <path d={icons[n - 1]} />
                </svg>
              </b>
              <div>
                <strong>{t[`widget_i${n}_t`]}</strong>
                <span>{t[`widget_i${n}_p`]}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <span class="spv-tag">{t.widget_tag}</span>
    </div>
    <div data-rv style="--dl:.12s">
      <div class="spv-win" role="group" aria-label={t.widget_app_label} data-val={t.widget_value}>
        <div class="spv-bar"><i></i><i></i><i></i><span class="spv-ex">{t.mock_label}</span></div>
        <div class="spv-seg-row">
          <span class="fn">
            <Fragment set:html={ft('xlsx')} />
            <b>{fileName('xlsx', t)}</b>
          </span>
          <div class="spv-seg" role="group" aria-label={t.widget_mode_label}>
            <button type="button" class="sxf-b spv-seg-b" data-m="std" aria-pressed="true">{t.widget_mode_std}</button>
            <button type="button" class="sxf-b spv-seg-b" data-m="cus" aria-pressed="false">{t.widget_mode_cus}</button>
          </div>
        </div>
        <div class="spv-tbar">
          <div class="st">{t.widget_std_hint}</div>
          <div class="cw">
            <span class="wn">{t.widget_cus_hint}</span>
            <button type="button" class="sxf-b spv-edit" tabindex="-1">
              <svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg
              >EDIT
            </button>
          </div>
          <span class="ok" aria-live="polite">
            <svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>{t.widget_saved}
          </span>
        </div>
        <div class="spv-wbody">
          <div class="spv-stage">
            <Fragment set:html={pv('xlsx', t, true)} />
            <div class="spv-ed" role="dialog" aria-label={t.widget_editor_label} aria-hidden="true">
              <div class="spv-ed-top">
                <b>{t.widget_editor_title}</b>
                <button type="button" class="sxf-b spv-save" tabindex="-1">{t.widget_save}</button>
              </div>
              <div class="spv-ed-rib" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <div class="spv-ed-gr" aria-hidden="true">
                <span class="co"></span><span class="co">A</span><span class="co">B</span><span class="co">C</span><span
                  class="co">D</span
                >
                <span class="rn">1</span><b>{t.mock_x_h1}</b><b class="nu">Q3</b><b class="nu">Q4</b><b class="nu"
                  >{t.mock_x_h4}</b
                >
                {
                  rows.map((r, i) => (
                    <>
                      <span class="rn">{i + 2}</span>
                      <span>{t[r[0]]}</span>
                      {r
                        .slice(1)
                        .map((c) =>
                          c === null ? <span class="ce">{dec('6.9')}</span> : <span class="nu">{dec(c)}</span>,
                        )}
                    </>
                  ))
                }
              </div>
              <span class="spv-ed-st">{t.widget_editor_note}</span>
            </div>
          </div>
        </div>
      </div>
      <p class="spv-note">{t.widget_note}</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      function init(s) {
        if (s.__spv) return;
        s.__spv = 1;
        var win = s.querySelector('.spv-win'),
          val = win.getAttribute('data-val'),
          segs = [].slice.call(s.querySelectorAll('.spv-seg-b')),
          edit = s.querySelector('.spv-edit'),
          ed = s.querySelector('.spv-ed'),
          save = s.querySelector('.spv-save'),
          ce = s.querySelector('.spv-ed-gr .ce'),
          cell = s.querySelector('.spv-pv-xlsx .sel'),
          timer = null,
          rm = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
        function mode(m) {
          var c = m === 'cus';
          segs.forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-m') === m ? 'true' : 'false');
          });
          s.classList.toggle('is-cus', c);
          s.classList.toggle('is-std', !c);
          s.classList.remove('is-saved');
          edit.tabIndex = c ? 0 : -1;
        }
        function openEd() {
          clearTimeout(timer);
          ed.classList.add('is-open');
          ed.setAttribute('aria-hidden', 'false');
          save.tabIndex = 0;
          s.classList.remove('is-saved');
          ce.textContent = '';
          var i = 0;
          function type() {
            if (i < val.length) {
              ce.textContent = val.slice(0, ++i);
              timer = setTimeout(type, 170);
            }
          }
          if (rm) ce.textContent = val;
          else timer = setTimeout(type, 450);
          setTimeout(function () {
            save.focus();
          }, 40);
        }
        function closeEd(saved) {
          clearTimeout(timer);
          ed.classList.remove('is-open');
          ed.setAttribute('aria-hidden', 'true');
          save.tabIndex = -1;
          if (saved) {
            cell.textContent = val;
            s.classList.add('is-saved');
          }
          edit.focus();
        }
        segs.forEach(function (b) {
          b.addEventListener('click', function () {
            if (ed.classList.contains('is-open')) closeEd(false);
            mode(b.getAttribute('data-m'));
          });
        });
        edit.addEventListener('click', openEd);
        save.addEventListener('click', function () {
          closeEd(true);
        });
        win.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && ed.classList.contains('is-open')) {
            e.preventDefault();
            closeEd(false);
          }
        });
      }
      function go() {
        document.querySelectorAll('.spv-widget').forEach(init);
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
      else go();
    })();
  </script>
</section>
