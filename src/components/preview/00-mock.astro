---
/**
 * Shared look of the Preview page mock-ups: app window, file rows, file type badges, the stacked mini previews
 * (PDF, XLSX, PPTX, JSON, TXT, MP4, DWG; markup from mock.ts), chips and section paddings.
 * Page-specific rules live in the numbered sections (prefix "spv-").
 */
---

<style is:global>
  .sxf li {
    min-width: 0;
  }

  /* ---------- section frame ---------- */
  .sxf.spv-sec {
    padding: 128px 32px;
    background: #fff;
  }
  .sxf.spv-alt {
    background: linear-gradient(180deg, #f3f7ff 0%, #ffffff 100%);
  }
  .sxf.spv-alt2 {
    background: linear-gradient(180deg, #ffffff 0%, #f3f7ff 100%);
  }
  .spv-sec .sxf-head {
    margin-bottom: 56px;
  }
  .sxf .sxf-h {
    text-wrap: balance;
  }
  .spv-sec .spv-note {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: #5b6475;
  }

  /* ---------- app window ---------- */
  .spv-win {
    position: relative;
    border-radius: 20px;
    background: #fff;
    box-shadow:
      0 44px 90px -24px rgba(18, 37, 92, 0.34),
      0 0 0 1px rgba(18, 37, 92, 0.06);
    overflow: hidden;
  }
  .spv-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 11px 16px;
    background: #f3f6fb;
    border-bottom: 1px solid #e6ecf5;
  }
  .spv-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d3dbe8;
    flex: none;
  }
  .spv-bar .pth {
    margin-left: 10px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    font-weight: 600;
    color: #5b6475;
  }
  .spv-ex {
    margin-left: auto;
    padding: 3px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #dbe4f2;
    font-size: 11px;
    line-height: 1.4;
    font-weight: 600;
    color: #5b6475;
    white-space: nowrap;
    flex: none;
  }

  /* ---------- file type badge ---------- */
  .spv-ft {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 24px;
    padding: 0 6px;
    border-radius: 7px;
    background: var(--c);
    color: #fff;
    font-size: 11px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex: none;
  }

  /* ---------- file rows (buttons) ---------- */
  .sxf .spv-fr {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 9px 12px;
    border-radius: 12px;
    border: 1px solid transparent;
    color: #0f1b2d;
    font-family: Inter, sans-serif;
    text-align: left;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .spv-fr .nm {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 600;
  }
  .spv-fr .mt {
    display: block;
    font-size: 12px;
    line-height: 1.35;
    color: #5b6475;
  }
  .spv-fr .tx {
    display: block;
    min-width: 0;
    flex: 1 1 auto;
  }
  .sxf .spv-fr.is-sel {
    background: #eaf2ff;
    border-color: #bcd3ff;
  }
  @media (hover: hover) and (pointer: fine) {
    .sxf .spv-fr:hover:not(.is-sel) {
      background: #f3f7ff;
    }
  }

  /* ---------- stage with stacked mini previews ---------- */
  .spv-stage {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: #eef3fb;
    border: 1px solid #e3eaf5;
  }
  .spv-pv {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.4s;
    font-family: Inter, sans-serif;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 500;
    color: #0f1b2d;
    text-align: left;
  }
  .spv-pv.is-on {
    opacity: 1;
    visibility: inherit;
    transform: none;
    transition-delay: 0s;
  }
  .spv-pv .pn {
    position: absolute;
    right: 10px;
    bottom: 8px;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(15, 27, 45, 0.74);
    color: #fff;
    font-size: 11px;
    line-height: 1.5;
    font-weight: 600;
  }
  .spv-pv-pdf,
  .spv-pv-pptx,
  .spv-pv-cad,
  .spv-pv-xlsx {
    padding-bottom: 36px;
  }
  /* pdf */
  .spv-pv-pdf .pg {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: min(88%, 300px);
    height: 100%;
    padding: 10px 12px;
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 8px 24px -10px rgba(18, 37, 92, 0.35),
      0 0 0 1px rgba(18, 37, 92, 0.06);
    overflow: hidden;
  }
  .spv-pv-pdf .hd {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }
  .spv-pv-pdf .hd .lg {
    color: #f04438;
  }
  .spv-pv-pdf dl {
    display: grid;
    gap: 4px;
    margin: 0;
  }
  .spv-pv-pdf dl div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .spv-pv-pdf dt {
    color: #8a94a6;
  }
  .spv-pv-pdf dd {
    display: inline-block;
    white-space: nowrap;
    margin: 0;
    padding: 0 3px;
    border-radius: 3px;
    background: rgba(255, 187, 0, 0.3);
    font-weight: 700;
  }
  .spv-pv-pdf .ls {
    display: grid;
    gap: 5px;
  }
  .spv-pv-pdf .ls i {
    display: block;
    height: 5px;
    border-radius: 3px;
    background: #e6ecf5;
  }
  .spv-pv .w90 {
    width: 90%;
  }
  .spv-pv .w80 {
    width: 80%;
  }
  .spv-pv .w60 {
    width: 60%;
  }
  .spv-pv .w70 {
    width: 70%;
  }
  .spv-pv-pdf .tot {
    display: flex;
    white-space: nowrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px solid #e6ecf5;
  }
  .spv-pv-pdf .tot b {
    padding: 0 3px;
    border-radius: 3px;
    background: rgba(255, 187, 0, 0.3);
  }
  /* xlsx */
  .spv-pv-xlsx .gr {
    display: grid;
    grid-template-columns: 22px 1.5fr 1fr 1fr 1fr;
    width: 100%;
    max-width: 440px;
    border-radius: 8px;
    background: #fff;
    box-shadow:
      0 8px 24px -10px rgba(18, 37, 92, 0.3),
      0 0 0 1px rgba(18, 37, 92, 0.08);
    overflow: hidden;
  }
  .spv-pv-xlsx .gr > * {
    padding: 5px 7px;
    border-right: 1px solid #e9eef6;
    border-bottom: 1px solid #e9eef6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .spv-pv-xlsx .gr .co,
  .spv-pv-xlsx .gr .rn {
    background: #f3f6fb;
    color: #8a94a6;
    text-align: center;
    padding-left: 2px;
    padding-right: 2px;
  }
  .spv-pv-xlsx .gr b {
    background: #e6f6ec;
    font-weight: 700;
  }
  .spv-pv-xlsx .gr .nu {
    text-align: right;
  }
  .spv-pv-xlsx .gr .sel {
    text-align: right;
    outline: 2px solid #1a9b4b;
    outline-offset: -2px;
    background: #f2fbf5;
    font-weight: 700;
  }
  .spv-pv-xlsx .tb {
    position: absolute;
    left: 12px;
    bottom: 8px;
    display: flex;
    gap: 4px;
  }
  .spv-pv-xlsx .tb span {
    padding: 2px 10px;
    border-radius: 6px 6px 0 0;
    background: #dfe7f3;
    color: #5b6475;
    font-weight: 600;
  }
  .spv-pv-xlsx .tb span.on {
    background: #fff;
    color: #1a9b4b;
  }
  /* pptx */
  .spv-pv-pptx .th {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 40px;
    flex: none;
  }
  .spv-pv-pptx .th i {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 3px;
    background: #fff;
    border: 1px solid #d3dbe8;
  }
  .spv-pv-pptx .th i.on {
    border: 2px solid #f59000;
  }
  .spv-pv-pptx .sl {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1 1 0;
    min-width: 0;
    max-height: 100%;
    aspect-ratio: 16 / 10;
    padding: 12px 14px;
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 8px 24px -10px rgba(18, 37, 92, 0.35),
      0 0 0 1px rgba(18, 37, 92, 0.06);
    overflow: hidden;
  }
  .spv-pv-pptx .sl b {
    font-size: 13px;
    line-height: 1.25;
    font-weight: 700;
  }
  .spv-pv-pptx .sl > span {
    color: #5b6475;
  }
  .spv-pv-pptx .ch {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 44%;
    margin-top: auto;
  }
  .spv-pv-pptx .ch i {
    display: block;
    width: 14%;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: #f59000;
  }
  .spv-pv-pptx .ch i:nth-child(odd) {
    background: #ffc15c;
  }
  /* json */
  .spv-pv-json {
    padding: 0;
  }
  .spv-pv-json .cd {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 14px 16px;
    border: 0;
    border-radius: 0;
    background: #0f1b2d;
    color: #cbd5e6;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 11.5px;
    line-height: 1.7;
    font-weight: 500;
    white-space: pre;
    overflow: hidden;
  }
  .spv-pv-json .cd code {
    font: inherit;
    background: none;
    color: inherit;
    padding: 0;
  }
  .spv-pv-json .k0 {
    color: #8a94a6;
  }
  .spv-pv-json .k {
    color: #7fd0ff;
  }
  .spv-pv-json .s {
    color: #a5e8b0;
  }
  .spv-pv-json .n {
    color: #ffbb66;
  }
  .spv-pv-json .b {
    color: #ff8fb0;
  }
  /* txt */
  .spv-pv-txt .tx {
    width: min(86%, 360px);
    height: 100%;
    padding: 12px 14px;
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 8px 24px -10px rgba(18, 37, 92, 0.3),
      0 0 0 1px rgba(18, 37, 92, 0.06);
    font-size: 12px;
    line-height: 1.5;
    overflow: hidden;
  }
  .spv-pv-txt .tx b {
    display: block;
    margin-bottom: 4px;
    font-size: 13px;
  }
  .spv-pv-txt .tx p {
    margin: 0;
    padding-left: 12px;
    position: relative;
    color: #3d4555;
  }
  .spv-pv-txt .tx p::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #8a94a6;
  }
  .spv-pv-txt .tx p.mu {
    color: #8a94a6;
  }
  /* mp4 */
  .spv-pv-mp4 {
    padding: 0;
  }
  .spv-pv-mp4 .vd {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 70% at 78% 18%, rgba(0, 191, 255, 0.55), transparent 70%),
      linear-gradient(135deg, #0d2347, #2a73ff 80%);
  }
  .spv-pv-mp4 .pl {
    position: absolute;
    left: 50%;
    top: 46%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.5);
  }
  .spv-pv-mp4 .pl svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
    fill: #2a73ff;
  }
  .spv-pv-mp4 .wv {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 50px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    height: 24px;
  }
  .spv-pv-mp4 .wv i {
    display: block;
    width: 5px;
    height: 100%;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.55);
    transform: scaleY(0.4);
    transform-origin: bottom;
  }
  .spv-pv-mp4 .wv i:nth-child(2) {
    transform: scaleY(0.8);
  }
  .spv-pv-mp4 .wv i:nth-child(4) {
    transform: scaleY(1);
  }
  .spv-pv-mp4 .wv i:nth-child(5) {
    transform: scaleY(0.6);
  }
  .spv-pv-mp4 .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    background: rgba(8, 16, 30, 0.72);
    color: #fff;
  }
  .spv-pv-mp4 .bar svg {
    width: 14px;
    height: 14px;
    fill: #fff;
    flex: none;
  }
  .spv-pv-mp4 .bar .tr {
    position: relative;
    flex: 1 1 auto;
    height: 4px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.28);
    overflow: hidden;
  }
  .spv-pv-mp4 .bar .tr i {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background: #fff;
    transform: scaleX(0.35);
    transform-origin: left;
  }
  .spv-pv-mp4 .bar em {
    font-style: normal;
    font-size: 11px;
    white-space: nowrap;
  }
  .spv-run .spv-pv-mp4.is-on .bar .tr i {
    animation: spvPlay 9s linear infinite;
  }
  .spv-run .spv-pv-mp4.is-on .wv i {
    animation: spvWave 1.1s ease-in-out infinite alternate;
  }
  .spv-run .spv-pv-mp4.is-on .wv i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .spv-run .spv-pv-mp4.is-on .wv i:nth-child(3) {
    animation-delay: -0.6s;
  }
  .spv-run .spv-pv-mp4.is-on .wv i:nth-child(4) {
    animation-delay: -0.15s;
  }
  .spv-run .spv-pv-mp4.is-on .wv i:nth-child(5) {
    animation-delay: -0.45s;
  }
  .spv-run .spv-pv-mp4.is-on .wv i:nth-child(6) {
    animation-delay: -0.75s;
  }
  @keyframes spvPlay {
    from {
      transform: scaleX(0.04);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes spvWave {
    from {
      transform: scaleY(0.25);
    }
    to {
      transform: scaleY(1);
    }
  }
  /* dwg (special view of a custom widget) */
  .spv-pv-cad .cv {
    width: min(92%, 320px);
    padding: 10px;
    border-radius: 8px;
    background-color: #eaf2ff;
    background-image:
      linear-gradient(rgba(42, 115, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(42, 115, 255, 0.12) 1px, transparent 1px);
    background-size: 14px 14px;
    box-shadow: 0 0 0 1px rgba(42, 115, 255, 0.25);
  }
  .spv-pv-cad svg {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: #2a73ff;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .spv-pv-cad svg .dr {
    stroke: #f04438;
    stroke-width: 3;
  }

  /* scaled stage: the previews are drawn at a fixed size and scaled up with --z (set by the section script) */
  .spv-zm {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(100% / var(--z, 1));
    height: calc(100% / var(--z, 1));
    transform: scale(var(--z, 1));
    transform-origin: 0 0;
  }

  /* ---------- chips and small controls ---------- */
  .sxf .spv-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid #d8e1ee;
    background: #fff;
    color: #3d4555;
    font-family: Inter, sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 600;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .sxf .spv-chip[aria-pressed='true'],
  .sxf .spv-chip[aria-selected='true'] {
    background: #2a73ff;
    border-color: #2a73ff;
    color: #fff;
  }
  @media (hover: hover) and (pointer: fine) {
    .sxf .spv-chip:hover:not([aria-pressed='true']):not([aria-selected='true']) {
      border-color: #2a73ff;
      color: #1f55c4;
    }
  }
  .spv-kbd {
    display: inline-block;
    min-width: 26px;
    padding: 2px 7px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid #d3dbe8;
    box-shadow: 0 2px 0 #d3dbe8;
    font-family: Inter, sans-serif;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 600;
    text-align: center;
    color: #3d4555;
  }

  @media (prefers-reduced-motion: reduce) {
    .spv-pv,
    .sxf .spv-fr,
    .sxf .spv-chip {
      transition: none;
    }
    .spv-pv {
      transform: none;
    }
    .spv-run .spv-pv-mp4.is-on .bar .tr i,
    .spv-run .spv-pv-mp4.is-on .wv i {
      animation: none;
    }
  }
  @media (max-width: 1024px) {
    .sxf.spv-sec {
      padding: 104px 24px;
    }
    .spv-sec .sxf-head {
      margin-bottom: 44px;
    }
  }
  @media (max-width: 767px) {
    .sxf.spv-sec {
      padding: 84px 18px;
    }
    .spv-sec .sxf-head {
      margin-bottom: 36px;
    }
  }
</style>
