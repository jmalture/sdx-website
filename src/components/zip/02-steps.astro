---
/**
 * Section "steps": In drei Schritten importiert.
 * Texts: src/i18n/zip.json, keys starting with "steps_". Also holds the section CSS shared by the
 * following sections (.szu-sec, .szu-ic, .szu-card).
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/zip.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const steps = [1, 2, 3].map((n) => ({
  n,
  title: t[`steps_${n}_title`],
  text: t[`steps_${n}_text`],
}));
---

<style is:global>
  .szu-sec {
    padding: 112px 32px;
    background: #fff;
  }
  .szu-sec.is-tint {
    background: linear-gradient(180deg, #f4f8ff 0%, #eaf2fe 100%);
  }
  .szu-sec .sxf-lead {
    margin-left: auto;
    margin-right: auto;
    max-width: 620px;
  }
  .szu-sec .sxf-head {
    margin-bottom: 56px;
  }
  .szu-sec .sxf-h {
    text-wrap: balance;
  }
  .szu-reveal {
    height: 100%;
  }
  .szu-reveal > .szu-card {
    height: 100%;
  }
  .szu-ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #eaf1ff;
    color: #2a73ff;
    flex: none;
  }
  .szu-ic svg {
    width: 24px;
    height: 24px;
  }
  .szu-card {
    border-radius: 24px;
    background: #fff;
    border: 1px solid #e3eaf5;
    padding: 30px 28px;
    transition:
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  .szu-card:hover {
    transform: translateY(-4px);
    border-color: #c9d9f5;
    box-shadow: 0 22px 44px -22px rgba(42, 115, 255, 0.32);
  }
  .szu-card h3 {
    margin: 18px 0 8px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: #0f1b2d;
  }
  .szu-card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #4a5568;
  }
  .szu-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  .szu-steps li {
    position: relative;
    margin: 0;
  }
  .szu-steps .szu-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #2a73ff;
    color: #fff;
    font-size: 19px;
    font-weight: 700;
  }
  .szu-steps .szu-card {
    height: 100%;
  }
  .szu-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 54px;
    right: -24px;
    width: 24px;
    height: 2px;
    background: repeating-linear-gradient(90deg, #9dbcf5 0 4px, transparent 4px 8px);
  }
  @media (max-width: 1024px) {
    .szu-sec {
      padding: 88px 24px;
    }
  }
  @media (max-width: 900px) {
    .szu-steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .szu-steps li:not(:last-child)::after {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .szu-sec {
      padding: 72px 18px;
    }
    .szu-sec .sxf-head {
      margin-bottom: 40px;
    }
  }
</style>
<section class="sxf szu-sec is-tint" id="so-gehts" aria-labelledby="szu-h-steps">
  <div class="sxf-wrap">
    <div class="sxf-head" data-rv>
      <p class="sxf-eyebrow">{t.steps_eyebrow}</p>
      <h2 class="sxf-h" id="szu-h-steps">{t.steps_title}</h2>
      <p class="sxf-lead">{t.steps_lead}</p>
    </div>
    <ol class="szu-steps">
      {
        steps.map((s) => (
          <li data-rv style={`--dl:${(s.n - 1) * 0.12}s`}>
            <div class="szu-card">
              <span class="szu-num" aria-hidden="true">
                {s.n}
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
