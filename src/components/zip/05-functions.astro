---
/**
 * Section "fn": Alles, was ein Import braucht. (function table of the feature document)
 * Texts: src/i18n/zip.json, keys starting with "fn_".
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/zip.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const icons = [
  'M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M10 12v1M10 15v1',
  'M2 12s3.500-7 10-7 10 7 10 7-3.500 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  'M4 6h16M4 12h10M4 18h6M17 15l2 2 3-4',
  'M3 6.500A2.500 2.500 0 0 1 5.500 4h4l2 2.200h7A2.500 2.500 0 0 1 21 8.700v8.800a2.500 2.500 0 0 1-2.500 2.500h-13A2.500 2.500 0 0 1 3 17.500z',
  'M4 12a8 8 0 0 1 14-5.300L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.300L4 15M4 20v-5h5',
  'M3 6.500A2.500 2.500 0 0 1 5.500 4h4l2 2.200h7A2.500 2.500 0 0 1 21 8.700v8.800a2.500 2.500 0 0 1-2.500 2.500h-13A2.500 2.500 0 0 1 3 17.500zM9 13h6',
  'M12 3l9 5v8l-9 5-9-5V8zM3 8l9 5 9-5M12 13v8',
  'M13 2L4 14h7l-1 8 9-12h-7z',
  'M5 12h14M13 6l6 6-6 6',
];
---

<style is:global>
  .szu-fn .szu-fgrid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  .szu-fn .szu-fgrid li {
    margin: 0;
  }
  .szu-fn .szu-card {
    height: 100%;
    padding: 26px 26px 28px;
  }
  .szu-fn .szu-card h3 {
    font-size: 18px;
  }
  .szu-fn .szu-card p {
    font-size: 15.5px;
  }
  @media (max-width: 1024px) {
    .szu-fn .szu-fgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .szu-fn .szu-fgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
<section class="sxf szu-sec szu-fn" id="funktionen" aria-labelledby="szu-h-fn">
  <div class="sxf-wrap">
    <div class="sxf-head" data-rv>
      <p class="sxf-eyebrow">{t.fn_eyebrow}</p>
      <h2 class="sxf-h" id="szu-h-fn">{t.fn_title}</h2>
      <p class="sxf-lead">{t.fn_lead}</p>
    </div>
    <ul class="szu-fgrid">
      {
        icons.map((d, i) => (
          <li data-rv style={`--dl:${(i % 3) * 0.1}s`}>
            <article class="szu-card">
              <span class="szu-ic" aria-hidden="true">
                <svg class="i" viewbox="0 0 24 24">
                  <path d={d} />
                </svg>
              </span>
              <h3>{t[`fn_${i + 1}_title`]}</h3>
              <p>{t[`fn_${i + 1}_text`]}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
