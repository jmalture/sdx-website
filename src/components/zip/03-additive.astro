---
/**
 * Section "add": Aktualisieren, ohne etwas zu verlieren. (additive upload)
 * Texts: src/i18n/zip.json, keys starting with "add_". The before/after panel is an illustrative example.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/zip.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const cards = [
  { n: 1, icon: 'M4 12a8 8 0 0 1 14-5.3L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.3L4 15M4 20v-5h5' },
  { n: 2, icon: 'M12 5v14M5 12h14' },
  { n: 3, icon: 'M5 12l5 5L20 7' },
];
const before = [
  { name: t.add_file_plan, tag: '' },
  { name: t.add_file_contract, tag: '' },
];
const zip = [
  { name: t.add_file_plan, tag: '' },
  { name: t.add_file_report, tag: '' },
];
const after = [
  { name: t.add_file_plan, tag: 'rep', label: t.add_tag_replaced },
  { name: t.add_file_contract, tag: 'kept', label: t.add_tag_kept },
  { name: t.add_file_report, tag: 'new', label: t.add_tag_new },
];
---

<style is:global>
  .szu-add .szu-add-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .szu-add .sxf-head {
    text-align: left;
    margin: 0 0 32px;
    max-width: 560px;
  }
  .szu-add .sxf-lead {
    margin-left: 0;
  }
  .szu-add .szu-rules {
    list-style: none;
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
  }
  .szu-add .szu-rules li {
    display: flex;
    gap: 16px;
    margin: 0;
  }
  .szu-add .szu-rules strong {
    display: block;
    font-size: 17px;
    line-height: 1.4;
    font-weight: 650;
    color: #0f1b2d;
  }
  .szu-add .szu-rules span.tx {
    display: block;
    margin-top: 2px;
    font-size: 15.5px;
    line-height: 1.55;
    color: #4a5568;
  }
  .szu-flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding: 26px;
    border-radius: 24px;
    background: linear-gradient(180deg, #f4f8ff, #eaf2fe);
    border: 1px solid #dbe7fb;
  }
  .szu-flow .szu-col h4 {
    margin: 0 0 12px;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5b6475;
  }
  .szu-flow ul {
    list-style: none;
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .szu-flow li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    padding: 10px 12px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 6px 16px -10px rgba(18, 37, 92, 0.25);
    font-size: 13.5px;
    line-height: 1.3;
    font-weight: 500;
    color: #0f1b2d;
    white-space: nowrap;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) var(--dl, 0s);
  }
  .szu-flow li .szu-tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 650;
    color: #fff;
  }
  .szu-flow li.rep {
    box-shadow: inset 0 0 0 2px #2a73ff;
  }
  .szu-flow li.rep .szu-tag {
    background: #2a73ff;
  }
  .szu-flow li.new {
    box-shadow: inset 0 0 0 2px #1a9b4b;
  }
  .szu-flow li.new .szu-tag {
    background: #1a9b4b;
  }
  .szu-flow li.kept .szu-tag {
    background: #5b6475;
  }
  .szu-flow .szu-exlabel {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: #2a73ff;
  }
  @media (max-width: 1024px) {
    .szu-add .szu-add-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 767px) {
    .szu-flow {
      padding: 18px;
      gap: 10px;
    }
    .szu-flow li {
      padding: 8px 9px;
      font-size: 12.5px;
    }
  }
  @media (max-width: 420px) {
    .szu-flow {
      padding: 14px 12px;
      gap: 8px;
    }
    .szu-flow li {
      padding: 8px 6px;
      font-size: 11.5px;
    }
    .szu-flow li .szu-tag {
      padding: 2px 6px;
      font-size: 11px;
    }
  }
</style>
<section class="sxf szu-sec szu-add" id="additiv" aria-labelledby="szu-h-add">
  <div class="sxf-wrap szu-add-grid">
    <div>
      <div class="sxf-head" data-rv>
        <p class="sxf-eyebrow">{t.add_eyebrow}</p>
        <h2 class="sxf-h" id="szu-h-add">{t.add_title}</h2>
        <p class="sxf-lead">{t.add_lead}</p>
      </div>
      <ul class="szu-rules">
        {
          cards.map((c) => (
            <li data-rv style={`--dl:${0.12 + c.n * 0.1}s`}>
              <span class="szu-ic" aria-hidden="true">
                <svg class="i" viewbox="0 0 24 24">
                  <path d={c.icon} />
                </svg>
              </span>
              <div>
                <strong>{t[`add_${c.n}_title`]}</strong>
                <span class="tx">{t[`add_${c.n}_text`]}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="szu-flow" role="img" aria-label={t.add_example_label}>
      <p class="szu-exlabel" data-rv style="--dl:.12s" aria-hidden="true">{t.add_example_label}</p>
      <div class="szu-col" data-rv style="--dl:.2s" aria-hidden="true">
        <h4>{t.add_before}</h4>
        <ul>
          {before.map((f) => <li>{f.name}</li>)}
        </ul>
      </div>
      <div class="szu-col" data-rv style="--dl:.32s" aria-hidden="true">
        <h4>{t.add_zip}</h4>
        <ul>
          {zip.map((f) => <li>{f.name}</li>)}
        </ul>
      </div>
      <div class="szu-col" data-rv style="--dl:.44s" aria-hidden="true">
        <h4>{t.add_after}</h4>
        <ul>
          {
            after.map((f) => (
              <li class={f.tag}>
                {f.name}
                <span class="szu-tag">{f.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
