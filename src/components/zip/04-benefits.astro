---
/**
 * Section "ben": Weniger Handarbeit. Mehr Überblick. (business value, wording from the feature document)
 * Texts: src/i18n/zip.json, keys starting with "ben_".
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/zip.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const icons = [
  'M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8',
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  'M12 3l8 3v6c0 4.500-3.200 8-8 9-4.800-1-8-4.500-8-9V6z',
  'M2 12s3.500-7 10-7 10 7 10 7-3.500 7-10 7S2 12 2 12zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  'M12 3l10 18H2zM12 10v5M12 18v.5',
  'M7 7h10v10H7zM3 10h4M3 14h4M17 10h4M17 14h4M10 3v4M14 3v4M10 17v4M14 17v4',
];
---

<style is:global>
  .szu-ben .szu-bgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 1024px) {
    .szu-ben .szu-bgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .szu-ben .szu-bgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
<section class="sxf szu-sec is-tint szu-ben" id="nutzen" aria-labelledby="szu-h-ben">
  <div class="sxf-wrap">
    <div class="sxf-head" data-rv>
      <p class="sxf-eyebrow">{t.ben_eyebrow}</p>
      <h2 class="sxf-h" id="szu-h-ben">{t.ben_title}</h2>
      <p class="sxf-lead">{t.ben_lead}</p>
    </div>
    <div class="szu-bgrid">
      {
        icons.map((d, i) => (
          <div class="szu-reveal" data-rv style={`--dl:${(i % 3) * 0.1}s`}>
            <article class="szu-card">
              <span class="szu-ic" aria-hidden="true">
                <svg class="i" viewbox="0 0 24 24">
                  <path d={d} />
                </svg>
              </span>
              <h3>{t[`ben_${i + 1}_title`]}</h3>
              <p>{t[`ben_${i + 1}_text`]}</p>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>
