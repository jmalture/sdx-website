---
/**
 * Section "faq": Fragen zum ZIP Upload? Beantwortet. (7 Q&As of the feature document, native details/summary)
 * Texts: src/i18n/zip.json, keys starting with "faq_".
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/zip.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
const ids = [1, 2, 3, 4, 5, 6, 7];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: ids.map((n) => ({
    '@type': 'Question',
    name: t[`faq_${n}_q`],
    acceptedAnswer: { '@type': 'Answer', text: t[`faq_${n}_a`] },
  })),
};
---

<style is:global>
  .szu-faq .sxf-wrap {
    max-width: 860px;
  }
  .szu-faq .szu-q {
    margin: 0 0 12px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid #e3eaf5;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .szu-faq .szu-q:hover,
  .szu-faq .szu-q[open] {
    border-color: #c9d9f5;
  }
  .szu-faq .szu-q[open] {
    box-shadow: 0 18px 36px -22px rgba(42, 115, 255, 0.3);
  }
  .szu-faq .szu-q summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
    line-height: 1.4;
    font-weight: 600;
    color: #0f1b2d;
  }
  .szu-faq .szu-q summary::-webkit-details-marker {
    display: none;
  }
  .szu-faq .szu-q summary svg {
    width: 20px;
    height: 20px;
    color: #2a73ff;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .szu-faq .szu-q[open] summary svg {
    transform: rotate(45deg);
  }
  .szu-faq .szu-q p {
    margin: 0;
    padding: 0 24px 22px;
    font-size: 16px;
    line-height: 1.65;
    color: #4a5568;
  }
</style>
<section class="sxf szu-sec szu-faq" id="faq" aria-labelledby="szu-h-faq">
  <div class="sxf-wrap">
    <div class="sxf-head" data-rv>
      <p class="sxf-eyebrow">{t.faq_eyebrow}</p>
      <h2 class="sxf-h" id="szu-h-faq">{t.faq_title}</h2>
    </div>
    <div>
      {
        ids.map((n) => (
          <div data-rv style={`--dl:${Math.min(n - 1, 4) * 0.07}s`}>
            <details class="szu-q">
              <summary>
                {t[`faq_${n}_q`]}
                <svg class="i" viewbox="0 0 24 24" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p>{t[`faq_${n}_a`]}</p>
            </details>
          </div>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
