      </div><script is:inline>
        (function () {
          var s = document.getElementById('sdx-why-stack');
          if (!s || !window.matchMedia('(min-width:1025px)').matches) return;
          s.classList.add('js');
          var cards = [].slice.call(s.querySelectorAll('.sdx-card'));
          var STEP = 180;
          function setHot(i) {
            cards.forEach(function (c, k) {
              c.classList.toggle('is-hot', k === i);
            });
            s.classList.toggle('has-hot', i >= 0);
            s.style.setProperty('--h', i >= 0 ? String(i - 2) : '0');
          }
          function zone(x) {
            var r = s.getBoundingClientRect();
            var o = Math.round((x - (r.left + r.width / 2)) / STEP);
            return Math.max(-2, Math.min(2, o)) + 2;
          }
          s.addEventListener('mousemove', function (e) {
            setHot(zone(e.clientX));
          });
          s.addEventListener('mouseleave', function () {
            setHot(-1);
          });
          s.addEventListener(
            'touchstart',
            function (e) {
              var t = e.touches[0];
              if (!s.classList.contains('is-open')) {
                s.classList.add('is-open');
                setHot(zone(t.clientX));
              } else {
                setHot(zone(t.clientX));
              }
            },
            { passive: true },
          );
          document.addEventListener(
            'touchstart',
            function (e) {
              if (!s.contains(e.target)) {
                s.classList.remove('is-open');
                setHot(-1);
              }
            },
            { passive: true },
          );
        })();
