---
/**
 * Section "dashboards": Dashboards, wie Sie sie brauchen.
 * Texts: src/i18n/home.json, keys starting with "dashboards_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-sdxt08 e-con-full e-flex e-con e-parent" data-id="sdxt08">
  <div class="elementor-element elementor-element-sdxt08w elementor-widget elementor-widget-html" data-id="sdxt08w">
    <section class="sdxt sdxt-widg" id="raum-widgets">
      <div class="sdxt-wrap sdxt-split">
        <div class="sdxt-text">
          <p class="sdxt-eyebrow">Widgets</p>
          <h2 class="sdxt-h">{t.dashboards_dashboards} <span class="sdxt-blue">{t.dashboards_built_your_way}</span></h2>
          <p class="sdxt-lead">{t.dashboards_in_the_layout_editor}</p>
          <div class="sdxt-steps">
            <ol>
              <li>{t.dashboards_assemble_dashboards_from_buildin}</li><li>{t.dashboards_create_variants_of_a}</li><li>
                {t.dashboards_preview_for_desktop_tablet}
              </li>
            </ol>
          </div>
        </div>
        <div class="sdxt-visual">
          <div class="sdxt-blocks" aria-hidden="true">
            <span class="b1" style="--d:6.2s;--p:.2"><i style="background:#2A73FF"></i><i class="w"></i></span>
            <span class="b2" style="--d:7.4s;--p:.32"><i style="background:#FFBB00"></i><i class="w s"></i></span>
            <span class="b3" style="--d:6.8s;--p:.26"><i style="background:#22C55E"></i><i class="w"></i></span>
          </div>
          <div class="sdxt-tab">
            <div class="sdxt-tab-in">
              <video
                class="sdxt-vid"
                src="/media/sdx-bfy-widgets.mp4"
                poster="/media/sdx-bfy-widgets-poster.jpg"
                muted
                loop
                playsinline
                preload="none"
                aria-label={t.dashboards_aria_label_video_building_a}></video>
            </div>
          </div>
          <span class="sdxt-pill sdxt-eye" aria-hidden="true" style="--d:7s;--p:.28"
            ><b style="background:#2A73FF"
              ><svg
                viewbox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="#fff"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"
                ></circle></svg
              ></b
            >{t.dashboards_preview}</span
          >
        </div>
      </div>
    </section>
    <style is:global>
      /* room: widgets */
      .sdxt-widg {
        padding: 130px 32px;
        background: linear-gradient(180deg, #fff, #f3f7ff);
      }
      .sdxt-widg .sdxt-split {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
      }
      .sdxt-blocks {
        position: absolute;
        z-index: 2;
        right: -34px;
        top: -44px;
        width: 150px;
        height: 120px;
        pointer-events: none;
      }
      .sdxt-blocks span {
        position: absolute;
        display: flex;
        flex-direction: column;
        gap: 7px;
        padding: 11px;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 12px 28px rgba(18, 37, 92, 0.15);
        transform: translate3d(0, var(--py, 0px), 0);
      }
      .sdxt-blocks i {
        display: block;
        height: 9px;
        border-radius: 5px;
        width: 64px;
      }
      .sdxt-blocks i.w {
        background: #e3e8f0;
        width: 88px;
      }
      .sdxt-blocks i.s {
        width: 50px;
      }
      .sdxt-blocks .b1 {
        right: 58px;
        top: 0;
      }
      .sdxt-blocks .b2 {
        right: 0;
        top: 28px;
      }
      .sdxt-blocks .b3 {
        right: 40px;
        top: 74px;
      }
      .sdxt-widg .sdxt-eye {
        z-index: 2;
        left: -38px;
        bottom: 16%;
        font-size: 14px;
        font-weight: 600;
        color: #0f1b2d;
      }
      @media all {
        .sdxt-blocks span {
          animation: sdxtBob var(--d, 6s) ease-in-out infinite alternate;
        }
      }
      @media (max-width: 1340px) {
        .sdxt-blocks {
          right: -8px;
        }
        .sdxt-widg .sdxt-eye {
          left: -14px;
        }
      }
      @media (max-width: 1024px) {
        .sdxt-widg {
          padding: 96px 24px;
        }
        .sdxt-widg .sdxt-split {
          grid-template-columns: 1fr;
        }
        .sdxt-widg .sdxt-visual {
          order: -1;
          max-width: 720px;
          margin: 0 auto;
          width: 100%;
        }
        .sdxt-widg .sdxt-eye {
          display: none;
        }
        .sdxt-blocks {
          right: -6px;
          top: -38px;
          transform: scale(0.8);
          transform-origin: 100% 0;
        }
      }
      @media (max-width: 767px) {
        .sdxt-widg {
          padding: 76px 18px;
        }
        .sdxt-blocks {
          transform: scale(0.6);
          top: -30px;
        }
        .sdxt-blocks .b3 {
          display: none;
        }
      }
    </style>
  </div>
</div>
