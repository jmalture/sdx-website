---
import { dict } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props;
const t = dict(data, lang);
const logos = [1, 2, 3, 4, 5, 6];
---
<div class="elementor-element elementor-element-sdxsec2 sdx-section2 e-flex e-con-boxed e-con e-parent" data-id="sdxsec2" id="features">
<div class="e-con-inner">
<div class="elementor-element elementor-element-sdxlband e-con-full sdx-logoband e-flex e-con e-child" data-id="sdxlband">
<div class="elementor-element elementor-element-sdxlogos sdx-logostrip elementor-widget elementor-widget-image-carousel" data-id="sdxlogos">
<div class="sx-logos" role="region" aria-label={t.sdxsec2_label}>
<ul class="sx-logos__track">
{[0, 1].map((copy) => logos.map((n) => (
<li class="sx-logos__item" aria-hidden={copy === 1 ? 'true' : undefined}><img decoding="async" loading="lazy" src={`/media/sdx-partner-${n}.png`} alt={copy === 1 ? '' : t[`sdxsec2_logo${n}`]} width="150" height="40" /></li>
)))}
</ul>
</div>
<style is:global>
/* replaces the Elementor/Swiper image carousel: continuous linear scroll, 6/4/3 logos per view, gap 60/40/24px, 4 s per logo */
.sx-logos{--n:6;--gap:60px;container-type:inline-size;overflow:hidden;width:100%}
.sx-logos__track{display:flex;gap:var(--gap);width:max-content;margin:0;padding:0;list-style:none;animation:sx-logos calc(6 * 4s) linear infinite}
.sx-logos__item{flex:0 0 calc((100cqw - (var(--n) - 1) * var(--gap)) / var(--n));display:flex;align-items:center;justify-content:center;height:44px}
.sx-logos__item img{display:block;max-width:100%;height:auto}
@keyframes sx-logos{to{transform:translateX(calc(-6 * ((100cqw - (var(--n) - 1) * var(--gap)) / var(--n) + var(--gap))))}}
@media (max-width:1024px){.sx-logos{--n:4;--gap:40px}}
@media (max-width:767px){.sx-logos{--n:3;--gap:24px}}
@media (prefers-reduced-motion:reduce){.sx-logos__track{animation-duration:calc(6 * 8s)}}
</style>
</div>
</div>
</div>
</div>
</div>
