---
/** All sections of the home page, in order. To reorder or remove a section, edit the list below. */
import type { Lang } from '../../i18n';
import Hero from './01-hero.astro';
import Logos from './02-logos.astro';
import Welcome from './03-welcome.astro';
import Files from './04-files.astro';
import AuditLog from './05-audit-log.astro';
import Sharing from './06-sharing.astro';
import Integrations from './07-integrations.astro';
import Branding from './08-branding.astro';
import Workflows from './09-workflows.astro';
import Dashboards from './10-dashboards.astro';
import Portal from './11-portal.astro';
import WhySdx from './12-why-sdx.astro';
import Mobile from './13-mobile.astro';
import Faq from './14-faq.astro';
import Contact from './15-contact.astro';
const { lang } = Astro.props as { lang: Lang };
---

<div class="elementor elementor-358">
  <Hero lang={lang} />
  <Logos lang={lang} />
  <Welcome lang={lang} />
  <Files lang={lang} />
  <AuditLog lang={lang} />
  <Sharing lang={lang} />
  <Integrations lang={lang} />
  <Branding lang={lang} />
  <Workflows lang={lang} />
  <Dashboards lang={lang} />
  <Portal lang={lang} />
  <WhySdx lang={lang} />
  <Mobile lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</div>
