---
import { dict } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props;
const t = dict(data, lang);
---
<div class="elementor-element elementor-element-sdxt05 e-con-full e-flex e-con e-parent" data-id="sdxt05">
<div class="elementor-element elementor-element-sdxt05w elementor-widget elementor-widget-html" data-id="sdxt05w">
<section class="sdxt sdxt-integ" id="raum-integrieren">
<div class="sdxt-wrap sdxt-split">
<div class="sdxt-visual">
<div class="sdxt-canvas">
<svg class="sdxt-wires" viewbox="0 0 135 100" aria-hidden="true">
<path id="sdxw1" d="M17 15 C 24 15, 26 26, 30 30"></path>
<path id="sdxw2" d="M15 85 C 22 85, 26 74, 30 70"></path>
<path id="sdxw3" d="M118 13 C 111 13, 109 26, 105 30"></path>
<path id="sdxw4" d="M120 83 C 113 83, 109 74, 105 70"></path>
<circle r="1.1" fill="#FFA600"><animatemotion dur="2.6s" repeatcount="indefinite"><mpath href="#sdxw1"></mpath></animatemotion></circle>
<circle r="1.1" fill="#C800FF"><animatemotion dur="3.1s" repeatcount="indefinite" keypoints="1;0" keytimes="0;1" calcmode="linear"><mpath href="#sdxw2"></mpath></animatemotion></circle>
<circle r="1.1" fill="#00AAFF"><animatemotion dur="2.8s" repeatcount="indefinite" keypoints="1;0" keytimes="0;1" calcmode="linear"><mpath href="#sdxw3"></mpath></animatemotion></circle>
<circle r="1.1" fill="#22C55E"><animatemotion dur="3.4s" repeatcount="indefinite"><mpath href="#sdxw4"></mpath></animatemotion></circle>
</svg>
<div class="sdxt-tab sdxt-hub"><div class="sdxt-tab-in">
<img src="/media/sdx-welcome-screen.jpg" alt={t.sdxt05_a1} loading="lazy" decoding="async" />
</div></div>
<span class="sdxt-node n1" style="--d:6.2s"><b style="background:#FFA600"><svg viewbox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg></b><span>ERP</span></span>
<span class="sdxt-node n2" style="--d:7s"><b style="background:#C800FF"><svg viewbox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6 6 0 0 1 3.5 5.5"></path></svg></b><span>CRM</span></span>
<span class="sdxt-node n3" style="--d:6.6s"><b style="background:#00AAFF"><svg viewbox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg></b><span>{t.sdxt05_t2}</span></span>
<span class="sdxt-node n4" style="--d:7.6s"><b style="background:#22C55E"><svg viewbox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3h4v3a2 2 0 1 0 4 0V3h3v7h-3a2 2 0 1 0 0 4h3v7h-7v-3a2 2 0 1 0-4 0v3H3v-7h3a2 2 0 1 0 0-4H3V3z"></path></svg></b><span>{t.sdxt05_t3}</span></span>
<span class="sdxt-api" aria-hidden="true">API</span>
</div>
</div>
<div class="sdxt-text">
<p class="sdxt-eyebrow">{t.sdxt05_t4}</p>
<h2 class="sdxt-h">{t.sdxt05_t5} <span class="sdxt-blue">{t.sdxt05_t6}</span></h2>
<p class="sdxt-lead">{t.sdxt05_t7}</p>
</div>
</div>
</section>
<style is:global>
/* room: integrate (canvas) */
.sdxt-integ{padding:130px 32px;background:linear-gradient(180deg,#F3F7FF,#EEF4FF);}
.sdxt-canvas{position:relative;aspect-ratio:1.35;width:100%;}
.sdxt-wires{position:absolute;inset:0;width:100%;height:100%;overflow:visible;}
.sdxt-wires path{fill:none;stroke:#9DB8EC;stroke-width:.45;stroke-dasharray:1.4 1.2;stroke-linecap:round;}
.sdxt-hub{position:absolute;left:22%;top:22.5%;width:56%;}
.sdxt-hub .sdxt-tab-in{aspect-ratio:1.5625;}
.sdxt-node{position:absolute;z-index:2;display:inline-flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;border-radius:14px;background:#fff;box-shadow:0 12px 28px rgba(18,37,92,.14);font-size:14px;font-weight:600;color:#0F1B2D;white-space:nowrap;transform:translate(-50%,-50%);}
.sdxt-node b{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex:none;}
.sdxt-node.n1{left:12.6%;top:15%;} .sdxt-node.n2{left:11.1%;top:85%;} .sdxt-node.n3{left:87.4%;top:13%;} .sdxt-node.n4{left:88.9%;top:83%;}
.sdxt-api{position:absolute;z-index:2;left:50%;top:22.5%;transform:translate(-50%,-50%);padding:5px 12px;border-radius:999px;background:#2A73FF;color:#fff;font-size:12px;font-weight:700;letter-spacing:.08em;box-shadow:0 8px 18px rgba(42,115,255,.35);}
@media all{.sdxt-node{animation:sdxtBob var(--d,6s) ease-in-out infinite alternate;}}
@media (prefers-reduced-motion:reduce){.sdxt-wires circle{display:none;}}
@media (max-width:1024px){
  .sdxt-integ{padding:96px 24px;}
  .sdxt-integ .sdxt-split{grid-template-columns:1fr;}
  .sdxt-integ .sdxt-visual{max-width:720px;margin:0 auto;width:100%;}
}
@media (max-width:767px){
  .sdxt-integ{padding:76px 18px;}
  .sdxt-node{padding:4px;border-radius:11px;} .sdxt-node span{display:none;} .sdxt-node b{width:28px;height:28px;border-radius:8px;}
  .sdxt-wires circle{display:none;}
  .sdxt-hub{left:16%;width:68%;top:17%;} .sdxt-api{top:17%;font-size:11px;padding:4px 10px;}
}
</style>
</div>
</div>
