---
/**
 * Section "mobile": SDX unterwegs.
 * Texts: src/i18n/home.json, keys starting with "mobile_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div
  class="elementor-element elementor-element-sdxsec4 sdx-otg e-flex e-con-boxed e-con e-parent"
  data-id="sdxsec4"
  id="download"
>
  <div class="e-con-inner">
    <div
      class="elementor-element elementor-element-sdxotgrow e-con-full sdx-otg-row e-flex e-con e-child"
      data-id="sdxotgrow"
    >
      <div
        class="elementor-element elementor-element-sdxotgL e-con-full sdx-otg-left e-flex e-con e-child"
        data-id="sdxotgL"
      >
        <div
          class="elementor-element elementor-element-sdxotgh sdx-otg-h elementor-invisible elementor-widget elementor-widget-heading"
          data-id="sdxotgh"
          data-anim="sdxRiseIn"
          data-anim-delay="0"
        >
          <h2 class="elementor-heading-title elementor-size-default">{t.mobile_sdx_on_the_go}</h2>
        </div>
        <div
          class="elementor-element elementor-element-sdxotgp sdx-otg-p elementor-invisible elementor-widget elementor-widget-heading"
          data-id="sdxotgp"
          data-anim="sdxRiseIn"
          data-anim-delay="120"
        >
          <p class="elementor-heading-title elementor-size-default">{t.mobile_use_our_mobile_version}</p>
        </div>
      </div>
      <div
        class="elementor-element elementor-element-sdxotgR e-con-full sdx-otg-right e-flex e-con e-child"
        data-id="sdxotgR"
      >
        <div
          class="elementor-element elementor-element-3f952f3 sdx-otg-abs sdx-otg-phone-wrap elementor-absolute elementor-invisible elementor-widget elementor-widget-html"
          data-id="3f952f3"
          data-anim="sdxChipInUp"
          data-anim-delay="150"
        >
          <div class="sdx-otg-phone">
            <div class="scrwrap">
              <img class="scr" src="/media/sdx-phone-screen.png" width="249" height="511" alt="" />
            </div><img
              class="frame"
              src="/media/sdx-phone-frame-transparent.png"
              width="284"
              height="489"
              alt={t.mobile_alt_sdx_mobile_app}
            />
          </div>
        </div>
        <div
          class="elementor-element elementor-element-79fa668 sdx-otg-abs sdx-otg-folder-wrap elementor-absolute elementor-invisible elementor-widget elementor-widget-html"
          data-id="79fa668"
          data-anim="sdxRiseIn"
          data-anim-delay="450"
        >
          <div class="sdx-otg-float f1">
            <div style="transform:rotate(-30deg)">
              <div class="sdx-folder" style="--fc:#4FE1B4">
                <div class="sdx-folder-base">
                  <div class="sdx-folder-tab"></div><div class="sdx-folder-paper p1"></div><div
                    class="sdx-folder-paper p2"
                  >
                  </div><div class="sdx-folder-paper p3"></div><div class="sdx-folder-front f1"></div><div
                    class="sdx-folder-front f2"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="elementor-element elementor-element-b1fcea9 sdx-otg-abs sdx-otg-folder-wrap elementor-absolute elementor-invisible elementor-widget elementor-widget-html"
          data-id="b1fcea9"
          data-anim="sdxRiseIn"
          data-anim-delay="600"
        >
          <div class="sdx-otg-float f2">
            <div style="transform:rotate(22deg)">
              <div class="sdx-folder" style="--fc:#3FBAFE">
                <div class="sdx-folder-base">
                  <div class="sdx-folder-tab"></div><div class="sdx-folder-paper p1"></div><div
                    class="sdx-folder-paper p2"
                  >
                  </div><div class="sdx-folder-paper p3"></div><div class="sdx-folder-front f1"></div><div
                    class="sdx-folder-front f2"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
