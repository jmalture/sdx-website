---
/**
 * Section "contact": Lassen Sie uns Ihr Portal bauen.
 * Texts: src/i18n/home.json, keys starting with "contact_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-sdxt10 e-con-full e-flex e-con e-parent" data-id="sdxt10">
  <div class="elementor-element elementor-element-sdxt10w elementor-widget elementor-widget-html" data-id="sdxt10w">
    <section class="sdxt sdxt-cta" id="kontakt">
      <i
        class="sdxt-fold cf1"
        aria-hidden="true"
        style="--c:#FFA600;--s:60px;--r:-12deg;left:12%;top:22%;--d:6.6s;--p:.22"></i>
      <i
        class="sdxt-fold cf2"
        aria-hidden="true"
        style="--c:#C800FF;--s:44px;--r:10deg;right:13%;top:58%;--d:7.4s;--p:.3"></i>
      <div class="sdxt-wrap">
        <div class="sdxt-ctabox">
          <p class="sdxt-eyebrow">{t.contact_end_of_the_tour}</p>
          <h2 class="sdxt-h">
            {t.contact_lets_build}
            <span class="sdxt-blue">{t.contact_your_portal}</span>
            {t.contact_together}
          </h2>
          <p class="sdxt-lead">{t.contact_every_business_works_differently}</p>
        </div>
      </div>
    </section>
    <style is:global>
      /* closing CTA */
      .sdxt-cta {
        padding: 0 0 8px;
        background: transparent;
        overflow: visible;
      }
      .sdxt-ctabox {
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
      }
      .sdxt-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 34px;
        padding: 16px 28px;
        border-radius: 999px;
        background: #2a73ff;
        color: #fff !important;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 14px 30px rgba(42, 115, 255, 0.32);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease;
      }
      .sdxt-btn:hover {
        transform: translateY(-2px);
        background: #1f63e6;
        box-shadow: 0 18px 36px rgba(42, 115, 255, 0.4);
      }
      .sdxt-btn:focus-visible {
        outline: 3px solid #0f1b2d;
        outline-offset: 3px;
      }
      @media (max-width: 1340px) {
        .sdxt-cta .cf1 {
          left: 4% !important;
          top: 12% !important;
          --s: 48px !important;
        }
        .sdxt-cta .cf2 {
          right: 4% !important;
          top: auto !important;
          bottom: 12% !important;
          --s: 38px !important;
        }
      }
      @media (max-width: 1024px) {
        .sdxt-cta .sdxt-fold {
          display: none;
        }
      }
    </style>
  </div>
  <div
    class="elementor-element elementor-element-sdxt10f elementor-button-align-stretch elementor-widget elementor-widget-form"
    data-id="sdxt10f"
  >
    <form
      class="elementor-form"
      method="post"
      action="/api/contact/"
      data-contact
      data-ok={t.contact_ok_thank_you_we}
      data-error={t.contact_error_sorry_something_went}
      name={t.contact_name_sdx_demo_request}
      aria-label={t.contact_aria_label_sdx_demo_request}
    >
      <input type="hidden" name="form_id" value="sdxt10f" />
      <input type="hidden" name="lang" value={lang} />
      <div class="elementor-form-fields-wrapper elementor-labels-above">
        <div
          class="elementor-field-type-email elementor-field-group elementor-column elementor-field-group-email elementor-col-50 elementor-field-required elementor-mark-required"
        >
          <label for="form-field-email" class="elementor-field-label">
            {t.contact_email}
          </label>
          <input
            size="1"
            type="email"
            name="form_fields[email]"
            id="form-field-email"
            class="elementor-field elementor-size-sm elementor-field-textual"
            placeholder={t.contact_placeholder_name_company_com}
            required="required"
          />
        </div>
        <div
          class="elementor-field-type-tel elementor-field-group elementor-column elementor-field-group-phone elementor-col-50"
        >
          <label for="form-field-phone" class="elementor-field-label">
            {t.contact_phone}
          </label>
          <input
            size="1"
            type="tel"
            name="form_fields[phone]"
            id="form-field-phone"
            class="elementor-field elementor-size-sm elementor-field-textual"
            placeholder={t.contact_placeholder_44}
            pattern="[0-9()#&+*-=.]+"
            title="Only numbers and phone characters (#, -, *, etc) are accepted."
          />
        </div>
        <div
          class="elementor-field-type-textarea elementor-field-group elementor-column elementor-field-group-message elementor-col-100"
        >
          <label for="form-field-message" class="elementor-field-label">
            {t.contact_message}
          </label>
          <textarea
            class="elementor-field-textual elementor-field elementor-size-sm"
            name="form_fields[message]"
            id="form-field-message"
            rows="4"
            placeholder={t.contact_placeholder_whats_it_about}></textarea>
        </div>
        <div
          class="elementor-field-type-acceptance elementor-field-group elementor-column elementor-field-group-consent elementor-col-100 elementor-field-required elementor-mark-required"
        >
          <div class="elementor-field-subgroup">
            <span class="elementor-field-option">
              <input
                type="checkbox"
                name="form_fields[consent]"
                id="form-field-consent"
                class="elementor-field elementor-size-sm elementor-acceptance-field"
                required="required"
              />
              <label for="form-field-consent">{t.contact_i_agree_that_my}</label>
            </span>
          </div>
        </div>
        <div class="elementor-field-type-text">
          <input
            size="1"
            type="text"
            name="form_fields[website_hp]"
            id="form-field-website_hp"
            class="elementor-field elementor-size-sm"
            style="display:none !important;"
          />
        </div>
        <div
          class="elementor-field-group elementor-column elementor-field-type-submit elementor-col-100 e-form__buttons"
        >
          <button class="elementor-button elementor-size-md" type="submit">
            <span class="elementor-button-content-wrapper">
              <span class="elementor-button-text">{t.contact_request_a_demo}</span>
            </span>
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
