---
import { dict } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props;
const t = dict(data, lang);
---
<div class="elementor-element elementor-element-sdxhero0 sdx-hero e-flex e-con-boxed e-con e-parent" data-id="sdxhero0" id="hero">
<div class="e-con-inner">
<div class="elementor-element elementor-element-sdxherow e-con-full sdx-hero-row e-flex e-con e-child" data-id="sdxherow">
<div class="elementor-element elementor-element-sdxhleft e-con-full sdx-hero-left e-flex e-con e-child" data-id="sdxhleft">
<div class="elementor-element elementor-element-sdxhh1 sdx-hero-h1 elementor-widget elementor-widget-heading" data-id="sdxhh1">
<h1 class="elementor-heading-title elementor-size-default">{t.sdxhero0_t1}<br />{t.sdxhero0_t2}<br /><span style="color:#2A73FF">{t.sdxhero0_t3}</span></h1> </div>
<div class="elementor-element elementor-element-sdxhled sdx-hero-lede elementor-widget elementor-widget-heading" data-id="sdxhled">
<p class="elementor-heading-title elementor-size-default">{t.sdxhero0_t4}<br /><br />{t.sdxhero0_t5}</p> </div>
<div class="elementor-element elementor-element-sdxhbtns e-con-full sdx-hero-btns e-flex e-con e-child" data-id="sdxhbtns">
<div class="elementor-element elementor-element-sdxhb1 elementor-align-left sdx-btn-primary elementor-widget elementor-widget-button" data-id="sdxhb1">
<a class="elementor-button elementor-button-link elementor-size-sm" href="#features">
<span class="elementor-button-content-wrapper">
<span class="elementor-button-text">eXplore SDX</span>
</span>
</a>
</div>
</div>
</div>
<div class="elementor-element elementor-element-sdxhrght e-con-full sdx-hero-right e-flex e-con e-child" data-id="sdxhrght">
<div class="elementor-element elementor-element-sdxhimg sdx-hero-img elementor-widget elementor-widget-image" data-id="sdxhimg">
<img fetchpriority="high" decoding="async" width="2560" height="1574" src="/media/sdx-hero-laptop-scaled.png" class="attachment-full size-full wp-image-42" alt="SDX – Secure Data eXchange" srcset="/media/sdx-hero-laptop-scaled.png 2560w, /media/sdx-hero-laptop-300x184.png 300w, /media/sdx-hero-laptop-1024x630.png 1024w, /media/sdx-hero-laptop-768x472.png 768w, /media/sdx-hero-laptop-1536x944.png 1536w, /media/sdx-hero-laptop-2048x1259.png 2048w" sizes="(max-width: 2560px) 100vw, 2560px" /> </div>
<div class="elementor-element elementor-element-sdxsq0 sdx-sq-wrap sdx-sq-green elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxsq0" data-anim="sdxRiseIn" data-anim-delay="0">
<div class="sdx-sq" style="width:383px;height:383px;transform:rotate(60deg);background:linear-gradient(156deg,#A3F0C1 19%,#A6D4FC 92%)"></div> </div>
<div class="elementor-element elementor-element-sdxsq1 sdx-sq-wrap sdx-sq-blue elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxsq1" data-anim="sdxRiseIn" data-anim-delay="120">
<div class="sdx-sq" style="width:211px;height:211px;transform:rotate(-68deg);background:linear-gradient(156deg,#74B8F7 0%,#D1EAFF 100%)"></div> </div>
<div class="elementor-element elementor-element-sdxphost sdx-pill-wrap sdx-pill-hosted elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxphost" data-anim="sdxChipInLeft" data-anim-delay="350">
<div class="sdx-pill-float"><div class="sdx-pill" style="box-shadow:0 8px 16px rgba(61,156,245,.25)"><span class="sdx-pill-dot" style="background:#2A73FF"><svg viewbox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg></span><span class="sdx-pill-txt">{t.sdxhero0_t6}</span></div></div> </div>
<div class="elementor-element elementor-element-sdxpnoti sdx-pill-wrap sdx-pill-notif elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxpnoti" data-anim="sdxChipInRight" data-anim-delay="450">
<div class="sdx-pill-float"><div class="sdx-pill" style="box-shadow:0 8px 16px rgba(119,233,164,.25)"><span class="sdx-pill-dot" style="background:#23D660"><svg viewbox="0 0 24 24" width="17" height="17" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="2"></rect><path d="M7 11v4a2 2 0 0 0 2 2h4"></path><rect x="13" y="13" width="8" height="8" rx="2"></rect></svg></span><span class="sdx-pill-txt">{t.sdxhero0_t7}</span></div></div> </div>
<div class="elementor-element elementor-element-sdxpshar sdx-pill-wrap sdx-pill-share elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxpshar" data-anim="sdxChipInLeft" data-anim-delay="550">
<div class="sdx-pill-float"><div class="sdx-pill" style="box-shadow:0 8px 16px rgba(119,233,164,.25)"><span class="sdx-pill-dot" style="background:#23D660"><svg viewbox="0 0 24 24" width="17" height="17" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg></span><span class="sdx-pill-txt">{t.sdxhero0_t8}</span></div></div> </div>
<div class="elementor-element elementor-element-sdxpteam sdx-pill-wrap sdx-pill-teams elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxpteam" data-anim="sdxChipInUp" data-anim-delay="650">
<div class="sdx-pill-float"><div class="sdx-team" style="box-shadow:0 8px 16px rgba(61,156,245,.25)"><div class="sdx-team-t">{t.sdxhero0_t9}</div><div class="sdx-team-bar"><div class="sdx-team-fill"></div></div><div class="sdx-team-n">{t.sdxhero0_t10}</div></div></div> </div>
<div class="elementor-element elementor-element-sdxpapi sdx-pill-wrap sdx-pill-api elementor-absolute elementor-invisible elementor-widget elementor-widget-html" data-id="sdxpapi" data-anim="sdxChipInLeft" data-anim-delay="350">
<div class="sdx-pill-float"><div class="sdx-pill" style="box-shadow:0 8px 16px rgba(61,156,245,.25)"><span class="sdx-pill-dot" style="background:#2A73FF"><svg viewbox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg></span><span class="sdx-pill-txt">{t.sdxhero0_t11}</span></div></div> </div>
<div class="elementor-element elementor-element-sdxhvid sdx-hero-video-w elementor-widget elementor-widget-html" data-id="sdxhvid">
<style is:global>
.sdx-hero-media{position:relative;display:inline-block;max-width:100%;line-height:0;vertical-align:top}
.sdx-hero-media>img{display:block}
.sdx-hero-screen{position:absolute;left:11.42%;top:7.18%;width:76.53%;height:79.7%;overflow:hidden;border-radius:4px 4px 0 0;background:#EEF4F8;pointer-events:none}
.sdx-hero-screen video,.sdx-hero-screen img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top left;display:block}
.sdx-hero-screen video{opacity:0;transition:opacity .4s ease}
.sdx-hero-screen video.is-ready{opacity:1}
.sdx-hero-notch{position:absolute;left:44.75%;top:0;width:10.53%;height:2.8%;background:#0b0b0c;border-radius:0 0 6px 6px;z-index:2}
.elementor-widget.sdx-hero-video-w{position:absolute!important;width:0!important;height:0!important;overflow:hidden;margin:0!important;padding:0!important}
/* bigger laptop so the screen matches the feature-page hero frames (~660px wide at 1440) (2026-10-09) */
@media (min-width:1025px){.sdx-hero-right .sdx-hero-media{width:108%;max-width:none;margin-left:-4%}.sdx-hero-right .sdx-hero-media>img{width:100%;max-width:none}}
</style>
<script is:inline>
(function(){
  function init(){
    var img=document.querySelector('.sdx-hero-img img');
    if(!img||img.closest('.sdx-hero-media'))return;
    var wrap=document.createElement('div');wrap.className='sdx-hero-media';
    img.parentNode.insertBefore(wrap,img);wrap.appendChild(img);
    var scr=document.createElement('div');scr.className='sdx-hero-screen';
    scr.innerHTML='<img decoding="async" src="/media/sdx-hero-poster.jpg" alt="" aria-hidden="true"><span class="sdx-hero-notch"></span>';
    wrap.appendChild(scr);
    /* reduced-motion: video still plays (2026-10-05) */
    var v=document.createElement('video');
    v.muted=true;v.loop=true;v.autoplay=true;v.playsInline=true;v.setAttribute('playsinline','');v.setAttribute('muted','');v.preload='auto';
    v.setAttribute('aria-hidden','true');
    v.addEventListener('playing',function(){v.classList.add('is-ready');});
    v.src='/media/sdx-hero-demo.mp4';
    scr.insertBefore(v,scr.querySelector('.sdx-hero-notch'));
    var p=v.play();if(p&&p.catch)p.catch(function(){});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script> </div>
</div>
</div>
</div>
</div>
