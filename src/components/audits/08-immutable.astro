---
/**
 * Section "immutable": Einmal protokolliert. Für immer.
 * Texts: src/i18n/audits.json, keys starting with "immutable_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/audits.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-3f29535 e-flex e-con-full e-con e-parent" data-id="3f29535">
  <div class="elementor-element elementor-element-6cd9fa7 elementor-widget elementor-widget-html" data-id="6cd9fa7">
    <style is:global>
      /* 8 permanent trail (navy) + user history */
      .sxa-perm {
        padding: 130px 32px;
        background: #0f1b2d;
        color: #fff;
      }
      .sxa-perm .sxf-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(45% 60% at 80% 45%, rgba(42, 115, 255, 0.36), transparent 70%),
          radial-gradient(30% 40% at 6% 96%, rgba(0, 191, 255, 0.16), transparent 70%);
      }
      .sxa-perm .sxf-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 80px;
        align-items: center;
      }
      .sxa-perm .sxf-eyebrow {
        color: #7fb0ff;
      }
      .sxa-perm .sxf-h {
        color: #fff;
      }
      .sxa-perm .sxf-blue {
        color: #7fb0ff;
      }
      .sxa-perm .sxf-lead {
        color: rgba(255, 255, 255, 0.74);
      }
      .sxa-perm .sg {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 28px;
        margin: 42px 0 0;
        padding: 0;
      }
      .sxa-perm .sg li {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 16px;
        margin: 0;
      }
      .sxa-perm .sg .ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 13px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: #7fb0ff;
      }
      .sxa-perm .sg .ic svg {
        width: 21px;
        height: 21px;
      }
      .sxa-perm .sg strong {
        display: block;
        margin-top: 2px;
        font-size: 16.5px;
        line-height: 1.35;
        color: #fff;
      }
      .sxa-perm .sg span.d {
        display: block;
        margin-top: 5px;
        font-size: 14.5px;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.68);
      }
      .sxa-perm .vis {
        position: relative;
        display: grid;
        gap: 16px;
      }
      .sxa-perm .pan {
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(8px);
        box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.6);
        padding: 20px 22px;
      }
      .sxa-perm .ent .hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .sxa-perm .ent .hd strong {
        font-size: 15px;
      }
      .sxa-perm .ent .hd code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.55);
      }
      .sxa-perm .ent p {
        margin: 12px 0 0;
        font-size: 14px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.82);
      }
      .sxa-perm .ent .row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 16px;
      }
      .sxf.sxa-perm .ed {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        transition:
          background-color 0.2s ease,
          border-color 0.2s ease;
      }
      .sxa-perm .ed:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
      }
      .sxa-perm .ed svg {
        width: 16px;
        height: 16px;
      }
      .sxa-perm .ed.no {
        animation: sxaShake 0.45s ease;
        border-color: #f04438;
      }
      @keyframes sxaShake {
        20%,
        60% {
          transform: translateX(-6px);
        }
        40%,
        80% {
          transform: translateX(6px);
        }
      }
      .sxa-perm .msg {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
        color: #ffb4ae;
        opacity: 0;
        transform: translateX(-6px);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }
      .sxa-perm .msg svg {
        width: 15px;
        height: 15px;
      }
      .sxa-perm .msg.on {
        opacity: 1;
        transform: none;
      }
      .sxa-perm .uh .hd {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 14px;
      }
      .sxa-perm .uh .hd strong {
        font-size: 15px;
      }
      .sxa-perm .uh .hd small {
        margin-left: auto;
        padding: 4px 10px;
        border-radius: 999px;
        background: rgba(42, 115, 255, 0.22);
        border: 1px solid rgba(127, 176, 255, 0.35);
        font-size: 12px;
        font-weight: 600;
        color: #bfd6ff;
      }
      .sxa-perm .tl {
        list-style: none;
        margin: 0;
        padding: 0 0 0 6px;
      }
      .sxa-perm .tl li {
        position: relative;
        display: grid;
        grid-template-columns: 52px minmax(0, 1fr);
        gap: 12px;
        margin: 0;
        padding: 0 0 14px 18px;
        font-size: 13.5px;
        color: rgba(255, 255, 255, 0.82);
      }
      .sxa-perm .tl li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 5px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--c);
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
      }
      .sxa-perm .tl li::after {
        content: '';
        position: absolute;
        left: 4px;
        top: 18px;
        bottom: 2px;
        width: 1px;
        background: rgba(255, 255, 255, 0.14);
      }
      .sxa-perm .tl li:last-child {
        padding-bottom: 0;
      }
      .sxa-perm .tl li:last-child::after {
        display: none;
      }
      .sxa-perm .tl em {
        font-style: normal;
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.5);
      }
      .sxa-perm.is-run .tl li {
        animation: sxaTl 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
        animation-delay: calc(var(--n) * 0.15s);
      }
      @keyframes sxaTl {
        from {
          opacity: 0;
          transform: translateX(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      .sxa-perm .pill {
        top: -20px;
        right: 22px;
        font-size: 13px;
        color: #0f1b2d;
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      }
      .sxa-perm .f1 {
        left: -26px;
        bottom: -28px;
        --s: 52px;
        --c: #2a73ff;
        --r: -12deg;
        --d: 6.4s;
        z-index: 2;
      }
      @media (prefers-reduced-motion: reduce) {
        .sxa-perm .ed.no {
          animation: none;
        }
        .sxa-perm.is-run .tl li {
          animation: none;
        }
      }
      @media (max-width: 1180px) {
        .sxa-perm .sxf-wrap {
          gap: 48px;
        }
      }
      @media (max-width: 1024px) {
        .sxa-perm {
          padding: 104px 24px;
        }
        .sxa-perm .sxf-wrap {
          grid-template-columns: minmax(0, 1fr);
          gap: 64px;
        }
        .sxa-perm .sxf-text {
          max-width: 720px;
          margin: 0 auto;
        }
        .sxa-perm .vis {
          max-width: 560px;
          width: 100%;
          margin: 0 auto;
        }
      }
      @media (max-width: 767px) {
        .sxa-perm {
          padding: 84px 18px;
        }
        .sxa-perm .sg {
          grid-template-columns: minmax(0, 1fr);
          gap: 20px;
        }
        .sxa-perm .pan {
          padding: 16px;
        }
        .sxa-perm .ent .row {
          flex-wrap: wrap;
        }
        .sxa-perm .pill {
          right: 12px;
          font-size: 12px;
        }
        .sxa-perm .f1 {
          left: -8px;
          --s: 40px;
        }
      }
    </style>
    <section class="sxf sxa-perm" id="unveraenderbar" aria-labelledby="sxa-h-perm">
      <div class="sxf-glow" aria-hidden="true"></div>
      <div class="sxf-wrap">
        <div class="sxf-text" data-rv>
          <p class="sxf-eyebrow">{t.immutable_permanent_audit_trail}</p>
          <h2 class="sxf-h" id="sxa-h-perm">
            {t.immutable_logged_once}
            <span class="sxf-blue">{t.immutable_kept_for_good}</span>
          </h2>
          <p class="sxf-lead">{t.immutable_audit_entries_cannot_be}</p>
          <ul class="sg">
            <li>
              <span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24"
                  ><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"
                  ></path></svg
                ></span
              ><span
                ><strong>{t.immutable_not_editable}</strong><span class="d">{t.immutable_editing_audit_entries_is}</span
                ></span
              >
            </li><li>
              <span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg></span
              ><span
                ><strong>{t.immutable_automatic}</strong><span class="d"
                  >{t.immutable_relevant_actions_are_recorded}</span
                ></span
              >
            </li><li>
              <span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24"
                  ><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg
                ></span
              ><span><strong>User History</strong><span class="d">{t.immutable_a_user_s_history}</span></span>
            </li><li>
              <span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24"
                  ><rect x="3" y="4" width="18" height="7" rx="2"></rect><rect x="3" y="13" width="18" height="7" rx="2"
                  ></rect><path d="M7 7.5h.01M7 16.5h.01"></path></svg
                ></span
              ><span
                ><strong>{t.immutable_in_germany_or_on}</strong><span class="d"
                  >{t.immutable_hosting_in_germany_or}</span
                ></span
              >
            </li>
          </ul>
        </div>
        <div class="vis" data-rv style="--dl:.12s">
          <span class="sxf-fold f1" aria-hidden="true"></span>
          <div class="pan ent">
            <div class="hd"><strong>Delete content</strong><code>ID a81f2c90…</code></div>
            <p>User m.weber deleted content Vertrag_Nordwerk_v3.pdf · 15.10.2026, 16:42</p>
            <div class="row">
              <button type="button" class="sxf-b ed"
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><path d="M4 20h4L19 9l-4-4L4 16z"></path><path d="m13.5 6.5 4 4"></path></svg
                >{t.immutable_edit}</button
              ><span class="msg" role="status"
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"
                  ></path></svg
                >{t.immutable_audit_entries_cannot_be_2}</span
              >
            </div>
          </div>
          <div class="pan uh">
            <div class="hd">
              <span class="sxa-av" style="--c:#2A73FF">MW</span><strong>User History · m.weber</strong><small
                >{t.immutable_user_view}</small
              >
            </div>
            <ol class="tl">
              <li style="--n:0;--c:#F04438"><em>16:42</em><span>deleted content Vertrag_Nordwerk_v3.pdf</span></li>
              <li style="--n:1;--c:#A855F7"><em>16:40</em><span>previewed content Vertrag_Nordwerk_v3.pdf</span></li>
              <li style="--n:2;--c:#00A3D9"><em>15:12</em><span>updated content Angebot_Hallenneubau.pdf</span></li>
              <li style="--n:3;--c:#22C55E"><em>08:57</em><span>logged in</span></li>
            </ol>
          </div>
          <span class="sxf-pill pill" aria-hidden="true"
            ><b style="background:#22C55E"
              ><svg class="i" viewbox="0 0 24 24"
                ><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"></path><path d="m9 12 2 2 4-4"></path></svg
              ></b
            >{t.immutable_logged_permanently}</span
          >
        </div>
      </div>
    </section>
    <script is:inline>
      (function () {
        function init(s) {
          if (s.__sxa) return;
          s.__sxa = 1;
          var b = s.querySelector('.ed'),
            m = s.querySelector('.msg'),
            t;
          b.addEventListener('click', function () {
            b.classList.remove('no');
            void b.offsetWidth;
            b.classList.add('no');
            m.classList.add('on');
            clearTimeout(t);
            t = setTimeout(function () {
              m.classList.remove('on');
              b.classList.remove('no');
            }, 2400);
          });
          if (!('IntersectionObserver' in window)) {
            s.classList.add('is-run');
            return;
          }
          var io = new IntersectionObserver(
            function (es) {
              if (es[0].isIntersecting) {
                s.classList.add('is-run');
                io.disconnect();
              }
            },
            { threshold: 0.3 },
          );
          io.observe(s.querySelector('.uh'));
        }
        function go() {
          document.querySelectorAll('.sxa-perm').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
</div>
