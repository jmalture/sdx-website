---
/**
 * Section "functions": Alles, was ein guter Audit Trail braucht.
 * Texts: src/i18n/audits.json, keys starting with "functions_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/audits.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-30f99b9 e-flex e-con-full e-con e-parent" data-id="30f99b9">
  <div class="elementor-element elementor-element-39e3647 elementor-widget elementor-widget-html" data-id="39e3647">
    <style is:global>
      /* 9 functions grid */
      .sxf-fx {
        padding: 128px 32px;
        background: #fff;
      }
      .sxf-bento {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-top: 60px;
      }
      .sxf-bt {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 26px 26px 28px;
        border-radius: 22px;
        background: #f7f9fc;
        border: 1px solid #e8edf5;
        transition:
          background-color 0.3s ease,
          box-shadow 0.3s ease,
          transform 0.3s ease,
          border-color 0.3s ease;
      }
      .sxf-bt:hover {
        background: #fff;
        border-color: #d6e3fa;
        box-shadow: 0 22px 44px -20px rgba(18, 37, 92, 0.22);
        transform: translateY(-3px);
      }
      .sxf-bt .ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: color-mix(in srgb, var(--c) 14%, #fff);
        color: var(--c);
      }
      .sxf-bt .ic svg {
        width: 21px;
        height: 21px;
      }
      .sxf-bt h3 {
        margin: 18px 0 6px;
        font-family: Inter, sans-serif;
        font-size: 17.5px;
        line-height: 1.35;
        font-weight: 700;
        color: #0f1b2d;
      }
      .sxf-bt p {
        margin: 0;
        font-size: 15px;
        line-height: 1.5;
        color: #4a5568;
      }
      .sxf-bt .fm {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 14px;
      }
      .sxf-bt .fm span {
        padding: 3px 8px;
        border-radius: 7px;
        background: #fff;
        border: 1px solid #e3e8f0;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.03em;
        color: #3d4555;
      }
      @media (max-width: 1180px) {
        .sxf-bento {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 1024px) {
        .sxf-fx {
          padding: 104px 24px;
        }
        .sxf-bento {
          margin-top: 48px;
        }
      }
      @media (max-width: 767px) {
        .sxf-fx {
          padding: 84px 18px;
        }
        .sxf-bento {
          grid-template-columns: minmax(0, 1fr);
          gap: 14px;
          margin-top: 40px;
        }
        .sxf-bt {
          padding: 22px 20px 24px;
        }
      }
    </style>
    <section class="sxf sxf-fx" id="funktionen" aria-labelledby="sxf-h-fx">
      <div class="sxf-wrap">
        <div class="sxf-head" data-rv>
          <p class="sxf-eyebrow">{t.functions_functions}</p>
          <h2 class="sxf-h" id="sxf-h-fx">
            {t.functions_everything_a}
            <span class="sxf-blue">{t.functions_good_audit_trail}</span>
            {t.functions_needs}
          </h2>
          <p class="sxf-lead">{t.functions_available_in_sdx_today}</p>
        </div>
        <div class="sxf-bento">
          <article class="sxf-bt" style="--c:#2A73FF;--dl:0.00s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 10h18M9 10v10"></path></svg
              ></span
            ><h3>{t.functions_audit_overview}</h3><p>{t.functions_all_entries_as_a}</p>
          </article>
          <article class="sxf-bt" style="--c:#22C55E;--dl:0.06s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg
              ></span
            ><h3>{t.functions_date_filter}</h3><p>{t.functions_narrow_audit_entries_down}</p>
          </article>
          <article class="sxf-bt" style="--c:#F04438;--dl:0.12s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"></path></svg
              ></span
            ><h3>{t.functions_action_filter}</h3><p>{t.functions_filter_by_logged_activity}</p>
          </article>
          <article class="sxf-bt" style="--c:#C800FF;--dl:0.18s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg
              ></span
            ><h3>{t.functions_user_portal_entity_id}</h3><p>{t.functions_filter_by_people_portals}</p>
          </article>
          <article class="sxf-bt" style="--c:#0F1B2D;--dl:0.00s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path
                  d="M14 3v6h6M8 13h8M8 17h5"></path></svg
              ></span
            ><h3>{t.functions_audit_details}</h3><p>{t.functions_every_entry_with_created}</p>
          </article>
          <article class="sxf-bt" style="--c:#00A3D9;--dl:0.06s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg
              ></span
            ><h3>User History</h3><p>{t.functions_open_a_user_s}</p>
          </article>
          <article class="sxf-bt" style="--c:#16A34A;--dl:0.12s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><path d="M12 4v12M7 11l5 5 5-5M4 20h16"></path></svg
              ></span
            ><h3>Export</h3><p>{t.functions_export_selected_fields_for}</p><div
              class="fm"
              aria-label={t.functions_aria_label_formats}
            >
              <span>TSV</span><span>CSV</span><span>XLSX</span><span>JSON</span>
            </div>
          </article>
          <article class="sxf-bt" style="--c:#F59000;--dl:0.18s" data-rv>
            <span class="ic" aria-hidden="true"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg
              ></span
            ><h3>{t.functions_notifications}</h3><p>{t.functions_get_informed_automatically_when}</p>
          </article>
        </div>
      </div>
    </section>
  </div>
</div>
