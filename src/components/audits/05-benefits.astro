        font-size: 22px;
        line-height: 1.3;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: #0f1b2d;
      }
      .sxf-vc p {
        margin: 0;
        font-size: 16px;
        line-height: 1.55;
        color: #4a5568;
      }
      .sxf-vc .more {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 20px;
        font-size: 14px;
        font-weight: 600;
        color: var(--c);
      }
      .sxf-vc .more svg {
        width: 16px;
        height: 16px;
      }
      .sxf-vc .pf {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 28px 30px;
        background: var(--k);
        color: #fff;
        clip-path: circle(0 at 57px 59px);
        transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .sxf-vc .pf b {
        display: block;
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.8;
      }
      .sxf-vc .pf ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 9px;
      }
      .sxf-vc .pf li {
        display: flex;
        gap: 10px;
        margin: 0;
        font-size: 15px;
        line-height: 1.45;
        font-weight: 500;
      }
      .sxf-vc .pf li svg {
        width: 18px;
        height: 18px;
        margin-top: 1px;
        stroke-width: 2.6;
      }
      @media (hover: hover) and (pointer: fine) {
        .sxf-vc:hover,
        .sxf-vc:focus-visible,
        .sxf-vc:focus-within {
          transform: translateY(-4px);
          box-shadow: 0 26px 50px -18px rgba(18, 37, 92, 0.28);
          border-color: transparent;
        }
        .sxf-vc:hover .pf,
        .sxf-vc:focus-visible .pf,
        .sxf-vc:focus-within .pf {
          clip-path: circle(150% at 57px 59px);
        }
      }
      .sxf-vc:focus-visible {
        outline: 2px solid #2a73ff;
        outline-offset: 3px;
      }
      @media (hover: none), (pointer: coarse) {
        .sxf-vc {
          min-height: 0;
        }
        .sxf-vc .more,
        .sxf-vc .pf b {
          display: none;
        }
        .sxf-vc .pf {
          position: static;
          clip-path: none;
          background: transparent;
          color: #0f1b2d;
          padding: 16px 0 0;
          margin-top: 18px;
          border-top: 1px solid #eef1f6;
        }
        .sxf-vc .pf li {
          font-size: 14.5px;
          color: #3d4555;
        }
        .sxf-vc .pf li svg {
          color: var(--c);
        }
      }
      @media (max-width: 1024px) {
        .sxf-val {
          padding: 104px 24px;
        }
        .sxf-vgrid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          margin-top: 48px;
        }
      }
      @media (max-width: 767px) {
        .sxf-val {
          padding: 84px 18px;
        }
        .sxf-vgrid {
          grid-template-columns: minmax(0, 1fr);
          gap: 16px;
          margin-top: 40px;
        }
        .sxf-vc {
          padding: 26px 22px;
        }
        .sxf-vc h3 {
          font-size: 20px;
          margin-top: 20px;
        }
