          </div>
          <div class="resw" data-rv style="--dl:.12s">
            <span class="sxf-fold f1" aria-hidden="true"></span>
            <div class="res" aria-live="polite">
              <div class="rh">
                <strong>{t.filters_audit_entries}</strong><span class="c"
                  ><b class="cnt">2.418</b>{t.filters_results}</span
                >
              </div>
              <div class="chips"></div>
              <div class="list">
                <div class="it" data-k="7d del ent">
                  <div>
                    <div class="row">
                      <span class="tm">15.10. 16:42</span><span class="sm"
                        ><span class="sxa-av" style="--c:#2A73FF">MW</span><span
                          ><b>m.weber</b> deleted content Vertrag_Nordwerk_v3.pdf</span
                        ></span
                      ><span class="sxa-act" style="--c:#F04438">Delete content</span>
                    </div>
                  </div>
                </div>
                <div class="it" data-k="7d">
                  <div>
                    <div class="row">
                      <span class="tm">15.10. 16:40</span><span class="sm"
                        ><span class="sxa-av" style="--c:#2A73FF">MW</span><span
                          ><b>m.weber</b> previewed content Vertrag_Nordwerk_v3.pdf</span
                        ></span
                      ><span class="sxa-act" style="--c:#A855F7">Preview content</span>
                    </div>
                  </div>
                </div>
                <div class="it" data-k="7d del">
                  <div>
                    <div class="row">
                      <span class="tm">14.10. 09:12</span><span class="sm"
                        ><span class="sxa-av" style="--c:#C800FF">AM</span><span
                          ><b>a.mueller</b> deleted content Entwurf_alt.docx</span
                        ></span
                      ><span class="sxa-act" style="--c:#F04438">Delete content</span>
                    </div>
                  </div>
                </div>
                <div class="it" data-k="7d">
                  <div>
                    <div class="row">
                      <span class="tm">12.10. 11:05</span><span class="sm"
                        ><span class="sxa-av" style="--c:#F59000">JK</span><span
