                    </div>
                  </div>
                </div>
                <div class="it" data-k="del">
                  <div>
                    <div class="row">
                      <span class="tm">02.09. 08:30</span><span class="sm"
                        ><span class="sxa-av" style="--c:#22C55E">TS</span><span
                          ><b>t.schulz</b> deleted content Notizen.txt</span
                        ></span
