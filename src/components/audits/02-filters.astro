      </div>
    </section>
    <script define:vars={{ T: { last7Days: t.filters_js_last_7_days } }}>
      (function () {
        var C = ['2.418', '312', '7', '1'],
          K = ['', '7d', 'del', 'ent'],
          CH = ['', T.last7Days, 'Delete content', '#48213'];
        function init(s) {
          if (s.__sxa) return;
          s.__sxa = 1;
          var st = [].slice.call(s.querySelectorAll('.st')),
            it = [].slice.call(s.querySelectorAll('.it')),
            cnt = s.querySelector('.cnt'),
            chips = s.querySelector('.chips'),
            res = s.querySelector('.res'),
            lv = 0;
          var rm = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
          // numbers in the page language (2.418 / 2,418)
          var loc = document.documentElement.lang || 'de-DE';
          function fmt(v) {
            return parseInt(String(v).replace(/\D/g, ''), 10).toLocaleString(loc);
          }
          cnt.textContent = fmt(cnt.textContent);
          function num(a, b) {
            if (rm) {
              cnt.textContent = fmt(C[b]);
              return;
            }
            var x = parseInt(C[a].replace('.', ''), 10),
              y = parseInt(C[b].replace('.', ''), 10),
              t0 = null;
            function f(ts) {
              if (!t0) t0 = ts;
              var k = Math.min(1, (ts - t0) / 600);
              k = 1 - Math.pow(1 - k, 3);
              var v = Math.round(x + (y - x) * k);
              cnt.textContent = v.toLocaleString(loc);
              if (k < 1) requestAnimationFrame(f);
            }
            requestAnimationFrame(f);
          }
          function set(n) {
            var o = lv;
            lv = n;
            st.forEach(function (b, i) {
              var k = i + 1;
              b.classList.toggle('done', k <= n);
              b.disabled = k > n + 1;
              b.setAttribute('aria-pressed', k <= n ? 'true' : 'false');
            });
            it.forEach(function (e) {
              var ks = e.getAttribute('data-k').split(' '),
                ok = true;
              for (var j = 1; j <= n; j++) {
                if (ks.indexOf(K[j]) < 0) ok = false;
              }
              e.classList.toggle('out', !ok);
            });
            chips.innerHTML = '';
            for (var j = 1; j <= n; j++) {
              var c = document.createElement('span');
              c.textContent = CH[j];
              chips.appendChild(c);
            }
            res.classList.toggle('found', n === 3);
            if (o !== n) num(o, n);
          }
          st.forEach(function (b, i) {
            b.addEventListener('click', function () {
              if (!b.disabled && lv === i) set(i + 1);
            });
          });
          s.querySelector('.rst').addEventListener('click', function () {
            set(0);
          });
          set(0);
        }
        function go() {
          document.querySelectorAll('.sxa-hunt').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
</div>
