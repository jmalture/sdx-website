---
/**
 * Section "cta": Sehen Sie Ihren Audit Trail in Aktion.
 * Texts: src/i18n/audits.json, keys starting with "cta_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/audits.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-8a532b3 e-flex e-con-full e-con e-parent" data-id="8a532b3">
  <div class="elementor-element elementor-element-39a4033 elementor-widget elementor-widget-html" data-id="39a4033">
    <style is:global>
      /* 12 closing CTA */
      .sxf-cta {
        padding: 128px 32px 136px;
        background: #2a73ff;
        color: #fff;
        text-align: center;
      }
      .sxf-cta .sxf-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(50% 45% at 50% 100%, rgba(255, 255, 255, 0.22), transparent 70%),
          radial-gradient(35% 45% at 0% 0%, rgba(0, 191, 255, 0.35), transparent 70%),
          radial-gradient(35% 45% at 100% 10%, rgba(200, 0, 255, 0.22), transparent 70%);
      }
      .sxf-cta .sxf-head {
        max-width: 760px;
      }
      .sxf-cta .sxf-eyebrow {
        color: rgba(255, 255, 255, 0.82);
      }
      .sxf-cta .sxf-h {
        color: #fff;
      }
      .sxf-cta .sxf-lead {
        color: rgba(255, 255, 255, 0.88);
      }
      .sxf-cta .sxf-ctas {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 38px;
      }
      .sxf-cta a.sxf-btn-w,
      .sxf-cta a.sxf-btn-w:visited {
        background: #fff;
        color: #2a73ff;
      }
      .sxf-cta a.sxf-btn-w:hover,
      .sxf-cta a.sxf-btn-w:focus-visible {
        background: #fff;
        color: #1f63eb;
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(10, 30, 90, 0.35);
      }
      .sxf-cta a.sxf-btn-g,
      .sxf-cta a.sxf-btn-g:visited {
        background: transparent;
        color: #fff;
        border-color: rgba(255, 255, 255, 0.55);
      }
      .sxf-cta a.sxf-btn-g:hover,
      .sxf-cta a.sxf-btn-g:focus-visible {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        border-color: #fff;
        transform: translateY(-2px);
      }
      .sxf-cta a:focus-visible {
        outline-color: #fff;
      }
      .sxf-cta .f1 {
        left: 7%;
        top: 20%;
        --s: 64px;
        --c: #ffbb00;
        --r: -12deg;
        --d: 6.6s;
      }
      .sxf-cta .f2 {
        right: 8%;
        top: 16%;
        --s: 50px;
        --c: #00bfff;
        --r: 12deg;
        --d: 5.8s;
      }
      @media (max-width: 1240px) {
        .sxf-cta .f1 {
          left: 3%;
        }
        .sxf-cta .f2 {
          right: 3%;
        }
      }
      @media (max-width: 1024px) {
        .sxf-cta {
          padding: 104px 24px 112px;
        }
        .sxf-cta .f1 {
          left: 3%;
          top: 4%;
          --s: 46px;
        }
        .sxf-cta .f2 {
          right: 3%;
          top: 5%;
          --s: 38px;
        }
      }
      @media (max-width: 767px) {
        .sxf-cta {
          padding: 92px 18px 92px;
        }
        .sxf-cta .f1 {
          top: 18px;
          --s: 36px;
        }
        .sxf-cta .f2 {
          top: 22px;
          --s: 30px;
        }
        .sxf-cta .sxf-ctas a.sxf-btn {
          flex: 1 1 220px;
        }
      }
    </style>
    <section class="sxf sxf-cta" id="demo" aria-labelledby="sxf-h-cta">
      <div class="sxf-glow" aria-hidden="true"></div>
      <div class="sxf-float" aria-hidden="true"><span class="sxf-fold f1"></span><span class="sxf-fold f2"></span></div>
      <div class="sxf-wrap">
        <div class="sxf-head" data-rv>
          <p class="sxf-eyebrow">Demo</p>
          <h2 class="sxf-h" id="sxf-h-cta">{t.cta_see_your_audit_trail}</h2>
          <p class="sxf-lead">{t.cta_we_show_you_audits}</p>
          <div class="sxf-ctas">
            <a class="sxf-btn sxf-btn-w" href={t.cta_link_kontakt}
              >{t.cta_request_a_demo}
              <svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a
            ><a class="sxf-btn sxf-btn-g" href={t.cta_link_home}>{t.cta_back_to_home}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
