---
/**
 * Section "use_cases": Wer im Unternehmen Audits nutzt.
 * Texts: src/i18n/audits.json, keys starting with "use_cases_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/audits.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-3ea285a e-flex e-con-full e-con e-parent" data-id="3ea285a">
  <div class="elementor-element elementor-element-e7a52ff elementor-widget elementor-widget-html" data-id="e7a52ff">
    <style is:global>
      /* 6 use cases: expanding department panels */
      .sxf-uc {
        padding: 128px 32px;
        background: linear-gradient(180deg, #f3f7ff 0%, #ffffff 100%);
      }
      .sxf-ucs {
        display: flex;
        gap: 14px;
        height: 520px;
        margin-top: 60px;
      }
      .sxf-ucp {
        position: relative;
        flex: 1 1 0;
        min-width: 0;
        border-radius: 26px;
        background: var(--t);
        border: 1px solid color-mix(in srgb, var(--c) 18%, transparent);
        overflow: hidden;
        transition:
          flex-grow 0.6s cubic-bezier(0.22, 1, 0.36, 1),
          box-shadow 0.4s ease,
          background-color 0.4s ease;
      }
      .sxf-ucp.is-on {
        flex-grow: 3.3;
        background: #fff;
        box-shadow: 0 30px 60px -24px rgba(18, 37, 92, 0.25);
        border-color: color-mix(in srgb, var(--c) 30%, transparent);
      }
      .sxf .sxf-uch {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 26px 24px;
      }
      .sxf-ucp.is-on .sxf-uch {
        position: relative;
        inset: auto;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 16px;
        padding: 30px 32px 0;
        cursor: default;
      }
      .sxf-uch .ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: var(--c);
        color: #fff;
        box-shadow: 0 12px 24px -10px var(--c);
        flex: none;
      }
      .sxf-uch .ic svg {
        width: 25px;
        height: 25px;
      }
      .sxf-uch .nm {
        display: block;
        font-size: 22px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: #0f1b2d;
      }
      .sxf-uch .ct {
        display: block;
        margin-top: 6px;
        font-size: 13px;
        font-weight: 600;
        color: color-mix(in srgb, var(--c) 75%, #0f1b2d);
      }
      .sxf-uch .lbl {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
      }
      .sxf-uch .pl {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        color: var(--c);
        box-shadow: 0 4px 12px rgba(18, 37, 92, 0.1);
        transition: transform 0.3s ease;
        flex: none;
      }
      .sxf-uch .pl svg {
        width: 18px;
        height: 18px;
      }
      .sxf-ucp:not(.is-on):hover .pl {
        transform: rotate(90deg);
      }
      .sxf-ucp.is-on .sxf-uch .nm {
        font-size: 26px;
      }
      .sxf-ucp.is-on .sxf-uch .lbl {
        display: block;
      }
      .sxf-ucp.is-on .sxf-uch .pl {
        display: none;
      }
      .sxf-ucb {
        position: absolute;
        left: 32px;
        right: 32px;
        bottom: 30px;
        top: 118px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 10px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(14px);
        transition:
          opacity 0.2s ease,
          transform 0.2s ease,
          visibility 0s 0.2s;
      }
      .sxf-ucp.is-on .sxf-ucb {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition:
          opacity 0.5s ease 0.25s,
          transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.25s,
          visibility 0s;
      }
      .sxf-ucb .uc {
        padding: 16px 20px;
        border-radius: 16px;
        background: var(--t);
      }
      .sxf-ucb .uc strong {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 17px;
        line-height: 1.35;
        font-weight: 700;
        color: #0f1b2d;
      }
      .sxf-ucb .uc strong i {
        width: 8px;
        height: 8px;
        border-radius: 3px;
        background: var(--c);
        flex: none;
      }
      .sxf-ucb .uc p {
        margin: 6px 0 0;
        font-size: 15px;
        line-height: 1.55;
        color: #4a5568;
      }
      @media (max-width: 1240px) {
        .sxf-ucs {
          height: 600px;
        }
        .sxf-ucp.is-on {
          flex-grow: 2.6;
        }
      }
      @media (max-width: 1024px) {
        .sxf-uc {
          padding: 104px 24px;
        }
        .sxf-ucs {
          flex-direction: column;
          height: auto;
          gap: 12px;
          margin-top: 48px;
          max-width: 720px;
          margin-left: auto;
          margin-right: auto;
        }
        .sxf-ucp,
        .sxf-ucp.is-on {
          flex: none;
        }
        .sxf .sxf-uch,
        .sxf-ucp.is-on .sxf-uch {
          position: relative;
          inset: auto;
          width: 100%;
          flex-direction: row;
          align-items: center;
          justify-content: flex-start;
          gap: 14px;
          padding: 18px 20px;
        }
        .sxf-uch .nm,
        .sxf-ucp.is-on .sxf-uch .nm {
          font-size: 20px;
        }
        .sxf-uch .lbl,
        .sxf-ucp.is-on .sxf-uch .lbl {
          display: flex;
          flex: 1;
          align-items: center;
        }
        .sxf-uch .ic {
          width: 44px;
          height: 44px;
          border-radius: 13px;
        }
        .sxf-uch .ic svg {
          width: 21px;
          height: 21px;
        }
        .sxf-uch .pl {
          display: flex !important;
        }
        .sxf-ucp.is-on .sxf-uch .pl {
          transform: rotate(45deg);
        }
        .sxf-ucp.is-on .sxf-uch {
          cursor: pointer;
        }
        .sxf-ucb {
          position: static;
          display: none;
          padding: 0 20px 20px;
          opacity: 1;
          visibility: visible;
          transform: none;
          transition: none;
        }
        .sxf-ucp.is-on .sxf-ucb {
          display: flex;
        }
      }
      @media (max-width: 767px) {
        .sxf-uc {
          padding: 84px 18px;
        }
        .sxf-ucb {
          padding: 0 14px 14px;
        }
        .sxf-ucb .uc {
          padding: 15px 16px;
        }
        .sxf-ucb .uc strong {
          font-size: 16px;
        }
      }
    </style>
    <section class="sxf sxf-uc" id="anwendungen" aria-labelledby="sxf-h-uc">
      <div class="sxf-wrap">
        <div class="sxf-head" data-rv>
          <p class="sxf-eyebrow">{t.use_cases_use_cases}</p>
          <h2 class="sxf-h" id="sxf-h-uc">
            {t.use_cases_who_uses}
            <span class="sxf-blue">Audits</span>
            {t.use_cases_in_your_company}
          </h2>
          <p class="sxf-lead">{t.use_cases_from_inspections_by_audit}</p>
        </div>
        <div class="sxf-ucs" data-rv>
          <article class="sxf-ucp is-on" style="--c:#2A73FF;--t:#EAF1FF">
            <button class="sxf-b sxf-uch" aria-expanded="true" aria-controls="sxa-uc0"
              ><span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
                  ></path></svg
                ></span
              ><span class="lbl"
                ><span><span class="nm">Compliance</span><span class="ct">{t.use_cases_2_examples}</span></span><span
                  class="pl"
                  aria-hidden="true"
                  ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></span
                ></span
              ></button
            ><div class="sxf-ucb" id="sxa-uc0">
              <div class="uc">
                <strong><i></i>{t.use_cases_evidence_for_audit_firms}</strong><p>
                  {t.use_cases_provide_audit_entries_centrally}
                </p>
              </div><div class="uc">
                <strong><i></i>{t.use_cases_reports_for_audits}</strong><p>
                  {t.use_cases_export_selected_audit_fields}
                </p>
              </div>
            </div>
          </article><article class="sxf-ucp" style="--c:#F04438;--t:#FFF0EF">
            <button class="sxf-b sxf-uch" aria-expanded="false" aria-controls="sxa-uc1"
              ><span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"></path></svg
                ></span
              ><span class="lbl"
                ><span><span class="nm">Security</span><span class="ct">{t.use_cases_2_examples}</span></span><span
                  class="pl"
                  aria-hidden="true"
                  ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></span
                ></span
              ></button
            ><div class="sxf-ucb" id="sxa-uc1">
              <div class="uc">
                <strong><i></i>{t.use_cases_clear_up_changes_and}</strong><p>
                  {t.use_cases_trace_changes_and_deletions}
                </p>
              </div><div class="uc">
                <strong><i></i>{t.use_cases_check_access_to_content}</strong><p>
                  {t.use_cases_analyse_previews_and_downloads}
                </p>
              </div>
            </div>
          </article><article class="sxf-ucp" style="--c:#16A34A;--t:#E9F8EF">
            <button class="sxf-b sxf-uch" aria-expanded="false" aria-controls="sxa-uc2"
              ><span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path
                    d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"></path></svg
                ></span
              ><span class="lbl"
                ><span><span class="nm">Administration</span><span class="ct">{t.use_cases_2_examples}</span></span
                ><span class="pl" aria-hidden="true"
                  ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></span
                ></span
              ></button
            ><div class="sxf-ucb" id="sxa-uc2">
              <div class="uc">
                <strong><i></i>{t.use_cases_check_user_history}</strong><p>{t.use_cases_open_a_single_user}</p>
              </div><div class="uc">
                <strong><i></i>{t.use_cases_analyse_by_portal_or}</strong><p>{t.use_cases_filter_audit_entries_by}</p>
              </div>
            </div>
          </article><article class="sxf-ucp" style="--c:#F59000;--t:#FFF4DF">
            <button class="sxf-b sxf-uch" aria-expanded="false" aria-controls="sxa-uc3"
              ><span class="ic" aria-hidden="true"
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"></path></svg
                ></span
              ><span class="lbl"
                ><span><span class="nm">IT &amp; Support</span><span class="ct">{t.use_cases_2_examples}</span></span
                ><span class="pl" aria-hidden="true"
                  ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg></span
                ></span
              ></button
            ><div class="sxf-ucb" id="sxa-uc3">
              <div class="uc">
                <strong><i></i>{t.use_cases_technical_root_cause_analysis}</strong><p>
                  {t.use_cases_use_audit_data_including}
                </p>
              </div><div class="uc">
                <strong><i></i>{t.use_cases_narrow_down_large_amounts}</strong><p>{t.use_cases_use_date_and_action}</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
    <script is:inline>
      (function () {
        function init(s) {
          if (s.__sxf) return;
          s.__sxf = 1;
          var ps = [].slice.call(s.querySelectorAll('.sxf-ucp')),
            t;
          var mq = window.matchMedia('(min-width:1025px)'),
            fine = window.matchMedia('(hover:hover) and (pointer:fine)');
          function on(i) {
            ps.forEach(function (p, k) {
              var o = k === i;
              p.classList.toggle('is-on', o);
              p.querySelector('.sxf-uch').setAttribute('aria-expanded', o ? 'true' : 'false');
            });
          }
          ps.forEach(function (p, k) {
            var h = p.querySelector('.sxf-uch');
            h.addEventListener('click', function () {
              if (!mq.matches && p.classList.contains('is-on')) {
                p.classList.remove('is-on');
                h.setAttribute('aria-expanded', 'false');
                return;
              }
              on(k);
            });
            p.addEventListener('mouseenter', function () {
              if (!mq.matches || !fine.matches) return;
              clearTimeout(t);
              t = setTimeout(function () {
                on(k);
              }, 140);
            });
            p.addEventListener('mouseleave', function () {
              clearTimeout(t);
            });
          });
          on(0);
        }
        function go() {
          document.querySelectorAll('.sxf-uc').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
</div>
