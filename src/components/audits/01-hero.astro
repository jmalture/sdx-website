    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('sxf-js');
        function go() {
          var els = [].slice.call(document.querySelectorAll('.sxf [data-rv]'));
          if (!('IntersectionObserver' in window) || document.visibilityState === 'hidden') {
            els.forEach(function (e) {
              e.classList.add('is-in');
            });
            return;
          }
          var io = new IntersectionObserver(
            function (es) {
              es.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add('is-in');
                  io.unobserve(en.target);
                }
              });
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.1 },
          );
          els.forEach(function (e) {
            io.observe(e);
          });
          setTimeout(function () {
            els.forEach(function (e) {
              var r = e.getBoundingClientRect();
              if (r.top < innerHeight && r.bottom > 0) e.classList.add('is-in');
            });
          }, 1200);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
      (function () {
        var A = {
          pv: ['Preview content', '#A855F7'],
          dl: ['Download content', '#2A73FF'],
          up: ['Upload content', '#F59000'],
          ud: ['Update content', '#00A3D9'],
          de: ['Delete content', '#F04438'],
          li: ['Login', '#22C55E'],
          sh: ['Create external sharing', '#16A34A'],
          at: ['Set app attribute', '#8A94A6'],
        };
        var U = {
          'a.mueller': '#C800FF',
          'm.weber': '#2A73FF',
          'j.klein': '#F59000',
          't.schulz': '#22C55E',
          Administrator: '#0F1B2D',
          'l.braun': '#00A3D9',
        };
        var L = [
          ['a.mueller', 'pv', 'previewed content Angebot_Q4.pdf'],
          ['m.weber', 'ud', 'updated content Vertrag_Nordwerk_v3.pdf'],
          ['j.klein', 'dl', 'downloaded content Preisliste_2026.pdf'],
          ['t.schulz', 'li', 'logged in'],
          ['Administrator', 'at', 'Set app attribute default expiry'],
          ['l.braun', 'up', 'uploaded content Pruefbericht_07.pdf'],
          ['m.weber', 'sh', 'created external sharing Pressematerial'],
          ['a.mueller', 'de', 'deleted content Entwurf_alt.docx'],
          ['j.klein', 'pv', 'previewed content Grundriss_B.dwg'],
          ['l.braun', 'dl', 'downloaded content Logo-Paket.zip'],
        ];
        function ini(u) {
          return u === 'Administrator'
            ? 'AD'
            : u
                .split('.')
                .map(function (p) {
                  return p[0];
                })
                .join('')
                .toUpperCase();
        }
        function row(x, t) {
          var a = A[x[1]],
            r = document.createElement('div');
          r.className = 'tr';
          r.innerHTML =
            '<span class="tm">' +
            t +
            '</span><span class="who"><span class="sxa-av" style="--c:' +
            U[x[0]] +
            '">' +
            ini(x[0]) +
            '</span><span>' +
            x[0] +
            '</span></span><span><span class="sxa-act" style="--c:' +
            a[1] +
            '">' +
            a[0] +
            '</span></span><span class="sm">' +
            (x[0] === 'Administrator' ? '' : 'User ' + x[0] + ' ') +
            x[2] +
            '</span>';
          return r;
        }
        function init(s) {
          if (s.__sxa) return;
          s.__sxa = 1;
          var box = s.querySelector('.rows'),
            cnt = s.querySelector('.cnt'),
            n = 676,
            i = 0,
            h = 16,
            m = 42,
            tm = null,
            vis = false;
          var rm = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
          function t() {
            m++;
            if (m > 59) {
              m = 0;
              h++;
            }
            return (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
          }
          for (var k = 0; k < 5; k++) {
            box.appendChild(row(L[(k + 5) % L.length], '16:' + (41 - k * 3)));
          }
          function push() {
            var r = row(L[i % L.length], t());
            i++;
            r.classList.add('new');
            box.insertBefore(r, box.firstChild);
            if (box.children.length > 5) box.removeChild(box.lastChild);
            n++;
            cnt.textContent = n;
          }
          function loop() {
            clearTimeout(tm);
            if (!vis || document.hidden) return;
            push();
            tm = setTimeout(loop, 2600);
          }
          if (rm) return;
          if ('IntersectionObserver' in window) {
            new IntersectionObserver(
              function (es) {
                vis = es[0].isIntersecting;
                if (vis) tm = setTimeout(loop, 900);
                else clearTimeout(tm);
              },
              { threshold: 0.3 },
            ).observe(s.querySelector('.sxa-app'));
          }
          document.addEventListener('visibilitychange', function () {
            if (!document.hidden && vis) loop();
          });
        }
        function go() {
          document.querySelectorAll('.sxf-hero').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
</div>
