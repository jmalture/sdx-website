<style is:global>
  /* The language select used to push the contact button to the right; without it, do that here. */
  .sx-header .elementor-element.sdx-cta {
    margin-left: auto;
  }
  /* ---- burger + mobile menu (phones only) ---- */
  .sx-burger-wrap {
    display: none;
  }
  @media (max-width: 767px) {
    .sx-burger-wrap {
      display: block;
      margin-left: 4px;
    }
    .sx-header .sx-burger,
    .sx-header .sx-burger:hover,
    .sx-header .sx-burger:focus {
      position: relative;
      display: block;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid #e3e8f1;
      border-radius: 12px;
      background: #fff !important;
      color: #0f1b2d;
      cursor: pointer;
    }
    .sx-burger span {
      position: absolute;
      left: 13px;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform 0.25s ease,
        opacity 0.2s ease;
    }
    .sx-burger span:nth-child(1) {
      top: 15px;
    }
    .sx-burger span:nth-child(2) {
      top: 21px;
    }
    .sx-burger span:nth-child(3) {
      top: 27px;
    }
    .sx-burger[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }
    .sx-burger[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }
    .sx-burger[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
  /* ---- side menu (phones) ---- */
  .sx-side {
    display: none;
  }
  @media (max-width: 767px) {
    .sx-side,
    .sx-side[hidden] {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 1000;
      pointer-events: none;
    }
    .sx-side.is-open {
      pointer-events: auto;
    }
    .sx-side-bg {
      position: absolute;
      inset: 0;
      background: rgba(10, 20, 40, 0.42);
      -webkit-backdrop-filter: blur(4px);
      backdrop-filter: blur(4px);
      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .sx-side.is-open .sx-side-bg {
      opacity: 1;
    }
    .sx-side-panel {
      position: absolute;
      top: 8px;
      right: 8px;
      bottom: 8px;
      width: min(340px, calc(100vw - 48px));
      display: flex;
      flex-direction: column;
      padding: 16px 18px 20px;
      border-radius: 24px;
      background: #fff;
      box-shadow:
        0 30px 60px -20px rgba(10, 20, 40, 0.45),
        0 0 0 1px rgba(15, 27, 45, 0.04);
      overflow-y: auto;
      transform: translateX(calc(100% + 24px)) scale(0.96);
      transform-origin: 100% 50%;
      transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
    }
    .sx-side.is-open .sx-side-panel {
      transform: none;
      transition: transform 0.55s cubic-bezier(0.34, 1.3, 0.5, 1);
    }
    .sx-side-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .sx-side-logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font:
        800 21px/1 Inter,
        sans-serif;
      letter-spacing: -0.02em;
      color: #0f1b2d;
      text-decoration: none;
    }
    .sx-side-logo svg {
      display: block;
      height: 26px;
      width: auto;
    }
    .sx-side .sx-side-x,
    .sx-side .sx-side-x:hover,
    .sx-side .sx-side-x:focus {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 12px;
      background: #f1f4f9;
      color: #0f1b2d;
      cursor: pointer;
    }
    .sx-side-x svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      transition: transform 0.4s ease;
    }
    .sx-side.is-open .sx-side-x svg {
      transform: rotate(90deg);
    }
    .sx-side ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    /* items rise in one after another */
    .sx-side li,
    .sx-side-cta {
      opacity: 0;
      transform: translateX(26px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }
    .sx-side.is-open li,
    .sx-side.is-open .sx-side-cta {
      opacity: 1;
      transform: none;
      transition:
        opacity 0.45s ease calc(0.12s + var(--i) * 0.06s),
        transform 0.6s cubic-bezier(0.34, 1.4, 0.5, 1) calc(0.12s + var(--i) * 0.06s);
    }
    .sx-side-main a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 4px;
      border-bottom: 1px solid #eef1f6;
      font:
        700 22px/1.2 Inter,
        sans-serif;
      letter-spacing: -0.01em;
      color: #0f1b2d;
      text-decoration: none;
    }
    .sx-side-main a i {
      font-style: normal;
      font-size: 18px;
      color: #2a73ff;
      transition: transform 0.25s ease;
    }
    .sx-side-main a:active i {
      transform: translateX(4px);
    }
    .sx-side-cards {
      display: grid;
      gap: 10px;
      margin-top: 18px !important;
    }
    .sx-side-cards a {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding: 14px;
      border-radius: 18px;
      background: var(--t);
      color: #0f1b2d;
      text-decoration: none;
      transition: transform 0.2s ease;
    }
    .sx-side-cards a:active {
      transform: scale(0.98);
    }
    .sx-side-cards .ic {
      flex: none;
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 13px;
      background: var(--c);
      color: #fff;
      box-shadow: 0 10px 18px -8px var(--c);
    }
    .sx-side-cards .ic svg {
      width: 21px;
      height: 21px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .sx-side-cards strong {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 16px;
    }
    .sx-side-cards em {
      padding: 2px 7px;
      border-radius: 999px;
      background: #ffbb00;
      color: #0f1b2d;
      font-style: normal;
      font-size: 10.5px;
      font-weight: 700;
    }
    .sx-side-cards small {
      display: block;
      margin-top: 3px;
      font-size: 13px;
      line-height: 1.45;
      color: #5b6475;
    }
    .sx-side a.sx-side-cta {
      margin-top: auto;
      padding: 15px;
      border-radius: 999px;
      background: #2a73ff;
      box-shadow: 0 14px 26px -12px rgba(42, 115, 255, 0.7);
      color: #fff;
      font:
        700 16px/1.2 Inter,
        sans-serif;
      text-align: center;
      text-decoration: none;
    }
    .sx-side-cards + .sx-side-cta {
      margin-top: auto;
    }
    html.sx-side-lock,
    html.sx-side-lock body {
      overflow: hidden;
    }
  }
  /* no animation until the script is ready: otherwise a page that loads its CSS late (dev server)
     or is restored from cache shows the panel flying out again on the new page */
  .sx-side:not(.is-ready),
  .sx-side:not(.is-ready) * {
    transition: none !important;
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .sx-side-panel,
    .sx-side li,
    .sx-side-cta {
      transition: opacity 0.2s ease !important;
      transform: none !important;
    }
  }
</style>
