---
/**
 * Site header (all pages): logo, Features mega menu, language select, contact button.
 * Texts: src/i18n/chrome.json, keys starting with "h_". The language select lists the languages
 * this page exists in (`alternates` from the page template).
 */
import { dict, LANGS, type Lang } from '../i18n';
import data from '../i18n/chrome.json';
const { lang, alternates } = Astro.props as { lang: Lang; alternates: Partial<Record<Lang, string>> };
const t = dict(data, lang);
const langs = LANGS.filter((l) => alternates[l.code]);
/** Language select in the header. Off until the EN/CZ texts are final; the language URLs still work. */
const SHOW_LANG_SWITCH = false;
---

<header class="elementor elementor-213 elementor-location-header sx-header">
  <div
    class="elementor-element elementor-element-11439fc0 e-con-full sdx-header e-flex e-con e-parent"
    data-id="11439fc0"
  >
    <div
      class="elementor-element elementor-element-124e0376 sdx-row e-flex e-con-boxed e-con e-child"
      data-id="124e0376"
    >
      <div class="e-con-inner">
        <div
          class="elementor-element elementor-element-11bf26b3 sdx-logo elementor-widget elementor-widget-html"
          data-id="11bf26b3"
        >
          <a href="/" class="sdx-logo-link" aria-label="SDX home"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              viewbox="0 0 89 28"
              role="img"
              aria-label="SDX — Secure Data eXchange"
            >
              <path
                d="M 27.297 4.814 L 27.297 16.216 C 27.297 18.889 25.187 21.055 22.584 21.055 L 22.152 21.055 L 22.152 9.054 C 22.152 6.958 20.489 5.252 18.445 5.252 L 6.765 5.252 L 6.765 4.814 C 6.765 2.31 8.618 0.25 10.992 0 L 23.07 0 C 25.445 0.25 27.297 2.31 27.297 4.814 Z"
                fill="rgb(62,203,251)"></path>
              <path
                d="M 0 23.186 L 0 11.784 C 0 9.111 2.11 6.945 4.713 6.945 L 5.145 6.945 L 5.145 18.946 C 5.145 21.042 6.808 22.748 8.852 22.748 L 20.531 22.748 L 20.531 23.186 C 20.531 25.69 18.678 27.75 16.303 28 L 4.227 28 C 1.853 27.75 0 25.69 0 23.186 Z"
                fill="rgb(41,115,255)"></path>
              <path
                d="M 20.535 9.055 L 20.535 21.055 L 8.844 21.055 C 7.691 21.053 6.756 20.094 6.753 18.91 L 6.753 6.911 L 18.444 6.911 C 18.89 6.911 19.305 7.055 19.644 7.302 C 19.665 7.318 19.686 7.333 19.708 7.349 C 20.229 7.753 20.536 8.386 20.535 9.056 Z"
                fill="rgb(86,253,185)"></path>
              <path
                d="M 39.717 24.919 C 38.664 24.919 37.68 24.784 36.768 24.521 C 35.856 24.257 35.04 23.886 34.325 23.404 C 33.61 22.926 33.018 22.391 32.552 21.798 C 32.087 21.21 31.781 20.586 31.644 19.932 L 35.636 18.709 C 35.893 19.401 36.351 19.998 37.006 20.499 C 37.662 20.999 38.485 21.259 39.479 21.278 C 40.533 21.297 41.39 21.064 42.056 20.575 C 42.723 20.085 43.054 19.454 43.054 18.678 C 43.054 18.005 42.79 17.439 42.265 16.981 C 41.74 16.522 41.017 16.17 40.105 15.925 L 37.394 15.191 C 36.381 14.927 35.487 14.526 34.712 13.983 C 33.938 13.444 33.331 12.775 32.895 11.979 C 32.459 11.184 32.24 10.259 32.24 9.2 C 32.24 7.181 32.891 5.609 34.191 4.477 C 35.491 3.346 37.334 2.78 39.717 2.78 C 41.047 2.78 42.216 2.979 43.218 3.376 C 44.22 3.774 45.061 4.34 45.735 5.074 C 46.41 5.808 46.927 6.672 47.285 7.67 L 43.322 8.924 C 43.084 8.232 42.648 7.64 42.011 7.15 C 41.375 6.661 40.57 6.416 39.598 6.416 C 38.626 6.416 37.826 6.649 37.26 7.12 C 36.693 7.59 36.411 8.251 36.411 9.108 C 36.411 9.781 36.634 10.308 37.081 10.699 C 37.528 11.085 38.139 11.383 38.913 11.586 L 41.654 12.289 C 43.442 12.737 44.83 13.543 45.825 14.702 C 46.819 15.864 47.315 17.157 47.315 18.583 C 47.315 19.845 47.016 20.95 46.421 21.898 C 45.825 22.846 44.961 23.584 43.829 24.116 C 42.697 24.643 41.326 24.911 39.717 24.911 Z M 50.854 24.55 L 50.854 3.157 L 54.935 3.157 L 54.935 24.55 Z M 53.211 7.068 L 53.211 3.157 L 57.531 3.157 L 57.531 7.068 Z M 53.211 24.55 L 53.211 20.638 L 57.531 20.638 L 57.531 24.55 L 53.211 24.55 Z M 57.531 24.55 L 57.531 20.638 C 58.484 20.638 59.367 20.466 60.182 20.118 C 60.998 19.77 61.706 19.292 62.312 18.68 C 62.92 18.069 63.389 17.35 63.728 16.524 C 64.066 15.698 64.234 14.807 64.234 13.851 C 64.234 12.895 64.066 12.001 63.728 11.178 C 63.389 10.352 62.92 9.634 62.312 9.022 C 61.706 8.41 60.998 7.932 60.182 7.584 C 59.367 7.236 58.484 7.064 57.531 7.064 L 57.531 3.153 C 59.657 3.153 61.538 3.612 63.176 4.53 C 64.815 5.447 66.096 6.705 67.02 8.303 C 67.943 9.902