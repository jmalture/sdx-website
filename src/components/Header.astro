            </svg>
          </a>
        </div>
        <div
          class="elementor-element elementor-element-5bc366d sdxm-w elementor-widget__width-auto elementor-widget elementor-widget-html"
          data-id="5bc366d"
        >
          <nav class="sdxm" aria-label="Features">
            <div class="sdxm-item">
              <a class="sdxm-t" href={t.h_features_href}>Features<span class="sdxm-n" aria-hidden="true">2</span></a
              ><button
                type="button"
                class="sdxm-c"
                aria-expanded="false"
                aria-controls="sdxm-p"
                aria-label={t.h_menu_open}
                ><svg viewbox="0 0 12 8" width="11" height="7" aria-hidden="true"
                  ><path
                    d="M1 1.5 6 6.5 11 1.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                ></button
              >
              <div class="sdxm-p" id="sdxm-p">
                <div class="sdxm-in">
                  <ul class="sdxm-grid">
                    <li>
                      <a class="sdxm-card" href={t.h_share_href} style="--c:#2A73FF;--t:#EAF1FF">
                        <span class="sdxm-ic" aria-hidden="true"
                          ><svg viewbox="0 0 24 24"
                            ><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path
                              d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg
                          ></span
                        >
                        <span class="sdxm-tx"><strong>External Share</strong><small>{t.h_share_desc}</small></span></a
                      >
                    </li>
                    <li>
                      <a class="sdxm-card" href={t.h_audits_href} style="--c:#0F1B2D;--t:#EEF1F6">
                        <span class="sdxm-ic" aria-hidden="true"
                          ><svg viewbox="0 0 24 24"
                            ><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path
                              d="M14 3v6h6M8 13h8M8 17h5"></path></svg
                          ></span
                        >
                        <span class="sdxm-tx"
                          ><strong>Audits <em>{t.h_new}</em></strong><small>{t.h_audits_desc}</small></span
                        ></a
                      >
                    </li>
                  </ul>
                  <div class="sdxm-ft">
                    <a class="sdxm-all" href={t.h_features_href}
                      >{t.h_all}
                      <svg viewbox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a
                    >
                    <span class="sdxm-soon"
                      ><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>{t.h_soon}</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </nav>
          <style is:global>
            /* header: Features mega menu (2026-10-09). To add a feature: add an <li> card here and on /features/, bump .sdxm-n */
            .elementor-widget.sdxm-w {
              width: auto;
            }
            .sdxm {
              font-family: Inter, sans-serif;
              -webkit-font-smoothing: antialiased;
            }
            .sdxm * {
              box-sizing: border-box;
            }
            .sdxm-item {
              position: relative;
              display: flex;
              align-items: center;
              gap: 2px;
            }
            .sdxm a.sdxm-t,
            .sdxm a.sdxm-t:visited {
              display: inline-flex;
              align-items: center;
              gap: 8px;
              padding: 8px 2px 8px 6px;
              font-size: 15px;
              line-height: 1.5;
              font-weight: 500;
              color: #787878;
              text-decoration: none;
              transition: color 0.2s ease;
            }
            .sdxm-n {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              min-width: 20px;
              height: 20px;
              padding: 0 6px;
              border-radius: 999px;
              background: #eaf1ff;
              color: #2a73ff;
              font-size: 11.5px;
              font-weight: 700;
              transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            .sdxm button.sdxm-c,
            .sdxm button.sdxm-c:hover,
            .sdxm button.sdxm-c:focus {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              width: 26px;
              height: 26px;
              margin: 0;
              padding: 0;
              border: 0;
              border-radius: 8px;
              background: transparent;
              color: #787878;
              cursor: pointer;
              transition:
                color 0.2s ease,
                background-color 0.2s ease;
            }
            .sdxm-c svg {
              transition: transform 0.3s ease;
            }
            .sdxm-item:hover a.sdxm-t,
            .sdxm-item.is-open a.sdxm-t,
            .sdxm a.sdxm-t:focus-visible {
              color: #2a73ff;
            }
            .sdxm-item:hover .sdxm-n,
            .sdxm-item.is-open .sdxm-n {
              transform: scale(1.15) rotate(-8deg);
            }
            .sdxm-item:hover button.sdxm-c,
            .sdxm-item.is-open button.sdxm-c {
              color: #2a73ff;
              background: #eaf1ff;
            }
            .sdxm-item:hover .sdxm-c svg,
            .sdxm-item.is-open .sdxm-c svg {
              transform: rotate(180deg);
            }
            .sdxm a:focus-visible,
            .sdxm button:focus-visible {
              outline: 2px solid #2a73ff;
              outline-offset: 2px;
              border-radius: 8px;
            }
            /* panel */
            .sdxm-p {
              position: absolute;
              z-index: 200;
              top: 100%;
              left: -28px;
              padding-top: 14px;
              visibility: hidden;
              opacity: 0;
              transform: translateY(8px) scale(0.98);
              transform-origin: 40px 0;
              transition:
                opacity 0.22s ease,
                transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s linear 0.3s;
            }
            .sdxm-item:hover .sdxm-p,
            .sdxm-item.is-open .sdxm-p,
            .sdxm-item:focus-within .sdxm-p {
              visibility: visible;
              opacity: 1;
              transform: none;
              transition:
                opacity 0.22s ease,
                transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                visibility 0s;
            }
            .sdxm-item.is-closed .sdxm-p {
              visibility: hidden;
              opacity: 0;
            }
            .sdxm-in {
              position: relative;
              width: 620px;
              padding: 12px;
              border-radius: 24px;
              background: #fff;
              box-shadow:
                0 30px 60px -20px rgba(18, 37, 92, 0.28),
                0 0 0 1px rgba(18, 37, 92, 0.06);
            }
            .sdxm-in::before {
              content: '';
              position: absolute;
              top: -6px;
              left: 56px;
              width: 14px;
              height: 14px;
              border-radius: 3px;
              background: #fff;
              transform: rotate(45deg);
              box-shadow: -1px -1px 0 rgba(18, 37, 92, 0.06);
            }
            .sdxm-grid {
              list-style: none;
              display: grid;
              grid-template-columns: repeat(2, minmax(0, 1fr));
              gap: 8px;
              margin: 0;
              padding: 0;
            }
            .sdxm-grid li {
              margin: 0;
              opacity: 0;
              transform: translateY(6px);
              transition:
                opacity 0.3s ease,
                transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
            }
            .sdxm-item:hover .sdxm-grid li,
            .sdxm-item.is-open .sdxm-grid li,
            .sdxm-item:focus-within .sdxm-grid li {
              opacity: 1;
              transform: none;
            }
            .sdxm-grid li:nth-child(2) {
              transition-delay: 0.05s;
            }
            .sdxm-grid li:nth-child(3) {
              transition-delay: 0.1s;
            }
            .sdxm-grid li:nth-child(4) {
              transition-delay: 0.15s;
            }
            .sdxm a.sdxm-card,
            .sdxm a.sdxm-card:visited {
              display: flex;
              align-items: flex-start;
              gap: 14px;
              height: 100%;
              padding: 14px;
              border-radius: 16px;
              color: #0f1b2d;
              text-decoration: none;
              transition: background-color 0.2s ease;
            }
            .sdxm a.sdxm-card:hover,
            .sdxm a.sdxm-card:focus-visible {
              background: var(--t);
              color: #0f1b2d;
            }
            .sdxm-ic {
              display: flex;
              align-items: center;
              justify-content: center;
              width: 44px;
              height: 44px;
              border-radius: 13px;
              background: var(--c);
              color: #fff;
              flex: none;
              box-shadow: 0 10px 18px -8px var(--c);
              transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            .sdxm-ic svg {
              width: 22px;
              height: 22px;
              fill: none;
              stroke: currentColor;
              stroke-width: 2;
              stroke-linecap: round;
              stroke-linejoin: round;
            }
            .sdxm-card:hover .sdxm-ic {
              transform: rotate(-10deg) scale(1.08);
            }
            .sdxm-tx {
              display: flex;
              flex-direction: column;
              gap: 4px;
              min-width: 0;
            }
            .sdxm-tx strong {
              display: flex;
              align-items: center;
              gap: 8px;
              font-size: 15.5px;
              line-height: 1.3;
              font-weight: 700;
              color: #0f1b2d;
            }
            .sdxm-tx strong em {
              padding: 2px 7px;
              border-radius: 999px;
              background: #ffbb00;
              font-style: normal;
              font-size: 10.5px;
              font-weight: 800;
              letter-spacing: 0.04em;
              text-transform: uppercase;
              color: #0f1b2d;
            }
            .sdxm-tx small {
              font-size: 13px;
              line-height: 1.45;
              color: #5b6475;
            }
            .sdxm-ft {
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 12px;
              margin-top: 8px;
              padding: 12px 14px 4px;
              border-top: 1px solid #edf1f7;
            }
            .sdxm a.sdxm-all,
            .sdxm a.sdxm-all:visited {
              display: inline-flex;
              align-items: center;
              gap: 8px;
              font-size: 14px;
              font-weight: 600;
              color: #2a73ff;
              text-decoration: none;
            }
            .sdxm-all svg {
              width: 17px;
              height: 17px;
              fill: none;
              stroke: currentColor;
              stroke-width: 2;
              stroke-linecap: round;
              stroke-linejoin: round;
              transition: transform 0.25s ease;
            }
            .sdxm a.sdxm-all:hover {
              color: #1f63eb;
            }
            .sdxm-all:hover svg {
              transform: translateX(4px);
            }
            .sdxm-soon {
              display: inline-flex;
              align-items: center;
              gap: 3px;
              font-size: 12.5px;
              font-weight: 500;
              color: #6b7487;
            }
            .sdxm-soon i {
              width: 5px;
              height: 5px;
              margin-right: 1px;
              border-radius: 50%;
              background: #f59000;
              animation: sdxmDot 1.2s ease-in-out infinite;
            }
            .sdxm-soon i:nth-child(2) {
              animation-delay: 0.15s;
            }
            .sdxm-soon i:nth-child(3) {
              animation-delay: 0.3s;
              margin-right: 7px;
            }
            @keyframes sdxmDot {
              0%,
              60%,
              100% {
                transform: none;
                opacity: 0.45;
              }
              30% {
                transform: translateY(-3px);
                opacity: 1;
              }
            }
            @media (prefers-reduced-motion: reduce) {
              .sdxm-p,
              .sdxm-grid li,
              .sdxm-ic,
              .sdxm-n {
                transition: none;
              }
              .sdxm-soon i {
                animation: none;
              }
            }
            @media (max-width: 1024px) {
              .sdxm-in {
                width: 560px;
              }
            }
            @media (max-width: 767px) {
              .elementor-widget.sdxm-w {
                display: none;
              }
            }
            /* Elementor's sticky header leaves a hidden clone (spacer); never show its panel */
            .elementor-sticky__spacer .sdxm-p {
              display: none !important;
            }
          </style>
          <script is:inline>
            (function () {
              var m = [].filter.call(document.querySelectorAll('.sdxm'), function (x) {
                return !x.closest('.elementor-sticky__spacer');
              })[0];
              if (!m || m.__sdxm) return;
              m.__sdxm = 1;
              var it = m.querySelector('.sdxm-item'),
                b = m.querySelector('.sdxm-c');
              function set(o) {
                it.classList.toggle('is-open', o);
                it.classList.toggle('is-closed', !o);
                b.setAttribute('aria-expanded', o ? 'true' : 'false');
              }
              b.addEventListener('click', function (e) {
                e.preventDefault();
                set(!it.classList.contains('is-open'));
              });
              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && (it.classList.contains('is-open') || it.contains(document.activeElement))) {
                  set(false);
                  b.focus();
                }
              });
              document.addEventListener('click', function (e) {
                if (!it.contains(e.target) && it.classList.contains('is-open')) set(false);
              });
              it.addEventListener('mouseleave', function () {
                if (it.classList.contains('is-closed')) it.classList.remove('is-closed');
              });
              it.addEventListener('mouseenter', function () {
                it.classList.remove('is-closed');
              });
            })();
          </script>
        </div>
        {
          SHOW_LANG_SWITCH && (
            <div
              class="elementor-element elementor-element-5a825a28 elementor-widget elementor-widget-wp-widget-polylang"
              data-id="5a825a28"
            >
              <div class="elementor-widget-container">
                <>
                  <label class="screen-reader-text" for="sx-lang">
                    {t.h_lang_label}
                  </label>
                  <select id="sx-lang" class="pll-switcher-select" data-lang-switch>
                    {langs.map((l) => (
                      <option value={alternates[l.code]} lang={l.locale} selected={l.code === lang}>
                        {l.name}
                      </option>
                    ))}
                  </select>
                </>
              </div>
            </div>
          )
        }
        <div
          class="elementor-element elementor-element-25016d1b elementor-align-right sdx-cta elementor-widget elementor-widget-button"
          data-id="25016d1b"
        >
          <a class="elementor-button elementor-button-link elementor-size-sm" href={t.h_cta_href}>
            <span class="elementor-button-content-wrapper">
              <span class="elementor-button-text">{t.h_cta}</span>
            </span>
          </a>
        </div>
        <div class="sx-burger-wrap">
          <button
            type="button"
            class="sx-burger"
            aria-label={t.h_burger}
            data-label-open={t.h_burger}
            data-label-close={t.h_menu_close}
            aria-expanded="false"
            aria-controls="sx-mnav"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>
<!-- Phones: side menu opened by the burger button (site.ts initMobileMenu). Desktop uses the mega menu. -->
<!-- hidden until its CSS applies (prevents a flash of the unstyled menu while styles load) -->
<div class="sx-side" id="sx-mnav" hidden inert>
  <div class="sx-side-bg" data-close></div>
  <nav class="sx-side-panel" aria-label={t.h_burger}>
    <div class="sx-side-top">
      <a href={t.h_home_href} class="sx-side-logo" aria-label="SDX"
        ><svg height="26" width="83" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 89 28" aria-hidden="true">
          <path
            d="M 27.297 4.814 L 27.297 16.216 C 27.297 18.889 25.187 21.055 22.584 21.055 L 22.152 21.055 L 22.152 9.054 C 22.152 6.958 20.489 5.252 18.445 5.252 L 6.765 5.252 L 6.765 4.814 C 6.765 2.31 8.618 0.25 10.992 0 L 23.07 0 C 25.445 0.25 27.297 2.31 27.297 4.814 Z"
            fill="rgb(62,203,251)"></path>
          <path
            d="M 0 23.186 L 0 11.784 C 0 9.111 2.11 6.945 4.713 6.945 L 5.145 6.945 L 5.145 18.946 C 5.145 21.042 6.808 22.748 8.852 22.748 L 20.531 22.748 L 20.531 23.186 C 20.531 25.69 18.678 27.75 16.303 28 L 4.227 28 C 1.853 27.75 0 25.69 0 23.186 Z"
            fill="rgb(41,115,255)"></path>
          <path
