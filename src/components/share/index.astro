---
/** All sections of the share page, in order. To reorder or remove a section, edit the list below. */
import type { Lang } from '../../i18n';
import Hero from './01-hero.astro';
import Comparison from './02-comparison.astro';
import Steps from './03-steps.astro';
import SharePage from './04-share-page.astro';
import CustomLayouts from './05-custom-layouts.astro';
import Benefits from './06-benefits.astro';
import UseCases from './07-use-cases.astro';
import WebsiteSync from './08-website-sync.astro';
import Features from './09-features.astro';
import Visibility from './10-visibility.astro';
import Notifications from './11-notifications.astro';
import Security from './12-security.astro';
import Faq from './13-faq.astro';
import Cta from './14-cta.astro';
const { lang } = Astro.props as { lang: Lang };
---

<div class="elementor elementor-610">
  <Hero lang={lang} />
  <Comparison lang={lang} />
  <Steps lang={lang} />
  <SharePage lang={lang} />
  <CustomLayouts lang={lang} />
  <Benefits lang={lang} />
  <UseCases lang={lang} />
  <WebsiteSync lang={lang} />
  <Features lang={lang} />
  <Visibility lang={lang} />
  <Notifications lang={lang} />
  <Security lang={lang} />
  <Faq lang={lang} />
  <Cta lang={lang} />
</div>
