<div class="elementor-element elementor-element-sxf10 e-con-full e-flex e-con e-parent" data-id="sxf10">
<div class="elementor-element elementor-element-sxf10w elementor-widget elementor-widget-html" data-id="sxf10w">
<style is:global>
/* FAQ (same component as the homepage FAQ: category chips + load more) */
.sdxq{padding:120px 32px 128px;background:#fff;}
.sdxq-head{max-width:760px;margin:0 auto;text-align:center;}
.sdxq-head .sxf-lead a{color:#2A73FF;font-weight:600;text-decoration:none;border-bottom:1.5px solid rgba(42,115,255,.35);}
.sdxq-head .sxf-lead a:hover{border-bottom-color:#2A73FF;}
.sdxq-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:32px auto 0;max-width:760px;}
.sdxq-chips button{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:999px;background:#fff;border:1px solid #E3E8F0;font:600 14px/1.2 Inter,sans-serif;color:#0F1B2D;cursor:pointer;box-shadow:0 4px 12px rgba(18,37,92,.06);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease,background .2s ease,color .2s ease;}
.sdxq-chips button i{width:12px;height:12px;border-radius:4px;flex:none;}
.sdxq-chips button:hover{transform:translateY(-2px);border-color:#2A73FF;box-shadow:0 8px 18px rgba(42,115,255,.18);}
.sdxq-chips button:focus-visible{outline:2px solid #2A73FF;outline-offset:2px;}
.sdxq-chips button[aria-pressed="true"]{background:#2A73FF;border-color:#2A73FF;color:#fff;box-shadow:0 8px 18px rgba(42,115,255,.28);}
.sdxq-chips button[aria-pressed="true"] i{box-shadow:0 0 0 2px #fff;}
.sdxq-list{list-style:none;max-width:820px;margin:36px auto 0;padding:0;display:flex;flex-direction:column;gap:12px;}
.sdxq-item{margin:0;border-radius:18px;background:#F3F7FF;border:1px solid transparent;transition:background .25s ease,border-color .25s ease,box-shadow .25s ease;}
.sdxq-item[hidden]{display:none;}
.sdxq-item:hover{background:#E6EFFF;}
.sdxq-item.is-open{background:#fff;border-color:#E3E8F0;box-shadow:0 14px 34px rgba(18,37,92,.10);}
.sdxq-item h3{margin:0;font-size:inherit;line-height:inherit;}
.sdxq-q{display:flex;align-items:center;gap:16px;width:100%;margin:0;padding:20px 20px 20px 26px;border:0;background:none;border-radius:18px;text-align:left;cursor:pointer;font:600 18px/1.35 Inter,sans-serif;letter-spacing:-.01em;color:#0F1B2D;}
.sdxq-q:focus-visible{outline:2px solid #2A73FF;outline-offset:2px;}
.sdxq-q span{flex:1;min-width:0;white-space:normal;}
.sdxq-ic{position:relative;flex:none;width:34px;height:34px;border-radius:50%;background:#fff;box-shadow:0 4px 12px rgba(18,37,92,.08);transition:background .25s ease,transform .3s ease;}
.sdxq-ic::before,.sdxq-ic::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:2px;margin:-1px 0 0 -6px;border-radius:2px;background:#2A73FF;transition:background .25s ease;}
.sdxq-ic::after{transform:rotate(90deg);}
.sdxq-item.is-open .sdxq-ic{background:#2A73FF;transform:rotate(45deg);}
.sdxq-item.is-open .sdxq-ic::before,.sdxq-item.is-open .sdxq-ic::after{background:#fff;}
.sdxq-a{display:grid;grid-template-rows:0fr;visibility:hidden;transition:grid-template-rows .35s ease,visibility 0s linear .35s;}
.sdxq-item.is-open .sdxq-a{grid-template-rows:1fr;visibility:visible;transition:grid-template-rows .35s ease,visibility 0s;}
.sdxq-a > div{overflow:hidden;}
.sdxq-a p{margin:0;padding:0 76px 24px 26px;font-size:16px;line-height:1.6;color:#4A5568;}
/* question-mark folders */
.sdxq .sxf-fold::after{inset:21%;}
.sdxq .sxf-fold::before{content:"?";position:absolute;z-index:1;left:0;right:0;top:40%;text-align:center;font:800 calc(var(--s)*.3)/1 Inter,sans-serif;color:var(--c);}
.sdxq .q4{opacity:.55;filter:blur(1px);}
@media (max-width:1340px){.sdxq .q1{left:3% !important;--s:52px !important;} .sdxq .q2{right:3% !important;--s:44px !important;} .sdxq .q3{right:4% !important;--s:46px !important;} .sdxq .q4{display:none;}}
@media (max-width:1180px){.sdxq .q3{display:none;}}
@media (max-width:1024px){.sdxq{padding:104px 24px;} .sdxq .q1{left:4% !important;top:24px !important;--s:40px !important;} .sdxq .q2{right:4% !important;top:30px !important;--s:34px !important;}}
@media (max-width:767px){.sdxq{padding:84px 18px;} .sdxq-chips{gap:8px;margin-top:26px;} .sdxq-chips button{padding:8px 13px;font-size:13px;} .sdxq-list{margin-top:28px;gap:10px;} .sdxq-q{padding:16px 14px 16px 18px;font-size:16px;gap:12px;} .sdxq-ic{width:30px;height:30px;} .sdxq-a p{padding:0 18px 18px;font-size:15px;} .sdxq .q1{top:18px !important;--s:36px !important;} .sdxq .q2{top:24px !important;--s:30px !important;}}
/* neutralise theme button hover/focus (pink) */
.sdxq-q:hover,.sdxq-q:focus,.sdxq-q:active{background:transparent !important;color:#0F1B2D !important;}
.sdxq-chips button:hover,.sdxq-chips button:focus,.sdxq-chips button:active{background:#fff !important;color:#0F1B2D !important;}
.sdxq-chips button[aria-pressed="true"],.sdxq-chips button[aria-pressed="true"]:hover,.sdxq-chips button[aria-pressed="true"]:focus{background:#2A73FF !important;color:#fff !important;}
/* load more */
.sdxq-more-wrap{text-align:center;margin-top:24px;padding-bottom:6px;}
.sdxq-more-wrap[hidden]{display:none;}
.sdxq-more{display:inline-flex;align-items:center;gap:10px;padding:13px 24px;border-radius:16px;background:#fff !important;border:1px solid #D8E1EE !important;color:#0F1B2D !important;font:600 15px/1.3 Inter,sans-serif;cursor:pointer;box-shadow:none;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease;}
.sdxq-more:hover,.sdxq-more:focus{background:#fff !important;color:#0F1B2D !important;border-color:#2A73FF !important;transform:translateY(-2px);box-shadow:0 10px 20px rgba(18,37,92,.10);}
.sdxq-more em{color:#2A73FF;}
.sdxq-more em[hidden]{display:none;}
.sdxq-more::after{border-color:#2A73FF !important;transition:transform .3s ease;}
.sdxq-more.is-less::after{transform:rotate(-135deg);margin-top:4px;}
.sdxq-more:focus-visible{outline:2px solid #2A73FF;outline-offset:2px;}
.sdxq-more em{font-style:normal;min-width:24px;padding:3px 8px;border-radius:999px;background:#EEF4FF;font-size:13px;}
.sdxq-more::after{content:"";width:7px;height:7px;margin:-3px 2px 0 2px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);}
.sdxq-item.sdxq-new{animation:sdxqIn .45s ease both;}
@keyframes sdxqIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
@media (max-width:767px){.sdxq-more-wrap{margin-top:20px;} .sdxq-more{font-size:14px;padding:12px 18px;}}
</style>
