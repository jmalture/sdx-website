---
import { dict } from '../../i18n';
import data from '../../i18n/share.json';
const { lang } = Astro.props;
const t = dict(data, lang);
---
<div class="elementor-element elementor-element-sxf02 e-con-full e-flex e-con e-parent" data-id="sxf02">
<div class="elementor-element elementor-element-sxf02w elementor-widget elementor-widget-html" data-id="sxf02w">
<style is:global>
/* 2 compare slider */
.sxf-cmp{padding:128px 32px 120px;background:#fff;}
.sxf-cmpbox{--pos:50%;position:relative;max-width:1100px;height:500px;margin:60px auto 0;border-radius:28px;overflow:hidden;box-shadow:0 30px 70px -28px rgba(18,37,92,.30),0 0 0 1px rgba(18,37,92,.07);user-select:none;-webkit-user-select:none;touch-action:pan-y;cursor:ew-resize;}
.sxf-cmp-pane{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:64px 40px 40px;}
.sxf-cmp-old{background:#EEF0F3;}
.sxf-cmp-new{background:linear-gradient(135deg,#E3EDFF 0%,#F4F8FF 100%);clip-path:inset(0 0 0 var(--pos));}
.sxf-cmp-tag{position:absolute;top:22px;display:inline-flex;align-items:center;gap:8px;padding:7px 14px 7px 8px;border-radius:999px;font-size:13px;font-weight:600;white-space:nowrap;}
.sxf-cmp-tag b{display:flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;color:#fff;}
.sxf-cmp-tag b svg{width:13px;height:13px;stroke-width:2.6;}
.sxf-cmp-old .sxf-cmp-tag{left:24px;background:#fff;color:#5B6475;box-shadow:0 4px 12px rgba(15,27,45,.08);} .sxf-cmp-old .sxf-cmp-tag b{background:#8A94A6;}
.sxf-cmp-new .sxf-cmp-tag{right:24px;background:#2A73FF;color:#fff;box-shadow:0 8px 18px rgba(42,115,255,.35);} .sxf-cmp-new .sxf-cmp-tag b{background:#fff;color:#2A73FF;}
.sxf-mst{display:grid;width:min(660px,100%);}
.sxf-mst>.sxf-mail{grid-area:1/1;}
.sxf-mst>.ghost{visibility:hidden;}
.sxf-mail{width:100%;border-radius:18px;background:#fff;box-shadow:0 18px 40px -14px rgba(15,27,45,.22),0 0 0 1px rgba(15,27,45,.05);padding:22px 26px 22px;font-size:14px;line-height:1.55;color:#4A5568;}
.sxf-mail .m-s{margin:0 0 4px;font-size:17px;font-weight:700;line-height:1.35;color:#0F1B2D;}
.sxf-mail .m-meta{display:flex;flex-wrap:wrap;gap:4px 14px;margin:0 0 14px;padding-bottom:14px;border-bottom:1px solid #EEF1F6;font-size:12.5px;color:#8A94A6;}
.sxf-mail .m-meta b{font-weight:600;color:#5B6475;}
.sxf-mail .m-b{margin:0 0 16px;}
.sxf-att{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px;}
.sxf-att span{display:inline-flex;align-items:center;gap:7px;max-width:100%;padding:7px 11px;border-radius:10px;background:#F4F5F7;border:1px solid #E6E8EC;font-size:12.5px;font-weight:500;color:#3D4555;}
.sxf-att span svg{width:14px;height:14px;color:#8A94A6;}
.sxf-att span em{font-style:normal;color:#8A94A6;font-weight:500;}
.sxf-att span.bad{background:#FFF1F1;border-color:#FFC9C9;color:#B42318;} .sxf-att span.bad svg,.sxf-att span.bad em{color:#D92D20;}
.sxf-att span u{text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sxf-flags{display:flex;flex-wrap:wrap;gap:8px;}
.sxf-flags span{display:inline-flex;align-items:center;gap:6px;padding:5px 11px 5px 7px;border-radius:999px;font-size:12.5px;font-weight:600;}
.sxf-flags span b{display:flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;color:#fff;}
.sxf-flags span b svg{width:11px;height:11px;stroke-width:3;}
.sxf-flags.no span{background:#FFF1F1;color:#B42318;} .sxf-flags.no span b{background:#F04438;}
.sxf-flags.ok span{background:#E9F8EF;color:#13703A;} .sxf-flags.ok span b{background:#22C55E;}
.sxf-card{display:flex;align-items:center;gap:16px;margin:0 0 16px;padding:12px;border-radius:14px;background:#F5F8FF;border:1px solid #DCE6FA;}
.sxf-card .c-img{flex:none;width:92px;height:62px;border-radius:10px;background-size:cover;background-position:70% 30%;}
.sxf-card .c-t{flex:1;min-width:0;}
.sxf-card .c-t strong{display:block;font-size:14.5px;font-weight:700;color:#0F1B2D;line-height:1.35;}
.sxf-card .c-t small{display:flex;align-items:center;gap:6px;margin-top:3px;font-size:12.5px;color:#6B7487;}
.sxf-card .c-t small svg{width:13px;height:13px;color:#2A73FF;}
.sxf-card .c-btn{flex:none;padding:9px 16px;border-radius:12px;background:#2A73FF;color:#fff;font-size:13px;font-weight:600;white-space:nowrap;}
.sxf-cmp-line{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;margin-left:-1px;background:#fff;box-shadow:0 0 0 1px rgba(18,37,92,.06),0 0 18px rgba(18,37,92,.18);z-index:4;pointer-events:none;}
.sxf-cmp-knob{position:absolute;top:50%;left:var(--pos);z-index:5;width:54px;height:54px;margin:-27px 0 0 -27px;border-radius:50%;background:#fff;color:#2A73FF;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 26px rgba(18,37,92,.25),0 0 0 6px rgba(255,255,255,.45);pointer-events:none;transition:transform .2s ease;}
.sxf-cmp-knob svg{width:26px;height:26px;stroke-width:2.4;}
.sxf-cmpbox.is-drag .sxf-cmp-knob{transform:scale(1.08);}
.sxf-cmpbox.is-anim{transition:none;}
.sxf-cmpbox:focus-within .sxf-cmp-knob{box-shadow:0 10px 26px rgba(18,37,92,.25),0 0 0 4px #2A73FF;}
.sxf-cmp-hint{margin:18px 0 0;text-align:center;font-size:14px;color:#8A94A6;}
@media (max-width:1024px){.sxf-cmp{padding:104px 24px 96px;} .sxf-cmpbox{height:520px;margin-top:48px;} .sxf-cmp-pane{padding:72px 28px 32px;}}
@media (max-width:767px){
 .sxf-cmp{padding:84px 18px 76px;}
 .sxf-cmpbox{height:620px;border-radius:20px;margin-top:40px;}
 .sxf-cmp-pane{padding:66px 14px 18px;align-items:flex-start;}
 .sxf-cmp-tag{top:16px;font-size:12px;padding:6px 11px 6px 6px;} .sxf-cmp-old .sxf-cmp-tag{left:14px;} .sxf-cmp-new .sxf-cmp-tag{right:14px;}
 .sxf-mail{padding:16px 16px;font-size:13.5px;border-radius:14px;}
 .sxf-mail .m-s{font-size:15.5px;}
 .sxf-card{flex-wrap:wrap;gap:12px;} .sxf-card .c-img{width:72px;height:50px;} .sxf-card .c-btn{width:100%;text-align:center;}
 .sxf-cmp-knob{width:46px;height:46px;margin:-23px 0 0 -23px;}
}
</style>
