---
/**
 * Section "comparison": Ein Link statt zehn Anhängen.
 * Texts: src/i18n/share.json, keys starting with "comparison_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/share.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-sxf02 e-con-full e-flex e-con e-parent" data-id="sxf02">
  <div class="elementor-element elementor-element-sxf02w elementor-widget elementor-widget-html" data-id="sxf02w">
    <style is:global>
      /* 2 compare slider */
      .sxf-cmp {
        padding: 128px 32px 120px;
        background: #fff;
      }
      .sxf-cmpbox {
        --pos: 50%;
        position: relative;
        max-width: 1100px;
        height: 500px;
        margin: 60px auto 0;
        border-radius: 28px;
        overflow: hidden;
        box-shadow:
          0 30px 70px -28px rgba(18, 37, 92, 0.3),
          0 0 0 1px rgba(18, 37, 92, 0.07);
        user-select: none;
        -webkit-user-select: none;
        touch-action: pan-y;
        cursor: ew-resize;
      }
      .sxf-cmp-pane {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 64px 40px 40px;
      }
      .sxf-cmp-old {
        background: #eef0f3;
      }
      .sxf-cmp-new {
        background: linear-gradient(135deg, #e3edff 0%, #f4f8ff 100%);
        clip-path: inset(0 0 0 var(--pos));
      }
      .sxf-cmp-tag {
        position: absolute;
        top: 22px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px 7px 8px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }
      .sxf-cmp-tag b {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        color: #fff;
      }
      .sxf-cmp-tag b svg {
        width: 13px;
        height: 13px;
        stroke-width: 2.6;
      }
      .sxf-cmp-old .sxf-cmp-tag {
        left: 24px;
        background: #fff;
        color: #5b6475;
        box-shadow: 0 4px 12px rgba(15, 27, 45, 0.08);
      }
      .sxf-cmp-old .sxf-cmp-tag b {
        background: #8a94a6;
      }
      .sxf-cmp-new .sxf-cmp-tag {
        right: 24px;
        background: #2a73ff;
        color: #fff;
        box-shadow: 0 8px 18px rgba(42, 115, 255, 0.35);
      }
      .sxf-cmp-new .sxf-cmp-tag b {
        background: #fff;
        color: #2a73ff;
      }
      .sxf-mst {
        display: grid;
        width: min(660px, 100%);
      }
      .sxf-mst > .sxf-mail {
        grid-area: 1/1;
      }
      .sxf-mst > .ghost {
        visibility: hidden;
      }
      .sxf-mail {
        width: 100%;
        border-radius: 18px;
        background: #fff;
        box-shadow:
          0 18px 40px -14px rgba(15, 27, 45, 0.22),
          0 0 0 1px rgba(15, 27, 45, 0.05);
        padding: 22px 26px 22px;
        font-size: 14px;
        line-height: 1.55;
        color: #4a5568;
      }
      .sxf-mail .m-s {
        margin: 0 0 4px;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
        color: #0f1b2d;
      }
      .sxf-mail .m-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        margin: 0 0 14px;
        padding-bottom: 14px;
        border-bottom: 1px solid #eef1f6;
        font-size: 12.5px;
        color: #8a94a6;
      }
      .sxf-mail .m-meta b {
        font-weight: 600;
        color: #5b6475;
      }
      .sxf-mail .m-b {
        margin: 0 0 16px;
      }
      .sxf-att {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 16px;
      }
      .sxf-att span {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        max-width: 100%;
        padding: 7px 11px;
        border-radius: 10px;
        background: #f4f5f7;
        border: 1px solid #e6e8ec;
        font-size: 12.5px;
        font-weight: 500;
        color: #3d4555;
      }
      .sxf-att span svg {
        width: 14px;
        height: 14px;
        color: #8a94a6;
      }
      .sxf-att span em {
        font-style: normal;
        color: #8a94a6;
        font-weight: 500;
      }
      .sxf-att span.bad {
        background: #fff1f1;
        border-color: #ffc9c9;
        color: #b42318;
      }
      .sxf-att span.bad svg,
      .sxf-att span.bad em {
        color: #d92d20;
      }
      .sxf-att span u {
        text-decoration: none;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .sxf-flags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .sxf-flags span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px 5px 7px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
      }
      .sxf-flags span b {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        color: #fff;
      }
      .sxf-flags span b svg {
        width: 11px;
        height: 11px;
        stroke-width: 3;
      }
      .sxf-flags.no span {
        background: #fff1f1;
        color: #b42318;
      }
      .sxf-flags.no span b {
        background: #f04438;
      }
      .sxf-flags.ok span {
        background: #e9f8ef;
        color: #13703a;
      }
      .sxf-flags.ok span b {
        background: #22c55e;
      }
      .sxf-card {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 0 0 16px;
        padding: 12px;
        border-radius: 14px;
        background: #f5f8ff;
        border: 1px solid #dce6fa;
      }
      .sxf-card .c-img {
        flex: none;
        width: 92px;
        height: 62px;
        border-radius: 10px;
        background-size: cover;
        background-position: 70% 30%;
      }
      .sxf-card .c-t {
        flex: 1;
        min-width: 0;
      }
      .sxf-card .c-t strong {
        display: block;
        font-size: 14.5px;
        font-weight: 700;
        color: #0f1b2d;
        line-height: 1.35;
      }
      .sxf-card .c-t small {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 3px;
        font-size: 12.5px;
        color: #6b7487;
      }
      .sxf-card .c-t small svg {
        width: 13px;
        height: 13px;
        color: #2a73ff;
      }
      .sxf-card .c-btn {
        flex: none;
        padding: 9px 16px;
        border-radius: 12px;
        background: #2a73ff;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }
      .sxf-cmp-line {
        position: absolute;
        top: 0;
        bottom: 0;
        left: var(--pos);
        width: 2px;
        margin-left: -1px;
        background: #fff;
        box-shadow:
          0 0 0 1px rgba(18, 37, 92, 0.06),
          0 0 18px rgba(18, 37, 92, 0.18);
        z-index: 4;
        pointer-events: none;
      }
      .sxf-cmp-knob {
        position: absolute;
        top: 50%;
        left: var(--pos);
        z-index: 5;
        width: 54px;
        height: 54px;
        margin: -27px 0 0 -27px;
        border-radius: 50%;
        background: #fff;
        color: #2a73ff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
          0 10px 26px rgba(18, 37, 92, 0.25),
          0 0 0 6px rgba(255, 255, 255, 0.45);
        pointer-events: none;
        transition: transform 0.2s ease;
      }
      .sxf-cmp-knob svg {
        width: 26px;
        height: 26px;
        stroke-width: 2.4;
      }
      .sxf-cmpbox.is-drag .sxf-cmp-knob {
        transform: scale(1.08);
      }
      .sxf-cmpbox.is-anim {
        transition: none;
      }
      .sxf-cmpbox:focus-within .sxf-cmp-knob {
        box-shadow:
          0 10px 26px rgba(18, 37, 92, 0.25),
          0 0 0 4px #2a73ff;
      }
      .sxf-cmp-hint {
        margin: 18px 0 0;
        text-align: center;
        font-size: 14px;
        color: #8a94a6;
      }
      @media (max-width: 1024px) {
        .sxf-cmp {
          padding: 104px 24px 96px;
        }
        .sxf-cmpbox {
          height: 520px;
          margin-top: 48px;
        }
        .sxf-cmp-pane {
          padding: 72px 28px 32px;
        }
      }
      @media (max-width: 767px) {
        .sxf-cmp {
          padding: 84px 18px 76px;
        }
        .sxf-cmpbox {
          height: 620px;
          border-radius: 20px;
          margin-top: 40px;
        }
        .sxf-cmp-pane {
          padding: 66px 14px 18px;
          align-items: flex-start;
        }
        .sxf-cmp-tag {
          top: 16px;
          font-size: 12px;
          padding: 6px 11px 6px 6px;
        }
        .sxf-cmp-old .sxf-cmp-tag {
          left: 14px;
        }
        .sxf-cmp-new .sxf-cmp-tag {
          right: 14px;
        }
        .sxf-mail {
          padding: 16px 16px;
          font-size: 13.5px;
          border-radius: 14px;
        }
        .sxf-mail .m-s {
          font-size: 15.5px;
        }
        .sxf-card {
          flex-wrap: wrap;
          gap: 12px;
        }
        .sxf-card .c-img {
          width: 72px;
          height: 50px;
        }
        .sxf-card .c-btn {
          width: 100%;
          text-align: center;
        }
        .sxf-cmp-knob {
          width: 46px;
          height: 46px;
          margin: -23px 0 0 -23px;
        }
      }
    </style>
    <section class="sxf sxf-cmp" id="vergleich" aria-labelledby="sxf-h-cmp">
      <div class="sxf-wrap">
        <div class="sxf-head" data-rv>
          <p class="sxf-eyebrow">{t.comparison_the_difference}</p>
          <h2 class="sxf-h" id="sxf-h-cmp">
            {t.comparison_one_link_instead_of}
            <span class="sxf-blue">{t.comparison_ten_attachments}</span>
          </h2>
          <p class="sxf-lead">{t.comparison_attachments_end_up_in}</p>
        </div>
        <div class="sxf-cmpbox" data-rv>
          <div class="sxf-cmp-pane sxf-cmp-old" aria-label={t.comparison_aria_label_before_as_an}>
            <span class="sxf-cmp-tag"
              ><b
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><path d="m21 11-8.5 8.5a5 5 0 0 1-7-7L14 4a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 7"
                  ></path></svg
                ></b
              >{t.comparison_as_an_email_attachment}</span
            >
            <div class="sxf-mst">
              <div class="sxf-mail">
                <p class="m-s">{t.comparison_re_re_fw_project}</p>
                <p class="m-meta">
                  <span><b>{t.comparison_from}</b> {t.comparison_project_team}</span><span
                    ><b>{t.comparison_to}</b> {t.comparison_partner_lawfirm_example_com}</span
                  >
                </p>
                <p class="m-b">{t.comparison_hi_ms_miller_here}</p>
                <div class="sxf-att">
                  <span class="bad"
                    ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                      ><path d="M12 9v4M12 17h.01"></path><path
                        d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg
                    ><u>{t.comparison_project_documents_q4_final}</u><em>48 MB</em></span
                  ><span
                    ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                      ><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"
                      ></path></svg
                    ><u>{t.comparison_contract_v2_new_pdf}</u><em>{t.comparison_3_1_mb}</em></span
                  ><span
                    ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                      ><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"
                      ></path></svg
                    ><u>{t.comparison_contract_v2_new_corr}</u><em>{t.comparison_3_2_mb}</em></span
                  >
                </div>
                <div class="sxf-flags no">
                  <span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_cant_be_recalled}</span
                  ><span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_no_expiry_date}</span
                  ><span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_which_version_is_current}</span
                  ><span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_who_forwarded_it}</span
                  >
                </div>
              </div>
              <div class="sxf-mail ghost" aria-hidden="true">
                <p class="m-s">{t.comparison_project_documents_q4_team}</p>
                <p class="m-meta">
                  <span><b>{t.comparison_from}</b> {t.comparison_project_team_via_sdx}</span><span
                    ><b>{t.comparison_to}</b> {t.comparison_partner_lawfirm_example_com_2}</span
                  >
                </p>
                <p class="m-b">{t.comparison_hi_ms_miller_here_2}</p>
                <div class="sxf-card">
                  <span class="c-img" style="background-image:url('/media/sxf-hero-share-page.webp')" aria-hidden="true"
                  ></span><span class="c-t"
                    ><strong>{t.comparison_project_documents_q4_team}</strong><small
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                        ><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"
                        ></path></svg
                      >{t.comparison_password_protected_folder_stays}</small
                    ></span
                  ><span class="c-btn">{t.comparison_open_share}</span>
                </div>
                <div class="sxf-flags ok">
                  <span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_end_at_any_time}</span
                  ><span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_expires_in_14_days}</span
                  ><span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_always_the_latest_version}</span
                  ><span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_uploads_go_straight_to}</span
                  >
                </div>
              </div>
            </div>
          </div>
          <div class="sxf-cmp-pane sxf-cmp-new" aria-label={t.comparison_aria_label_after_with_external}>
            <span class="sxf-cmp-tag"
              ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b>{
                t.comparison_with_external_share
              }</span
            >
            <div class="sxf-mst">
              <div class="sxf-mail">
                <p class="m-s">{t.comparison_project_documents_q4_team}</p>
                <p class="m-meta">
                  <span><b>{t.comparison_from}</b> {t.comparison_project_team_via_sdx}</span><span
                    ><b>{t.comparison_to}</b> {t.comparison_partner_lawfirm_example_com_2}</span
                  >
                </p>
                <p class="m-b">{t.comparison_hi_ms_miller_here_2}</p>
                <div class="sxf-card">
                  <span class="c-img" style="background-image:url('/media/sxf-hero-share-page.webp')" aria-hidden="true"
                  ></span><span class="c-t"
                    ><strong>{t.comparison_project_documents_q4_team}</strong><small
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                        ><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"
                        ></path></svg
                      >{t.comparison_password_protected_folder_stays}</small
                    ></span
                  ><span class="c-btn">{t.comparison_open_share}</span>
                </div>
                <div class="sxf-flags ok">
                  <span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_end_at_any_time}</span
                  ><span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_expires_in_14_days}</span
                  ><span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_always_the_latest_version}</span
                  ><span
                    ><b><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg></b
                    >{t.comparison_uploads_go_straight_to}</span
                  >
                </div>
              </div>
              <div class="sxf-mail ghost" aria-hidden="true">
                <p class="m-s">{t.comparison_re_re_fw_project}</p>
                <p class="m-meta">
                  <span><b>{t.comparison_from}</b> {t.comparison_project_team}</span><span
                    ><b>{t.comparison_to}</b> {t.comparison_partner_lawfirm_example_com}</span
                  >
                </p>
                <p class="m-b">{t.comparison_hi_ms_miller_here}</p>
                <div class="sxf-att">
                  <span class="bad"
                    ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                      ><path d="M12 9v4M12 17h.01"></path><path
                        d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path></svg
                    ><u>{t.comparison_project_documents_q4_final}</u><em>48 MB</em></span
                  ><span
                    ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                      ><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"
                      ></path></svg
                    ><u>{t.comparison_contract_v2_new_pdf}</u><em>{t.comparison_3_1_mb}</em></span
                  ><span
                    ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                      ><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6"
                      ></path></svg
                    ><u>{t.comparison_contract_v2_new_corr}</u><em>{t.comparison_3_2_mb}</em></span
                  >
                </div>
                <div class="sxf-flags no">
                  <span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_cant_be_recalled}</span
                  ><span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_no_expiry_date}</span
                  ><span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_which_version_is_current}</span
                  ><span
                    ><b
                      ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg
                      ></b
                    >{t.comparison_who_forwarded_it}</span
                  >
                </div>
              </div>
            </div>
          </div>
          <span class="sxf-cmp-line" aria-hidden="true"></span>
          <span class="sxf-cmp-knob" aria-hidden="true"
            ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"><path d="M8 7 4 12l4 5M16 7l4 5-4 5"></path></svg
            ></span
          >
          <input
            class="sxf-cmp-range sxf-sr"
            type="range"
            min="0"
            max="100"
            value="50"
            aria-label={t.comparison_aria_label_comparison_email_attachment}
          />
        </div>
        <p class="sxf-cmp-hint" data-rv>{t.comparison_drag_the_slider_to}</p>
      </div>
    </section>
    <script
      define:vars={{
        T: {
          moreEmailAttachment: t.comparison_js_more_email_attachment,
          moreExternalShare: t.comparison_js_more_external_share,
          halfAndHalf: t.comparison_js_half_and_half,
        },
      }}
    >
      (function () {
        function init(b) {
          if (b.__sxf) return;
          b.__sxf = 1;
          var r = b.querySelector('.sxf-cmp-range'),
            drag = 0;
          function set(p) {
            p = Math.max(2, Math.min(98, p));
            b.style.setProperty('--pos', p + '%');
            r.value = Math.round(p);
            r.setAttribute(
              'aria-valuetext',
              p < 35 ? T.moreEmailAttachment : p > 65 ? T.moreExternalShare : T.halfAndHalf,
            );
          }
          function fx(x) {
            var c = b.getBoundingClientRect();
            set(((x - c.left) / c.width) * 100);
          }
          b.addEventListener('pointerdown', function (e) {
            if (e.button > 0) return;
            drag = 1;
            b.classList.add('is-drag');
            try {
              b.setPointerCapture(e.pointerId);
            } catch (_) {}
            fx(e.clientX);
          });
          b.addEventListener('pointermove', function (e) {
            if (drag) fx(e.clientX);
          });
          ['pointerup', 'pointercancel', 'lostpointercapture'].forEach(function (t) {
            b.addEventListener(t, function () {
              drag = 0;
              b.classList.remove('is-drag');
            });
          });
          r.addEventListener('input', function () {
            set(+r.value);
          });
          var rm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!rm && 'IntersectionObserver' in window) {
            var io = new IntersectionObserver(
              function (es) {
                if (!es[0].isIntersecting) return;
                io.disconnect();
                var t0 = null,
                  seq = [
                    [50, 0],
                    [30, 700],
                    [70, 1700],
                    [50, 2500],
                  ];
                function step(ts) {
                  if (drag) return;
                  if (!t0) t0 = ts;
                  var t = ts - t0,
                    i = 1;
                  while (i < seq.length && t > seq[i][1]) i++;
                  if (i >= seq.length) {
                    set(50);
                    return;
                  }
                  var a = seq[i - 1],
                    z = seq[i],
                    k = (t - a[1]) / (z[1] - a[1]);
                  k = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
                  set(a[0] + (z[0] - a[0]) * k);
                  requestAnimationFrame(step);
                }
                setTimeout(function () {
                  requestAnimationFrame(step);
                }, 500);
              },
              { threshold: 0.55 },
            );
            io.observe(b);
          }
        }
        function go() {
          document.querySelectorAll('.sxf-cmpbox').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
