---
/**
 * Section "share_page": Ihre Freigabeseite. In Ihrem Look.
 * Texts: src/i18n/share.json, keys starting with "share_page_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/share.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-sxf04 e-con-full e-flex e-con e-parent" data-id="sxf04">
  <div class="elementor-element elementor-element-sxf04w elementor-widget elementor-widget-html" data-id="sxf04w">
    <style is:global>
      /* 4 recipient view hotspots */
      .sxf-rcv {
        padding: 128px 32px;
        background: #fff;
      }
      .sxf-rcv .sxf-glow {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(40% 50% at 18% 40%, rgba(255, 166, 0, 0.16), transparent 70%),
          radial-gradient(30% 40% at 92% 90%, rgba(42, 115, 255, 0.1), transparent 70%);
      }
      .sxf-rcv .sxf-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
        grid-template-areas: 'vis head' 'vis list';
        column-gap: 80px;
        row-gap: 0;
        align-items: center;
      }
      .sxf-rcv .sxf-rhead {
        grid-area: head;
        align-self: end;
      }
      .sxf-rcv .sxf-hs {
        grid-area: vis;
      }
      .sxf-rcv .sxf-hl {
        grid-area: list;
        align-self: start;
      }
      .sxf-hs {
        position: relative;
        max-width: 640px;
        margin: 0 auto;
        width: 100%;
      }
      .sxf-hs-img {
        position: relative;
        border-radius: 22px;
        overflow: hidden;
        box-shadow:
          0 36px 80px -26px rgba(60, 30, 10, 0.45),
          0 0 0 1px rgba(15, 27, 45, 0.06);
        aspect-ratio: 640/512;
        background: #5a4a40;
      }
      .sxf-hs-img img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .sxf .sxf-dot {
        position: absolute;
        z-index: 3;
        width: 30px;
        height: 30px;
        margin: -15px 0 0 -15px;
        border-radius: 50%;
        background: #fff;
        color: #2a73ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        line-height: 1;
        box-shadow:
          0 6px 16px rgba(15, 27, 45, 0.35),
          0 0 0 3px rgba(42, 115, 255, 0.35);
        transition:
          transform 0.25s ease,
          background-color 0.25s ease,
          color 0.25s ease,
          box-shadow 0.25s ease;
      }
      .sxf .sxf-dot::after {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.9);
        animation: sxfPing 2.4s ease-out infinite;
        pointer-events: none;
      }
      .sxf .sxf-dot:hover {
        transform: scale(1.12);
        background: #fff;
        color: #2a73ff;
      }
      .sxf .sxf-dot.is-on {
        background: #2a73ff;
        color: #fff;
        transform: scale(1.15);
        box-shadow:
          0 8px 20px rgba(42, 115, 255, 0.55),
          0 0 0 4px #fff;
      }
      .sxf .sxf-dot.is-on::after {
        animation: none;
        opacity: 0;
      }
      @keyframes sxfPing {
        0% {
          transform: scale(1);
          opacity: 0.9;
        }
        80%,
        100% {
          transform: scale(1.9);
          opacity: 0;
        }
      }
      .sxf-rcv .sxf-chat {
        position: absolute;
        z-index: 2;
        right: -44px;
        bottom: 12%;
        width: 236px;
        padding: 12px 14px 14px;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 22px 44px -10px rgba(15, 27, 45, 0.35);
        transform: rotate(2deg);
        animation: sxfBob 6.6s ease-in-out infinite alternate;
      }
      .sxf-rcv .sxf-chat .ch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 0 10px;
        font-size: 13px;
        font-weight: 600;
        color: #0f1b2d;
      }
      .sxf-rcv .sxf-chat .ch span {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .sxf-rcv .sxf-chat .ch svg {
        width: 15px;
        height: 15px;
      }
      .sxf-rcv .sxf-chat .ch em {
        font-style: normal;
        font-weight: 500;
        color: #8a94a6;
      }
      .sxf-rcv .sxf-chat .bub {
        padding: 9px 11px;
        border-radius: 12px 12px 12px 4px;
        background: #0069ff;
        color: #fff;
        font-size: 12.5px;
        line-height: 1.45;
      }
      .sxf-rcv .sxf-chat .bub small {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3px;
        font-size: 11px;
        opacity: 0.8;
      }
      .sxf-rcv .p1 {
        left: 40%;
        top: -18px;
        --d: 5.8s;
        font-weight: 600;
        color: #0f1b2d;
      }
      .sxf-rcv .sxf-rhead .sxf-lead {
        margin-top: 20px;
      }
      .sxf-hl {
        list-style: none;
        margin: 30px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }
      .sxf-hl li {
        margin: 0;
        padding: 0;
      }
      .sxf .sxf-hli {
        display: grid;
        grid-template-columns: 26px minmax(0, 1fr);
        gap: 12px;
        width: 100%;
        height: 100%;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid transparent;
        background: transparent;
        transition:
          background-color 0.25s ease,
          border-color 0.25s ease;
      }
      .sxf .sxf-hli:hover {
        background: #f6f9ff;
      }
      .sxf .sxf-hli.is-on {
        background: #f1f6ff;
        border-color: #bcd3fb;
      }
      .sxf .sxf-hli .k {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #eaf1ff;
        color: #2a73ff;
        font-size: 12.5px;
        font-weight: 700;
        margin-top: 1px;
        transition: all 0.25s ease;
      }
      .sxf .sxf-hli.is-on .k {
        background: #2a73ff;
        color: #fff;
      }
      .sxf .sxf-hli strong {
        display: block;
        font-size: 15.5px;
        line-height: 1.35;
        font-weight: 700;
        color: #0f1b2d;
      }
      .sxf .sxf-hli span.d {
        display: block;
        margin-top: 3px;
        font-size: 14px;
        line-height: 1.5;
        color: #5b6475;
      }
      @media (max-width: 1340px) {
        .sxf-rcv .sxf-chat {
          right: -16px;
        }
      }
      @media (max-width: 1180px) {
        .sxf-rcv .sxf-wrap {
          column-gap: 48px;
        }
        .sxf-hl {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (max-width: 1024px) {
        .sxf-rcv {
          padding: 104px 24px;
        }
        .sxf-rcv .sxf-wrap {
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas: 'head' 'vis' 'list';
          row-gap: 48px;
        }
        .sxf-rcv .sxf-rhead {
          max-width: 680px;
          margin: 0 auto;
          text-align: center;
        }
        .sxf-hl {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          max-width: 720px;
          width: 100%;
          margin: 0 auto;
        }
        .sxf-rcv .sxf-chat {
          right: -10px;
        }
      }
      @media (max-width: 767px) {
        .sxf-rcv {
          padding: 84px 18px;
        }
        .sxf-hs-img {
          border-radius: 16px;
        }
        .sxf .sxf-dot {
          width: 24px;
          height: 24px;
          margin: -12px 0 0 -12px;
          font-size: 11.5px;
        }
        .sxf-rcv .sxf-chat,
        .sxf-rcv .p1 {
          display: none;
        }
        .sxf-hl {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      /* ---- phones: zoomed screenshot + one caption card that cycles through the numbers ---- */
      .sxf-hcap {
        display: none;
      }
      @media (max-width: 767px) {
        .sxf-rcv .sxf-wrap {
          row-gap: 36px;
        }
        .sxf-rcv .sxf-hl {
          display: none;
        }
        .sxf-hs-img img {
          transform-origin: 0 0;
          transform: translate(var(--tx, 0%), var(--ty, 0%)) scale(var(--zs, 1));
          transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .sxf .sxf-dot {
          transition:
            left 0.7s cubic-bezier(0.22, 1, 0.36, 1),
            top 0.7s cubic-bezier(0.22, 1, 0.36, 1),
            transform 0.25s ease,
            background-color 0.25s ease,
            color 0.25s ease,
            box-shadow 0.25s ease;
        }
        .sxf-rcv .sxf-hcap {
          grid-area: list;
          position: relative;
          display: block;
          margin-top: -12px;
          padding: 18px 18px 14px;
          border-radius: 18px;
          background: #fff;
          border: 1px solid #e3e8f1;
          box-shadow: 0 16px 34px -20px rgba(18, 37, 92, 0.3);
          overflow: hidden;
        }
        .sxf-hcap .top {
          display: flex;
          align-items: center;
          gap: 10px;
        }
        .sxf-hcap .k {
          flex: none;
          display: inline-grid;
          place-items: center;
          width: 26px;
          height: 26px;
          border-radius: 50%;
          background: #2a73ff;
          color: #fff;
          font-size: 12.5px;
          font-weight: 700;
        }
        .sxf-hcap strong {
          flex: 1;
          min-width: 0;
          font-size: 17px;
          line-height: 1.3;
          color: #0f1b2d;
        }
        .sxf-hcap .cnt {
          font-style: normal;
          font-size: 12.5px;
          font-weight: 600;
          color: #8a94a6;
        }
        .sxf-hcap .d {
          margin: 8px 0 0;
          font-size: 15px;
          line-height: 1.5;
          color: #5b6475;
        }
        .sxf-hcap .nav {
          display: flex;
          align-items: center;
          gap: 8px;
          margin-top: 12px;
        }
        .sxf-hcap .dots {
          display: flex;
          gap: 5px;
          margin-right: auto;
        }
        .sxf-hcap .dots i {
          width: 6px;
          height: 6px;
          border-radius: 3px;
          background: #2a73ff;
          opacity: 0.22;
          transition:
            width 0.2s ease,
            opacity 0.2s ease;
        }
        .sxf-hcap .dots i.on {
          width: 16px;
          opacity: 0.9;
        }
        .sxf-rcv .sxf-hcap button,
        .sxf-rcv .sxf-hcap button:hover,
        .sxf-rcv .sxf-hcap button:focus {
          display: grid;
          place-items: center;
          width: 36px;
          height: 36px;
          padding: 0;
          border: 1px solid #e3e8f1;
          border-radius: 50%;
          background: #fff;
          color: #0f1b2d;
          cursor: pointer;
        }
        .sxf-hcap button svg {
          width: 18px;
          height: 18px;
          fill: none;
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }
        .sxf-hcap .bar {
          position: absolute;
          left: 0;
          right: 0;
          bottom: 0;
          height: 3px;
          background: #eef1f6;
        }
        .sxf-hcap .bar i {
          display: block;
          height: 100%;
          background: #2a73ff;
          transform-origin: 0 50%;
          transform: scaleX(0);
        }
        .sxf-rcv.is-auto .sxf-hcap .bar i {
          animation: sxfFill 4s linear forwards;
          animation-play-state: paused;
        }
        .sxf-rcv.is-auto.is-run .sxf-hcap .bar i {
          animation-play-state: running;
        }
        @keyframes sxfFill {
          to {
            transform: scaleX(1);
          }
        }
      }
    </style>
    <section class="sxf sxf-rcv" id="empfaenger" aria-labelledby="sxf-h-rcv">
      <div class="sxf-glow" aria-hidden="true"></div>
      <div class="sxf-wrap">
        <div class="sxf-rhead" data-rv>
          <p class="sxf-eyebrow">{t.share_page_for_your_recipients}</p>
          <h2 class="sxf-h" id="sxf-h-rcv">
            {t.share_page_your_share_page}
            <span class="sxf-blue">{t.share_page_in_your_look}</span>
          </h2>
          <p class="sxf-lead">{t.share_page_recipients_open_a_page}</p>
        </div>
        <div class="sxf-hs" data-rv>
          <div class="sxf-hs-img">
            <img
              loading="lazy"
              decoding="async"
              src="/media/sxf-share-page-detail.webp"
              alt={t.share_page_alt_share_page_as}
              width="640"
              height="512"
            />
          </div>
          <button
            class="sxf-b sxf-dot"
            style="left:3.4%;top:42.6%"
            aria-label={t.share_page_aria_label_1_subject_message}
            aria-pressed="false">1</button
          ><button
            class="sxf-b sxf-dot"
            style="left:36.9%;top:41.0%"
            aria-label={t.share_page_aria_label_2_qr_code}
            aria-pressed="false">2</button
          ><button
            class="sxf-b sxf-dot"
            style="left:36.9%;top:71.1%"
            aria-label={t.share_page_aria_label_3_download_all}
            aria-pressed="false">3</button
          ><button
            class="sxf-b sxf-dot"
            style="left:36.9%;top:78.1%"
            aria-label={t.share_page_aria_label_4_upload}
            aria-pressed="false">4</button
          ><button
            class="sxf-b sxf-dot"
            style="left:36.9%;top:84.8%"
            aria-label={t.share_page_aria_label_5_view_files}
            aria-pressed="false">5</button
          ><button
            class="sxf-b sxf-dot"
            style="left:3.4%;top:90.0%"
            aria-label={t.share_page_aria_label_6_expiry_date}
            aria-pressed="false">6</button
          ><button class="sxf-b sxf-dot" style="left:36.9%;top:96.0%" aria-label="7: Chat" aria-pressed="false"
            >7</button
          ><button
            class="sxf-b sxf-dot"
            style="left:73.4%;top:34.8%"
            aria-label={t.share_page_aria_label_8_your_background}
            aria-pressed="false">8</button
          >
          <span class="sxf-pill p1" aria-hidden="true"
            ><b style="background:#FFA600"
              ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                ><path d="M12 16V4M7 9l5-5 5 5M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path></svg
              ></b
            >{t.share_page_contract_signed_pdf}</span
          >
          <div class="sxf-chat" aria-hidden="true">
            <p class="ch">
              <span
                ><svg class="i" viewbox="0 0 24 24" aria-hidden="true"
                  ><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg
                >Chat</span
              ><em>{t.share_page_anna_miller}</em>
            </p><div class="bub">
              <small><span>{t.share_page_anna_miller}</span><span>{t.share_page_6_16_pm}</span></small>{
                t.share_page_thanks_ill_upload_the
              }
            </div>
          </div>
        </div>
        <!-- Phones: one caption card for the active number instead of the list (filled by the script below) -->
        <div class="sxf-hcap" aria-live="polite">
          <div class="top">
            <span class="k">1</span><strong></strong><em class="cnt">1 / 8</em>
          </div>
          <p class="d"></p>
          <div class="nav">
            <span class="dots" aria-hidden="true"></span>
            <button type="button" class="sxf-b prev" aria-label={t.share_page_prev}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
            </button>
            <button type="button" class="sxf-b next" aria-label={t.share_page_next}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
          </div>
          <span class="bar" aria-hidden="true"><i></i></span>
        </div>
        <ol class="sxf-hl" data-rv style="--dl:.12s">
          <li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">1</span><span
                ><strong>{t.share_page_subject_message}</strong><span class="d">{t.share_page_your_subject_as_the}</span
                ></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">2</span><span
                ><strong>{t.share_page_qr_code}</strong><span class="d">{t.share_page_opens_the_share_directly}</span
                ></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">3</span><span
                ><strong>{t.share_page_download_all}</strong><span class="d">{t.share_page_all_files_in_one}</span
                ></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">4</span><span
                ><strong>{t.share_page_upload}</strong><span class="d"
                  >{t.share_page_recipients_drop_files_straight}</span
                ></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">5</span><span
                ><strong>{t.share_page_view_files}</strong><span class="d">{t.share_page_preview_in_the_browser}</span
                ></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">6</span><span
                ><strong>{t.share_page_expiry_date}</strong><span class="d">{t.share_page_your_recipients_see_how}</span
                ></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">7</span><span
                ><strong>Chat</strong><span class="d">{t.share_page_questions_answered_right_at}</span></span
              ></button
            >
          </li><li>
            <button class="sxf-b sxf-hli" aria-pressed="false"
              ><span class="k">8</span><span
                ><strong>{t.share_page_your_background}</strong><span class="d"
                  >{t.share_page_your_image_per_share}</span
                ></span
              ></button
            >
          </li>
        </ol>
      </div>
    </section>
    <script is:inline>
      (function () {
        function init(s) {
          if (s.__sxf) return;
          s.__sxf = 1;
          var d = [].slice.call(s.querySelectorAll('.sxf-dot')),
            l = [].slice.call(s.querySelectorAll('.sxf-hli')),
            cur = 0;
          var phone = window.matchMedia('(max-width: 767px)');
          var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          // phones: where to zoom for each number (point to centre, scale). 1-7 sit on the share card,
          // 8 is the background, so it shows the whole picture.
          var CARD = { x: 0.333, y: 0.66, s: 1.5 },
            FULL = { x: 0.5, y: 0.5, s: 1 },
            ZOOM = [CARD, CARD, CARD, CARD, CARD, CARD, CARD, FULL];
          var img = s.querySelector('.sxf-hs-img img'),
            cap = s.querySelector('.sxf-hcap'),
            pos = d.map(function (e) {
              return [parseFloat(e.style.left), parseFloat(e.style.top)];
            });
          var texts = l.map(function (e) {
            return [e.querySelector('strong').textContent, e.querySelector('.d').textContent];
          });
          function zoom(i) {
            var z = phone.matches ? ZOOM[i] || FULL : FULL;
            img.style.setProperty('--zs', z.s);
            img.style.setProperty('--tx', 50 - z.x * z.s * 100 + '%'); // translate after scale: centre the point
            img.style.setProperty('--ty', 50 - z.y * z.s * 100 + '%');
            d.forEach(function (e, k) {
              e.style.left = 50 + (pos[k][0] - z.x * 100) * z.s + '%';
              e.style.top = 50 + (pos[k][1] - z.y * 100) * z.s + '%';
            });
          }
          function caption(i) {
            if (!cap) return;
            cap.querySelector('.k').textContent = i + 1;
            cap.querySelector('strong').textContent = texts[i][0];
            cap.querySelector('.d').textContent = texts[i][1];
            cap.querySelector('.cnt').textContent = i + 1 + ' / ' + l.length;
            [].forEach.call(cap.querySelectorAll('.dots i'), function (e, k) {
              e.classList.toggle('on', k === i);
            });
            var bar = cap.querySelector('.bar i');
            bar.style.animation = 'none';
            bar.offsetWidth;
            bar.style.animation = '';
          }
          // the caption keeps the height of its longest text so the page does not jump
          function fixHeight() {
            if (!cap) return;
            cap.style.minHeight = '';
            var mx = 0;
            texts.forEach(function (x, k) {
              cap.querySelector('strong').textContent = x[0];
              cap.querySelector('.d').textContent = x[1];
              mx = Math.max(mx, cap.offsetHeight);
            });
            cap.style.minHeight = mx + 'px';
            caption(cur);
          }
          function on(i) {
            cur = i;
            zoom(i);
            caption(i);
            d.forEach(function (e, k) {
              e.classList.toggle('is-on', k === i);
              e.setAttribute('aria-pressed', k === i ? 'true' : 'false');
            });
            l.forEach(function (e, k) {
              e.classList.toggle('is-on', k === i);
              e.setAttribute('aria-pressed', k === i ? 'true' : 'false');
            });
          }
          [d, l].forEach(function (g) {
            g.forEach(function (e, k) {
              ['mouseenter', 'focus', 'click'].forEach(function (t) {
                e.addEventListener(t, function () {
                  on(k);
                });
              });
            });
          });
          if (cap) {
            var dots = cap.querySelector('.dots');
            l.forEach(function (e, k) {
              var x = document.createElement('i');
              x.addEventListener('click', function () {
                on(k);
              });
              dots.appendChild(x);
            });
            cap.querySelector('.prev').addEventListener('click', function () {
              on((cur + l.length - 1) % l.length);
            });
            cap.querySelector('.next').addEventListener('click', function () {
              on((cur + 1) % l.length);
            });
            // automatic cycle: the progress line's end moves on to the next number
            cap.querySelector('.bar i').addEventListener('animationend', function () {
              if (phone.matches) on((cur + 1) % l.length);
            });
            // swipe on the caption or the picture
            var x0 = null;
            [cap, s.querySelector('.sxf-hs')].forEach(function (el) {
              el.addEventListener(
                'touchstart',
                function (e) {
                  x0 = e.touches[0].clientX;
                },
                { passive: true },
              );
              el.addEventListener('touchend', function (e) {
                if (x0 === null) return;
                var dx = e.changedTouches[0].clientX - x0;
                x0 = null;
                if (Math.abs(dx) > 40) on((cur + (dx < 0 ? 1 : l.length - 1)) % l.length);
              });
            });
            if (!rm) {
              s.classList.add('is-auto');
              if ('IntersectionObserver' in window)
                new IntersectionObserver(
                  function (es) {
                    s.classList.toggle('is-run', es[0].isIntersecting);
                  },
                  { threshold: 0.5 },
                ).observe(s.querySelector('.sxf-hs'));
              else s.classList.add('is-run');
            }
            var w = window.innerWidth;
            window.addEventListener('resize', function () {
              if (window.innerWidth === w) return;
              w = window.innerWidth;
              fixHeight();
              zoom(cur);
            });
          }
          on(0);
          fixHeight();
        }
        function go() {
          document.querySelectorAll('.sxf-rcv').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
</div>
