<style is:global>
/* 12 custom layouts: live share page builder */
.sxf-lay{padding:128px 32px;background:linear-gradient(180deg,#F3F7FF 0%,#EEF4FF 100%);}
.sxf-lay .sxf-grid{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:56px;align-items:center;margin-top:64px;}
.sxf-lay .sxf-ctl{position:relative;z-index:2;padding:30px;border-radius:28px;background:#fff;box-shadow:0 30px 60px -28px rgba(18,37,92,.28),0 0 0 1px rgba(18,37,92,.05);}
.sxf-lay .grp + .grp{margin-top:24px;}
.sxf-lay .grp h3{margin:0 0 12px;font-family:Inter,sans-serif;font-size:12.5px;line-height:1.3;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B7487;}
.sxf-lay .row{display:flex;flex-wrap:wrap;gap:10px;}
.sxf .sxf-lay .pre,.sxf-lay .pre{display:inline-flex;align-items:center;gap:10px;padding:8px 18px 8px 8px;border-radius:16px;background:#fff;border:1px solid #D8E1EE;color:#0F1B2D;font-size:15px;font-weight:600;transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease,background-color .2s ease;}
.sxf-lay .pre b{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:10px;background:var(--c);color:#fff;}
.sxf-lay .pre b svg{width:17px;height:17px;}
.sxf-lay .pre:hover{border-color:#2A73FF;transform:translateY(-2px);box-shadow:0 10px 20px rgba(18,37,92,.10);}
.sxf-lay .pre[aria-pressed="true"]{border-color:#2A73FF;background:#EAF1FF;box-shadow:inset 0 0 0 1px #2A73FF;}
.sxf-lay .sw{width:40px;height:40px;border-radius:50%;background:var(--g);box-shadow:inset 0 0 0 3px #fff,0 0 0 2px #E3E8F0;transition:transform .2s ease,box-shadow .2s ease;}
.sxf-lay .sw:hover{transform:scale(1.08);}
.sxf-lay .sw[aria-pressed="true"]{box-shadow:inset 0 0 0 3px #fff,0 0 0 3px #2A73FF;transform:scale(1.1);}
.sxf-lay .chip{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:12px;background:#F1F4F9;color:#3D4555;font-size:14px;font-weight:600;transition:background-color .2s ease,color .2s ease,transform .15s ease;}
.sxf-lay .chip:hover{transform:translateY(-1px);}
.sxf-lay .chip[aria-pressed="true"]{background:#2A73FF;color:#fff;}
.sxf-lay .chip .ck{display:flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:6px;background:#fff;color:#2A73FF;}
.sxf-lay .chip .ck svg{width:12px;height:12px;stroke-width:3;opacity:0;transition:opacity .2s ease;}
.sxf-lay .chip[aria-pressed="true"] .ck svg{opacity:1;}
.sxf-lay .chip.fn{font-size:15px;}
.sxf-lay .dice{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;margin-top:28px;padding:13px 24px;border-radius:16px;background:#2A73FF;color:#fff;font-size:15px;font-weight:600;transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease;}
.sxf-lay .dice svg{width:18px;height:18px;transition:transform .5s cubic-bezier(.34,1.56,.64,1);}
.sxf-lay .dice:hover{background:#1F63EB;transform:translateY(-2px);box-shadow:0 12px 24px rgba(42,115,255,.32);}
.sxf-lay .dice:hover svg{transform:rotate(200deg);}
/* stage */
.sxf-lay .sxf-stage{position:relative;}
.sxf-lay .sxf-browser .sxf-pg{position:relative;min-height:470px;padding:34px;background:var(--bg,#2A73FF);transition:background .6s ease;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.sxf-lay .sxf-pg::before,.sxf-lay .sxf-pg::after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.16);transition:transform .8s cubic-bezier(.22,1,.36,1);}
.sxf-lay .sxf-pg::before{width:300px;height:300px;left:-90px;top:-110px;transform:scale(var(--blob,1));}
.sxf-lay .sxf-pg::after{width:220px;height:220px;right:-60px;bottom:-80px;transform:scale(calc(2 - var(--blob,1)));}
.sxf-lay .card{position:relative;z-index:1;width:100%;max-width:440px;padding:24px;border-radius:20px;background:#fff;box-shadow:0 24px 50px -18px rgba(0,0,0,.35);font-family:var(--ff,Inter),sans-serif;color:#0F1B2D;overflow:hidden;transition:height .5s cubic-bezier(.22,1,.36,1);}
.sxf-lay .card .top{display:flex;align-items:center;gap:12px;}
.sxf-lay .card .logo{display:flex;align-items:center;gap:8px;font-family:Inter,sans-serif;font-size:13px;font-weight:800;letter-spacing:.06em;color:#0F1B2D;max-width:0;overflow:hidden;opacity:0;white-space:nowrap;transition:max-width .5s ease,opacity .4s ease;}
.sxf-lay .card .logo i{display:flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;background:var(--acc,#2A73FF);color:#fff;font-style:normal;font-size:15px;flex:none;transition:background-color .6s ease;}
.sxf-lay .card.has-logo .logo{max-width:200px;opacity:1;}
.sxf-lay .card .qr{margin-left:auto;width:38px;height:38px;border-radius:9px;background:#F1F4F9;color:var(--acc,#2A73FF);display:flex;align-items:center;justify-content:center;flex:none;transition:color .6s ease;}
.sxf-lay .card .qr svg{width:24px;height:24px;}
.sxf-lay .card h4{margin:16px 0 6px;font-family:var(--ff,Inter),sans-serif;font-size:23px;line-height:1.2;font-weight:700;letter-spacing:-.01em;color:#0F1B2D;}
.sxf-lay .card .ds{margin:0;font-size:14px;line-height:1.5;color:#5B6475;}
.sxf-lay .files{margin-top:16px;border-radius:14px;border:1px solid #EDF1F7;}
.sxf-lay .files div{display:flex;align-items:center;gap:10px;padding:9px 12px;font-family:Inter,sans-serif;font-size:13px;font-weight:600;}
.sxf-lay .files div + div{border-top:1px solid #F0F3F8;}
.sxf-lay .files span{width:22px;height:22px;border-radius:6px;flex:none;}
.sxf-lay .files em{margin-left:auto;font-style:normal;font-size:11.5px;font-weight:500;color:#8A94A6;}
.sxf-lay .wd{display:grid;grid-template-rows:0fr;opacity:0;transform:scale(.92);transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1),opacity .3s ease,transform .45s cubic-bezier(.34,1.56,.64,1),margin .45s ease;margin-top:0;}
.sxf-lay .wd > div{overflow:hidden;min-height:0;}
.sxf-lay .wd.on{grid-template-rows:1fr;opacity:1;transform:none;margin-top:12px;}
.sxf-lay .calc{padding:14px;border-radius:14px;background:color-mix(in srgb,var(--acc,#2A73FF) 9%,#fff);font-family:Inter,sans-serif;}
.sxf-lay .calc .hd{display:flex;justify-content:space-between;align-items:baseline;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#5B6475;}
.sxf-lay .calc .hd b{font-size:20px;letter-spacing:-.01em;text-transform:none;color:#0F1B2D;}
.sxf-lay .calc input{width:100%;margin:10px 0 2px;accent-color:var(--acc,#2A73FF);}
.sxf-lay .calc small{font-size:12px;color:#5B6475;}
.sxf-lay .up{display:flex;align-items:center;justify-content:center;gap:8px;padding:14px;border-radius:14px;border:2px dashed color-mix(in srgb,var(--acc,#2A73FF) 45%,#fff);font-family:Inter,sans-serif;font-size:13px;font-weight:600;color:var(--acc,#2A73FF);}
.sxf-lay .up svg{width:18px;height:18px;}
.sxf-lay .chat{display:flex;gap:10px;align-items:flex-end;font-family:Inter,sans-serif;}
.sxf-lay .chat i{width:28px;height:28px;border-radius:50%;background:#FFBB00;color:#fff;display:flex;align-items:center;justify-content:center;font-style:normal;font-size:12px;font-weight:700;flex:none;}
.sxf-lay .chat p{margin:0;padding:10px 13px;border-radius:14px 14px 14px 4px;background:#F1F4F9;font-size:13px;line-height:1.45;color:#0F1B2D;}
.sxf-lay .cap{max-width:560px;margin:20px auto 0;text-align:center;font-size:16px;line-height:1.55;color:#4A5568;}
.sxf-lay .cap b{color:#0F1B2D;}
.sxf-lay .p1{left:-26px;top:22%;--d:5.6s;}
.sxf-lay .f1{right:-26px;top:-28px;--s:56px;--c:#FFBB00;--r:12deg;--d:6.4s;z-index:2;}
.sxf-lay .f2{left:-30px;bottom:-26px;--s:48px;--c:#C800FF;--r:-14deg;--d:5.8s;z-index:2;}
.sxf-lay .sxf-pg.pop .card{animation:sxfPop .5s cubic-bezier(.34,1.56,.64,1);}
@keyframes sxfPop{0%{transform:scale(.96) rotate(-1deg);}60%{transform:scale(1.02) rotate(.5deg);}100%{transform:none;}}
@media (prefers-reduced-motion:reduce){.sxf-lay .sxf-pg.pop .card{animation:none;} .sxf-lay .card{transition:none;}}
@media (max-width:1024px){.sxf-lay{padding:104px 24px;} .sxf-lay .sxf-grid{grid-template-columns:minmax(0,1fr);gap:40px;margin-top:48px;max-width:720px;margin-left:auto;margin-right:auto;} .sxf-lay .sxf-stage{order:-1;}}
@media (max-width:767px){.sxf-lay{padding:84px 18px;} .sxf-lay .sxf-ctl{padding:22px 18px;border-radius:22px;} .sxf-lay .sxf-browser .sxf-pg{min-height:0;padding:22px 14px;} .sxf-lay .card{padding:18px;} .sxf-lay .card h4{font-size:20px;} .sxf-lay .p1{left:8px;top:-16px;} .sxf-lay .f1{right:-8px;top:-22px;--s:42px;} .sxf-lay .f2{display:none;}}
</style>
