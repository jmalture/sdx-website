---
/**
 * Section "faq": Fragen zu External Share? Beantwortet.
 * Texts: src/i18n/share.json, keys starting with "faq_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/share.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-sxf10 e-con-full e-flex e-con e-parent" data-id="sxf10">
  <div class="elementor-element elementor-element-sxf10w elementor-widget elementor-widget-html" data-id="sxf10w">
    <style is:global>
      /* FAQ (same component as the homepage FAQ: category chips + load more) */
      .sdxq {
        padding: 120px 32px 128px;
        background: #fff;
      }
      .sdxq-head {
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
      }
      .sdxq-head .sxf-lead a {
        color: #2a73ff;
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1.5px solid rgba(42, 115, 255, 0.35);
      }
      .sdxq-head .sxf-lead a:hover {
        border-bottom-color: #2a73ff;
      }
      .sdxq-chips {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin: 32px auto 0;
        max-width: 760px;
      }
      .sdxq-chips button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #e3e8f0;
        font:
          600 14px/1.2 Inter,
          sans-serif;
        color: #0f1b2d;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(18, 37, 92, 0.06);
        transition:
          transform 0.2s ease,
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          background 0.2s ease,
          color 0.2s ease;
      }
      .sdxq-chips button i {
        width: 12px;
        height: 12px;
        border-radius: 4px;
        flex: none;
      }
      .sdxq-chips button:hover {
        transform: translateY(-2px);
        border-color: #2a73ff;
        box-shadow: 0 8px 18px rgba(42, 115, 255, 0.18);
      }
      .sdxq-chips button:focus-visible {
        outline: 2px solid #2a73ff;
        outline-offset: 2px;
      }
      .sdxq-chips button[aria-pressed='true'] {
        background: #2a73ff;
        border-color: #2a73ff;
        color: #fff;
        box-shadow: 0 8px 18px rgba(42, 115, 255, 0.28);
      }
      .sdxq-chips button[aria-pressed='true'] i {
        box-shadow: 0 0 0 2px #fff;
      }
      .sdxq-list {
        list-style: none;
        max-width: 820px;
        margin: 36px auto 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .sdxq-item {
        margin: 0;
        border-radius: 18px;
        background: #f3f7ff;
        border: 1px solid transparent;
        transition:
          background 0.25s ease,
          border-color 0.25s ease,
          box-shadow 0.25s ease;
      }
      .sdxq-item[hidden] {
        display: none;
      }
      .sdxq-item:hover {
        background: #e6efff;
      }
      .sdxq-item.is-open {
        background: #fff;
        border-color: #e3e8f0;
        box-shadow: 0 14px 34px rgba(18, 37, 92, 0.1);
      }
      .sdxq-item h3 {
        margin: 0;
        font-size: inherit;
        line-height: inherit;
      }
      .sdxq-q {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        margin: 0;
        padding: 20px 20px 20px 26px;
        border: 0;
        background: none;
        border-radius: 18px;
        text-align: left;
        cursor: pointer;
        font:
          600 18px/1.35 Inter,
          sans-serif;
        letter-spacing: -0.01em;
        color: #0f1b2d;
      }
      .sdxq-q:focus-visible {
        outline: 2px solid #2a73ff;
        outline-offset: 2px;
      }
      .sdxq-q span {
        flex: 1;
        min-width: 0;
        white-space: normal;
      }
      .sdxq-ic {
        position: relative;
        flex: none;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 4px 12px rgba(18, 37, 92, 0.08);
        transition:
          background 0.25s ease,
          transform 0.3s ease;
      }
      .sdxq-ic::before,
      .sdxq-ic::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        width: 12px;
        height: 2px;
        margin: -1px 0 0 -6px;
        border-radius: 2px;
        background: #2a73ff;
        transition: background 0.25s ease;
      }
      .sdxq-ic::after {
        transform: rotate(90deg);
      }
      .sdxq-item.is-open .sdxq-ic {
        background: #2a73ff;
        transform: rotate(45deg);
      }
      .sdxq-item.is-open .sdxq-ic::before,
      .sdxq-item.is-open .sdxq-ic::after {
        background: #fff;
      }
      .sdxq-a {
        display: grid;
        grid-template-rows: 0fr;
        visibility: hidden;
        transition:
          grid-template-rows 0.35s ease,
          visibility 0s linear 0.35s;
      }
      .sdxq-item.is-open .sdxq-a {
        grid-template-rows: 1fr;
        visibility: visible;
        transition:
          grid-template-rows 0.35s ease,
          visibility 0s;
      }
      .sdxq-a > div {
        overflow: hidden;
      }
      .sdxq-a p {
        margin: 0;
        padding: 0 76px 24px 26px;
        font-size: 16px;
        line-height: 1.6;
        color: #4a5568;
      }
      /* question-mark folders */
      .sdxq .sxf-fold::after {
        inset: 21%;
      }
      .sdxq .sxf-fold::before {
        content: '?';
        position: absolute;
        z-index: 1;
        left: 0;
        right: 0;
        top: 40%;
        text-align: center;
        font:
          800 calc(var(--s) * 0.3)/1 Inter,
          sans-serif;
        color: var(--c);
      }
      .sdxq .q4 {
        opacity: 0.55;
        filter: blur(1px);
      }
      @media (max-width: 1340px) {
        .sdxq .q1 {
          left: 3% !important;
          --s: 52px !important;
        }
        .sdxq .q2 {
          right: 3% !important;
          --s: 44px !important;
        }
        .sdxq .q3 {
          right: 4% !important;
          --s: 46px !important;
        }
        .sdxq .q4 {
          display: none;
        }
      }
      @media (max-width: 1180px) {
        .sdxq .q3 {
          display: none;
        }
      }
      @media (max-width: 1024px) {
        .sdxq {
          padding: 104px 24px;
        }
        .sdxq .q1 {
          left: 4% !important;
          top: 24px !important;
          --s: 40px !important;
        }
        .sdxq .q2 {
          right: 4% !important;
          top: 30px !important;
          --s: 34px !important;
        }
      }
      @media (max-width: 767px) {
        .sdxq {
          padding: 84px 18px;
        }
        .sdxq-chips {
          gap: 8px;
          margin-top: 26px;
        }
        .sdxq-chips button {
          padding: 8px 13px;
          font-size: 13px;
        }
        .sdxq-list {
          margin-top: 28px;
          gap: 10px;
        }
        .sdxq-q {
          padding: 16px 14px 16px 18px;
          font-size: 16px;
          gap: 12px;
        }
        .sdxq-ic {
          width: 30px;
          height: 30px;
        }
        .sdxq-a p {
          padding: 0 18px 18px;
          font-size: 15px;
        }
        .sdxq .q1 {
          top: 18px !important;
          --s: 36px !important;
        }
        .sdxq .q2 {
          top: 24px !important;
          --s: 30px !important;
        }
      }
      /* neutralise theme button hover/focus (pink) */
      .sdxq-q:hover,
      .sdxq-q:focus,
      .sdxq-q:active {
        background: transparent !important;
        color: #0f1b2d !important;
      }
      .sdxq-chips button:hover,
      .sdxq-chips button:focus,
      .sdxq-chips button:active {
        background: #fff !important;
        color: #0f1b2d !important;
      }
      .sdxq-chips button[aria-pressed='true'],
      .sdxq-chips button[aria-pressed='true']:hover,
      .sdxq-chips button[aria-pressed='true']:focus {
        background: #2a73ff !important;
        color: #fff !important;
      }
      /* load more */
      .sdxq-more-wrap {
        text-align: center;
        margin-top: 24px;
        padding-bottom: 6px;
      }
      .sdxq-more-wrap[hidden] {
        display: none;
      }
      .sdxq-more {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 24px;
        border-radius: 16px;
        background: #fff !important;
        border: 1px solid #d8e1ee !important;
        color: #0f1b2d !important;
        font:
          600 15px/1.3 Inter,
          sans-serif;
        cursor: pointer;
        box-shadow: none;
        transition:
          transform 0.2s ease,
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }
      .sdxq-more:hover,
      .sdxq-more:focus {
        background: #fff !important;
        color: #0f1b2d !important;
        border-color: #2a73ff !important;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(18, 37, 92, 0.1);
      }
      .sdxq-more em {
        color: #2a73ff;
      }
      .sdxq-more em[hidden] {
        display: none;
      }
      .sdxq-more::after {
        border-color: #2a73ff !important;
        transition: transform 0.3s ease;
      }
      .sdxq-more.is-less::after {
        transform: rotate(-135deg);
        margin-top: 4px;
      }
      .sdxq-more:focus-visible {
        outline: 2px solid #2a73ff;
        outline-offset: 2px;
      }
      .sdxq-more em {
        font-style: normal;
        min-width: 24px;
        padding: 3px 8px;
        border-radius: 999px;
        background: #eef4ff;
        font-size: 13px;
      }
      .sdxq-more::after {
        content: '';
        width: 7px;
        height: 7px;
        margin: -3px 2px 0 2px;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg);
      }
      .sdxq-item.sdxq-new {
        animation: sdxqIn 0.45s ease both;
      }
      @keyframes sdxqIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @media (max-width: 767px) {
        .sdxq-more-wrap {
          margin-top: 20px;
        }
        .sdxq-more {
          font-size: 14px;
          padding: 12px 18px;
        }
      }
    </style>
    <section class="sxf sdxq" id="faq" aria-labelledby="sdxq-h">
      <span class="sxf-fold q1" aria-hidden="true" style="--c:#2A73FF;--s:64px;--r:-10deg;left:9%;top:150px;--d:6.4s"
      ></span>
      <span class="sxf-fold q2" aria-hidden="true" style="--c:#FFA600;--s:52px;--r:12deg;right:10%;top:230px;--d:7.2s"
      ></span>
      <span class="sxf-fold q3" aria-hidden="true" style="--c:#22C55E;--s:58px;--r:-8deg;right:8%;top:60%;--d:7.6s"
      ></span>
      <span class="sxf-fold q4" aria-hidden="true" style="--c:#00BFFF;--s:36px;--r:-14deg;left:6%;bottom:12%;--d:6.2s"
      ></span>
      <div class="sxf-wrap">
        <div class="sdxq-head" data-rv>
          <p class="sxf-eyebrow">{t.faq_frequently_asked_questions}</p>
          <h2 class="sxf-h" id="sdxq-h">
            {t.faq_questions_about_external_share}
            <span class="sxf-blue">{t.faq_answered}</span>
          </h2>
          <p class="sxf-lead">{t.faq_the_essentials_of_sharing} <a href={t.faq_link_kontakt}>{t.faq_write_to_us}</a></p>
        </div>
        <div class="sdxq-chips" role="group" aria-label={t.faq_aria_label_filter_questions_by}>
          <button type="button" data-cat="all" aria-pressed="true">{t.faq_all}</button>
          <button type="button" data-cat="start" aria-pressed="false"
            ><i style="background:#2A73FF"></i>{t.faq_getting_started}</button
          >
          <button type="button" data-cat="sec" aria-pressed="false"
            ><i style="background:#0062FF"></i>{t.faq_security}</button
          >
          <button type="button" data-cat="ctrl" aria-pressed="false"
            ><i style="background:#FFBB00"></i>{t.faq_control}</button
          >
          <button type="button" data-cat="custom" aria-pressed="false"
            ><i style="background:#C800FF"></i>{t.faq_customisation}</button
          >
        </div>
        <ul class="sdxq-list">
          <li class="sdxq-item" data-cat="start">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a1" id="sdxq-q1"
                ><span>{t.faq_do_my_recipients_need}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a1" role="region" aria-labelledby="sdxq-q1">
              <div><p>{t.faq_no_recipients_open_the}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="start">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a2" id="sdxq-q2"
                ><span>{t.faq_which_files_can_i}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a2" role="region" aria-labelledby="sdxq-q2">
              <div><p>{t.faq_all_files_you_store}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="start">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a3" id="sdxq-q3"
                ><span>{t.faq_does_it_work_on}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a3" role="region" aria-labelledby="sdxq-q3">
              <div><p>{t.faq_yes_the_share_page}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="sec">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a4" id="sdxq-q4"
                ><span>{t.faq_can_someone_guess_the}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a4" role="region" aria-labelledby="sdxq-q4">
              <div><p>{t.faq_no_every_share_gets}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="sec">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a5" id="sdxq-q5"
                ><span>{t.faq_how_long_is_a}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a5" role="region" aria-labelledby="sdxq-q5">
              <div><p>{t.faq_14_days_by_default}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="sec">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a6" id="sdxq-q6"
                ><span>{t.faq_where_is_the_shared}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a6" role="region" aria-labelledby="sdxq-q6">
              <div><p>{t.faq_in_your_sdx_hosted}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="ctrl">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a7" id="sdxq-q7"
                ><span>{t.faq_can_i_change_or}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a7" role="region" aria-labelledby="sdxq-q7">
              <div><p>{t.faq_yes_under_my_shares}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="ctrl">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a8" id="sdxq-q8"
                ><span>{t.faq_can_i_change_content}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a8" role="region" aria-labelledby="sdxq-q8">
              <div><p>{t.faq_yes_you_can_adjust}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="ctrl">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a9" id="sdxq-q9"
                ><span>{t.faq_will_i_be_notified}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a9" role="region" aria-labelledby="sdxq-q9">
              <div><p>{t.faq_yes_sdx_notifies_you}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="ctrl">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a10" id="sdxq-q10"
                ><span>{t.faq_what_can_recipients_do}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a10" role="region" aria-labelledby="sdxq-q10">
              <div><p>{t.faq_exactly_what_you_allow}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="ctrl">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a11" id="sdxq-q11"
                ><span>{t.faq_do_shared_folders_stay}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a11" role="region" aria-labelledby="sdxq-q11">
              <div><p>{t.faq_yes_when_you_share}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="custom">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a12" id="sdxq-q12"
                ><span>{t.faq_can_i_design_the}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a12" role="region" aria-labelledby="sdxq-q12">
              <div><p>{t.faq_yes_you_set_the}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="custom">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a13" id="sdxq-q13"
                ><span>{t.faq_can_i_embed_a}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a13" role="region" aria-labelledby="sdxq-q13">
              <div><p>{t.faq_yes_you_can_embed}</p></div>
            </div>
          </li>
          <li class="sdxq-item" data-cat="custom">
            <h3>
              <button type="button" class="sdxq-q" aria-expanded="false" aria-controls="sdxq-a14" id="sdxq-q14"
                ><span>{t.faq_can_i_create_a}</span><b class="sdxq-ic" aria-hidden="true"></b></button
              >
            </h3><div class="sdxq-a" id="sdxq-a14" role="region" aria-labelledby="sdxq-q14">
              <div><p>{t.faq_yes_you_create_shares}</p></div>
            </div>
          </li>
        </ul>
        <div class="sdxq-more-wrap" hidden>
          <button
            type="button"
            class="sdxq-more"
            aria-controls="faq"
            aria-expanded="false"
            data-more={t.faq_more_show_more_questions}
            data-less={t.faq_less_show_fewer_questions}><span>{t.faq_show_more_questions}</span> <em>9</em></button
          >
        </div>
      </div>
    </section>
    <script is:inline type="application/ld+json" set:html={t.faq_jsonld} />
    <script is:inline>
      (function () {
        var root = document.getElementById('faq');
        if (!root || root.__sdxq) return;
        root.__sdxq = 1;
        var LIMIT = 5,
          expanded = false,
          cat = 'all';
        var items = [].slice.call(root.querySelectorAll('.sdxq-item'));
        var more = root.querySelector('.sdxq-more');
        function apply() {
          var n = 0,
            rest = 0,
            tot = 0;
          items.forEach(function (it) {
            var match = cat === 'all' || it.getAttribute('data-cat') === cat;
            var show = match && (expanded || cat !== 'all' || n < LIMIT);
            if (match) {
              n++;
              tot++;
            }
            if (match && !show) rest++;
            it.hidden = !show;
          });
          if (more) {
            var less = expanded && cat === 'all' && tot > LIMIT;
            more.parentNode.hidden = !rest && !less;
            more.classList.toggle('is-less', less);
            more.setAttribute('aria-expanded', less ? 'true' : 'false');
            var l = more.querySelector('span');
            if (l) l.textContent = more.getAttribute(less ? 'data-less' : 'data-more');
            var c = more.querySelector('em');
            if (c) {
              c.textContent = rest;
              c.hidden = less;
            }
          }
        }
        items.forEach(function (it) {
          var b = it.querySelector('.sdxq-q');
          b.addEventListener('click', function () {
            var o = !it.classList.contains('is-open');
            it.classList.toggle('is-open', o);
            b.setAttribute('aria-expanded', o ? 'true' : 'false');
          });
        });
        var chips = [].slice.call(root.querySelectorAll('.sdxq-chips button'));
        chips.forEach(function (ch) {
          ch.addEventListener('click', function () {
            cat = ch.getAttribute('data-cat');
            chips.forEach(function (x) {
              x.setAttribute('aria-pressed', x === ch ? 'true' : 'false');
            });
            apply();
          });
        });
        if (more) {
          more.addEventListener('click', function () {
            if (expanded) {
              var y = more.getBoundingClientRect().top;
              expanded = false;
              apply();
              var dy = more.getBoundingClientRect().top - y;
              if (dy) window.scrollBy({ top: dy, behavior: 'instant' });
              return;
            }
            var before = items.filter(function (it) {
              return it.hidden;
            });
            expanded = true;
            apply();
            var d = 0;
            before.forEach(function (it) {
              if (!it.hidden) {
                it.classList.add('sdxq-new');
                it.style.animationDelay = d++ * 60 + 'ms';
              }
            });
            var first = before.filter(function (it) {
              return !it.hidden;
            })[0];
            if (first) {
              first.querySelector('.sdxq-q').focus({ preventScroll: true });
            }
          });
        }
        apply();
      })();
    </script>
  </div>
</div>
