---
/**
 * Section "benefits": Warum Unternehmen mit SDX teilen.
 * Texts: src/i18n/share.json, keys starting with "benefits_" (one entry per language).
 * Layout and styles of this section are in this file; legacy Elementor classes come from
 * src/styles/legacy*.css and should be left as they are.
 */
import { dict, type Lang } from '../../i18n';
import data from '../../i18n/share.json';
const { lang } = Astro.props as { lang: Lang };
const t = dict(data, lang);
---

<div class="elementor-element elementor-element-sxf05 e-con-full e-flex e-con e-parent" data-id="sxf05">
  <div class="elementor-element elementor-element-sxf05w elementor-widget elementor-widget-html" data-id="sxf05w">
    <style is:global>
      /* 5 business value hover cards */
      .sxf-val {
        padding: 128px 32px;
        background: #fff;
      }
      .sxf-vgrid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
        margin-top: 60px;
      }
      .sxf-vc {
        position: relative;
        min-height: 270px;
        padding: 32px 30px 30px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid #e3e8f0;
        box-shadow: 0 2px 6px rgba(18, 37, 92, 0.04);
        overflow: hidden;
        outline: none;
        transition:
          box-shadow 0.3s ease,
          transform 0.3s ease,
          border-color 0.3s ease;
      }
      .sxf-vc .ic {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        border-radius: 15px;
        background: var(--c);
        color: #fff;
        box-shadow: 0 12px 24px -10px var(--c);
      }
      .sxf-vc .ic svg {
        width: 26px;
        height: 26px;
      }
      .sxf-vc h3 {
        margin: 24px 0 10px;
        font-family: Inter, sans-serif;
        font-size: 22px;
        line-height: 1.3;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: #0f1b2d;
      }
      .sxf-vc p {
        margin: 0;
        font-size: 16px;
        line-height: 1.55;
        color: #4a5568;
      }
      .sxf-vc .more {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 20px;
        font-size: 14px;
        font-weight: 600;
        color: var(--c);
      }
      .sxf-vc .more svg {
        width: 16px;
        height: 16px;
      }
      .sxf-vc .pf {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 28px 30px;
        background: var(--k);
        color: #fff;
        clip-path: circle(0 at 57px 59px);
        transition: clip-path 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .sxf-vc .pf .ic2 {
        position: absolute;
        left: 30px;
        top: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.16);
      }
      .sxf-vc .pf .ic2 svg {
        width: 26px;
        height: 26px;
      }
      .sxf-vc .pf b {
        display: block;
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.8;
      }
      .sxf-vc .pf ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 9px;
      }
      .sxf-vc .pf li {
        display: flex;
        gap: 10px;
        margin: 0;
        font-size: 15px;
        line-height: 1.45;
        font-weight: 500;
      }
      .sxf-vc .pf li svg {
        width: 18px;
        height: 18px;
        margin-top: 1px;
        stroke-width: 2.6;
      }
      @media (hover: hover) and (pointer: fine) {
        .sxf-vc:hover,
        .sxf-vc:focus-visible,
        .sxf-vc:focus-within {
          transform: translateY(-4px);
          box-shadow: 0 26px 50px -18px rgba(18, 37, 92, 0.28);
          border-color: transparent;
        }
        .sxf-vc:hover .pf,
        .sxf-vc:focus-visible .pf,
        .sxf-vc:focus-within .pf {
          clip-path: circle(150% at 57px 59px);
        }
      }
      .sxf-vc:focus-visible {
        outline: 2px solid #2a73ff;
        outline-offset: 3px;
      }
      @media (hover: none), (pointer: coarse) {
        .sxf-vc {
          min-height: 0;
        }
        .sxf-vc .more,
        .sxf-vc .pf .ic2,
        .sxf-vc .pf b {
          display: none;
        }
        .sxf-vc .pf {
          position: static;
          clip-path: none;
          background: transparent;
          color: #0f1b2d;
          padding: 16px 0 0;
          margin-top: 18px;
          border-top: 1px solid #eef1f6;
        }
        .sxf-vc .pf li {
          font-size: 14.5px;
          color: #3d4555;
        }
        .sxf-vc .pf li svg {
          color: var(--c);
        }
      }
      @media (max-width: 1024px) {
        .sxf-val {
          padding: 104px 24px;
        }
        .sxf-vgrid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          margin-top: 48px;
        }
      }
      @media (max-width: 767px) {
        .sxf-val {
          padding: 84px 18px;
        }
        .sxf-vgrid {
          grid-template-columns: minmax(0, 1fr);
          gap: 16px;
          margin-top: 40px;
        }
        .sxf-vc {
          padding: 26px 22px;
        }
        .sxf-vc h3 {
          font-size: 20px;
          margin-top: 20px;
        }
      }
    </style>
    <section class="sxf sxf-val" id="nutzen" aria-labelledby="sxf-h-val">
