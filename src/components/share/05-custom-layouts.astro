    <script is:inline set:html={t.custom_layouts_script} />
    <script is:inline>
      /*
       * Phones: guided version of the configurator. Template tabs above the window (cycling on
       * their own), colours + "surprise me" below it; the full control card is hidden. The tabs and
       * swatches are copies of the real controls, so the main script keeps them in sync (aria-pressed).
       */
      (function () {
        function init(s) {
          if (s.__sxfm) return;
          s.__sxfm = 1;
          var stage = s.querySelector('.sxf-stage'),
            win = s.querySelector('.sxf-browser'),
            pres = [].slice.call(s.querySelectorAll('.sxf-ctl .pre')),
            sws = [].slice.call(s.querySelectorAll('.sxf-ctl .sw')),
            dice = s.querySelector('.sxf-ctl .dice');
          if (!stage || !win || !pres.length) return;
          var phone = window.matchMedia('(max-width: 767px)');
          var tabs = document.createElement('div');
          tabs.className = 'sxf-mtabs';
          tabs.setAttribute('role', 'group');
          var row = document.createElement('div');
          row.className = 'sxf-mrow';
          function cur() {
            for (var i = 0; i < pres.length; i++) if (pres[i].getAttribute('aria-pressed') === 'true') return i;
            return -1;
          }
          function restart() {
            var b = tabs.querySelector('[aria-pressed="true"] .bar i');
            [].forEach.call(tabs.querySelectorAll('.bar i'), function (i) {
              i.style.animation = 'none';
              i.offsetWidth;
              i.style.animation = '';
            });
            return b;
          }
          function pick(i) {
            pres[i].click();
            restart();
          }
          pres.forEach(function (p, i) {
            var c = p.cloneNode(true);
            c.insertAdjacentHTML('beforeend', '<span class="bar" aria-hidden="true"><i></i></span>');
            c.addEventListener('click', function () {
              pick(i);
            });
            c.querySelector('.bar i').addEventListener('animationend', function () {
              if (phone.matches && cur() === i) pick((i + 1) % pres.length);
            });
            tabs.appendChild(c);
          });
          sws.forEach(function (w, i) {
            var c = w.cloneNode(true);
            c.addEventListener('click', function () {
              w.click();
            });
            row.appendChild(c);
          });
          if (dice) {
            var dc = dice.cloneNode(true);
            dc.addEventListener('click', function () {
              // phones: a random template in a random colour (stays within the measured window height)
              var t = Math.floor(Math.random() * pres.length),
                c;
              do {
                c = Math.floor(Math.random() * sws.length);
              } while (sws[c].getAttribute('aria-pressed') === 'true');
              pres[t].click();
              sws[c].click();
              restart();
            });
            row.appendChild(dc);
          }
          stage.insertBefore(tabs, win);
          win.insertAdjacentElement('afterend', row);
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            s.classList.add('is-mauto');
            if ('IntersectionObserver' in window)
              new IntersectionObserver(
                function (es) {
                  s.classList.toggle('is-mrun', es[0].isIntersecting);
                },
                { threshold: 0.5 },
              ).observe(win);
            else s.classList.add('is-mrun');
          }
          if (s.__sxfLock) s.__sxfLock();
        }
        function go() {
          document.querySelectorAll('.sxf-lay').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', go);
        else go();
      })();
    </script>
  </div>
