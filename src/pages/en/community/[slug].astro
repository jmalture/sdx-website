---
/** /en/community/<slug>/ : one English article per file in src/content/community/en/. */
import CommunityArticle from '../../../templates/CommunityArticle.astro';
import { articles, slugOf } from '../../../lib/community';

export async function getStaticPaths() {
  return (await articles('en')).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
---

<CommunityArticle entry={Astro.props.entry} />
